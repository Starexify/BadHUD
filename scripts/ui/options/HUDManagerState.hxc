package ui.options;

import funkin.Preferences;
import funkin.audio.FunkinSound;
import funkin.data.notestyle.NoteStyleRegistry;
import funkin.graphics.FunkinSprite;
import funkin.input.Cursor;
import funkin.input.CursorMode;
import funkin.modding.base.ScriptedFlxSpriteGroup;
import funkin.play.notes.Strumline;
import funkin.play.notes.notestyle.NoteStyle;
import funkin.save.Save;
import funkin.ui.ScriptedMusicBeatSubState;
import funkin.ui.debug.charting.util.ChartEditorDropdowns;
import funkin.util.Constants;

import flixel.FlxG;
import flixel.FlxSprite;
import flixel.addons.display.FlxPieDialShape;
import flixel.addons.display.FlxRadialGauge;
import flixel.math.FlxAngle;
import flixel.text.FlxText;
import flixel.text.FlxTextBorderStyle;
import flixel.ui.FlxBar;
import flixel.ui.FlxBarFillDirection;
import flixel.util.FlxSpriteUtil;

import haxe.ui.RuntimeComponentBuilder;
import haxe.ui.components.Button;
import haxe.ui.components.CheckBox;
import haxe.ui.components.ColorPicker;
import haxe.ui.components.DropDown;
import haxe.ui.components.Label;
import haxe.ui.components.NumberStepper;
import haxe.ui.components.OptionStepper;
import haxe.ui.containers.Frame;
import haxe.ui.containers.HBox;
import haxe.ui.containers.TableView;
import haxe.ui.containers.TabView;
import haxe.ui.containers.Box;
import haxe.ui.containers.VBox;
import haxe.ui.containers.dialogs.Dialog;
import haxe.ui.containers.dialogs.MessageBox;
import haxe.ui.containers.menus.Menu;
import haxe.ui.containers.windows.Window;
import haxe.ui.containers.windows.WindowManager;
import haxe.ui.core.Screen;
import haxe.ui.data.ArrayDataSource;
import haxe.ui.events.MouseEvent;
import haxe.ui.events.UIEvent;
import haxe.ui.layouts.VerticalGridLayout;

class HUDManagerState extends ScriptedMusicBeatSubState {
    var badOptions:Null<BadSaveData> = Save.instance.modOptions.get("badOptions");
    var badHUDOptions = new BadHUDOptions();

    var welcomeMusic:FunkinSound = new FunkinSound();
    var spriteSettingsText:FlxText;
    var highlightOutline:FunkinSprite;
    var highlightInitialized:Bool = false;
    var noteStyle:NoteStyle;

    var playerStrumline:Strumline;
    var opponentStrumline:Strumline;
    var playerStrum:Bool = true;
    var oppStrum:Bool = true;

    var draggableSprites:Array<DraggableSprite> = [];
    var checkboxPool:Array<CheckBox> = [];

    var windowManager = new WindowManager();
    var toolboxWindow:Window;
    var isOverToolbox:Bool = false;

    var contextMenu:Menu;
    var isSearching:Bool = false;
    var openedDialog:Bool = false;

    var prevAlpha:Float;
    var holdDelayTimer:Float = 0;
    var isHolding:Bool = false;
    var prevPersistentUpdate:Bool;

    var pressArray:Array<Bool> = [];
    var holdArray:Array<Bool> = [];
    var releaseArray:Array<Bool> = [];

    override function create() {
        super.create();

        // Prevent OptionsState update
        prevPersistentUpdate = FlxG.state.persistentUpdate;
        FlxG.state.persistentUpdate = false;

        Cursor.show();
        setupWelcomeMusic();

        var menuBG = new FlxSprite().loadGraphic(Paths.image("menuDesat"));
        menuBG.setGraphicSize(Std.int(FlxG.width * 1.1));
        menuBG.updateHitbox();
        menuBG.screenCenter();
        menuBG.scrollFactor.set(0, 0);
        menuBG.color = 0xFF550011;
        add(menuBG);

        noteStyle = NoteStyleRegistry.instance.fetchEntry(Constants.DEFAULT_NOTE_STYLE);

        initStrumlines();
        initDraggableSprites();

        highlightOutline = new FunkinSprite();
        highlightOutline.makeGraphic(0, 0, 0x00000000);
        highlightOutline.visible = false;
        add(highlightOutline);

        spriteSettingsText = new FlxText(10, 0, 0).setFormat(Paths.font("vcr.ttf"), 20);
        spriteSettingsText.y = Preferences.downscroll ? 25 : FlxG.height * 0.95 - spriteSettingsText.height;
        add(spriteSettingsText);

        initToolbox();
    }

    override function update(elapsed:Float) {
        var mouseX = FlxG.mouse.x;
        var mouseY = FlxG.mouse.y;
        var hoveredDraggable = null;
        var toolboxActive = !isOverToolbox || toolboxWindow.hidden;
        pressArray = [controls.UI_LEFT_P, controls.UI_DOWN_P, controls.UI_UP_P, controls.UI_RIGHT_P];
        holdArray = [controls.UI_LEFT, controls.UI_DOWN, controls.UI_UP, controls.UI_RIGHT];
        releaseArray = [controls.UI_LEFT_R, controls.UI_DOWN_R, controls.UI_UP_R, controls.UI_RIGHT_R];

        // Find hovered Sprite and handle selection
        if (toolboxActive) {
            var i = draggableSprites.length;
            while (i-- > 0) {
                var draggable = draggableSprites[i];
                var isHovering = isPointInsideRotatedSprite(mouseX, mouseY, draggable.sprite);

                // Also check linked sprites if parent sprite isn't hovered
                if (!isHovering && draggable.linkedSprites != null) {
                    for (linked in draggable.linkedSprites) {
                        if (isPointInsideRotatedSprite(mouseX, mouseY, linked.sprite)) {
                            isHovering = true;
                            break;
                        }
                    }
                }

                if (isHovering) {
                    hoveredDraggable = draggable;
                    break;
                }
            }
        }

        if (hoveredDraggable != null && FlxG.mouse.justPressed) {
            // Reset selection status for all sprites
            for (draggable in draggableSprites) {
                draggable.isSelected = (draggable == hoveredDraggable);
                draggable.isDragging = (draggable == hoveredDraggable);
            }

            // Set the clicked sprite as selected
            hoveredDraggable.isSelected = true;
            hoveredDraggable.isDragging = true;

            // Determine which sprite was actually clicked (main or linked)
            var clickedSprite = hoveredDraggable.sprite;
            if (!isPointInsideRotatedSprite(mouseX, mouseY, hoveredDraggable.sprite) && hoveredDraggable.linkedSprites != null) {
                for (linked in hoveredDraggable.linkedSprites) {
                    if (isPointInsideRotatedSprite(mouseX, mouseY, linked.sprite)) {
                        // Adjust offset to maintain the same relative position between main and linked sprite
                        var diffX = linked.sprite.x - hoveredDraggable.sprite.x;
                        var diffY = linked.sprite.y - hoveredDraggable.sprite.y;
                        hoveredDraggable.dragOffsetX = mouseX - linked.sprite.x + diffX;
                        hoveredDraggable.dragOffsetY = mouseY - linked.sprite.y + diffY;
                        prevAlpha = linked.sprite.alpha;
                        clickedSprite = linked.sprite;
                        break;
                    }
                }
            } else {
                // Regular dragging from main sprite
                hoveredDraggable.dragOffsetX = mouseX - hoveredDraggable.sprite.x;
                hoveredDraggable.dragOffsetY = mouseY - hoveredDraggable.sprite.y;
                prevAlpha = hoveredDraggable.sprite.alpha;
            }
        } else if (hoveredDraggable != null && hoveredDraggable.isSelected && FlxG.mouse.justPressedRight)
            showContextMenu(mouseX, mouseY, hoveredDraggable);

        // Handling the sprite movement
        for (draggable in draggableSprites) {
            if (!isSearching && !openedDialog) {
                if (draggable.isDragging) handleDragging(draggable, mouseX, mouseY);
                else if (draggable.isSelected) handleSelected(draggable);

                if (draggable.isSelected || draggable.isDragging) updateHighlight(draggable);
            }
        }

        if (!openedDialog) {
            handleNotePress();
            handleCursor(hoveredDraggable);
        }

        if (FlxG.keys.justPressed.F1 && toolboxWindow.hidden) initToolbox();

        if (FlxG.keys.justPressed.ESCAPE && !isSearching && !openedDialog) close();

        super.update(elapsed);
    }

    // Init
    function initStrumlines() {
        if (playerStrumline != null) remove(playerStrumline);
        playerStrumline = new Strumline(noteStyle, true);
        playerStrumline.y = Preferences.downscroll ? FlxG.height - playerStrumline.height - Constants.STRUMLINE_Y_OFFSET - noteStyle.getStrumlineOffsets()[1] : Constants.STRUMLINE_Y_OFFSET;
        playerStrumline.visible = playerStrum;
        playerStrumline.background.visible = false;
        if (badOptions.middlescroll) playerStrumline.screenCenter(0x01);
        else playerStrumline.x = FlxG.width / 2 + Constants.STRUMLINE_X_OFFSET;
        add(playerStrumline);
        if (badOptions.opponentNoteOpacity > 0) {
            if (opponentStrumline != null) remove(opponentStrumline);
            opponentStrumline = new Strumline(noteStyle, true);
            opponentStrumline.x = Constants.STRUMLINE_X_OFFSET;
            opponentStrumline.y = Preferences.downscroll ? FlxG.height - opponentStrumline.height - Constants.STRUMLINE_Y_OFFSET - noteStyle.getStrumlineOffsets()[1] : Constants.STRUMLINE_Y_OFFSET;
            if (badOptions.middleScroll && !badOptions.oppMiddlescroll)
                opponentStrumline.y = Preferences.downscroll ? opponentStrumline.y - 150 : opponentStrumline.y + 200;
            opponentStrumline.alpha = badOptions.opponentNoteOpacity / 100;
            opponentStrumline.visible = oppStrum;
            opponentStrumline.background.visible = false;
            placeOpponentNotes(opponentStrumline);
            add(opponentStrumline);
        }
    }

    function initDraggableSprites() {}

    function initToolbox() {
        windowManager.reset();
        var handlerWindow = RuntimeComponentBuilder.build(Paths.ui("base-style"));
        if (handlerWindow == null) return;
        add(windowManager);

        toolboxWindow = new Window();
        toolboxWindow.width = 460;
        toolboxWindow.x = 130;
        toolboxWindow.y = FlxG.height / 8;
        toolboxWindow.title = "HUD Manager Panel";
        toolboxWindow.maximizable = false;
        toolboxWindow.maximized = true;

        toolboxWindow.onMouseOver = (event:MouseEvent) -> {
            if (!isOverToolbox) {
                isOverToolbox = true;
                Cursor.cursorMode = CursorMode.Default;
            }
        }
        toolboxWindow.onMouseOut = (event:MouseEvent) -> if (isOverToolbox) isOverToolbox = false;

        var tabView:TabView = new TabView();
        tabView.percentWidth = 100;

        var keybindsTab:Box = new Box();
        keybindsTab.text = "Keybinds";
        keybindsTab.percentWidth = 100;

        var keybindsTable:TableView = new TableView();
        keybindsTable.percentWidth = 100;

        // Add Columns
        var actionColumn = keybindsTable.addColumn("Action");
        actionColumn.percentWidth = 50;
        actionColumn.id = "action";
        var keybindColumn = keybindsTable.addColumn("Keybind");
        keybindColumn.percentWidth = 50;
        keybindColumn.id = "keybind";

        var header = keybindsTable.header;
        if (header != null) header.percentWidth = 100;

        keybindsTable.value = populateKeybindsTable(keybindsTable);

        keybindsTab.addComponent(keybindsTable);

        var visualsTab:Box = new Box();
        visualsTab.text = "Visual Settings";
        visualsTab.percentWidth = 100;

        var strumlineBox = new HBox();
        strumlineBox.percentWidth = 100;

        var playerNotes:CheckBox = createCheckBox("Enable Player Strumline", "If disabled, hides the player strumline in the HUD Manager.", playerStrum, 50, (event:UIEvent) -> if (playerStrumline != null) playerStrumline.visible = playerStrum = event.target.value);
        var oppNotes:CheckBox = createCheckBox("Enable Opponent Strumline", "If disabled, hides the opponent strumline in the HUD Manager.", oppStrum, 50, (event:UIEvent) -> if (opponentStrumline != null) opponentStrumline.visible = oppStrum = event.target.value);

        strumlineBox.addComponent(playerNotes);
        strumlineBox.addComponent(oppNotes);

        visualsTab.addComponent(strumlineBox);

        var settingsTab:VBox = new VBox();
        settingsTab.text = "HUD Settings";
        settingsTab.percentWidth = 100;

        tabView.addComponent(keybindsTab);
        tabView.addComponent(visualsTab);
        tabView.addComponent(settingsTab);
        toolboxWindow.addComponent(tabView);
        windowManager.addWindow(toolboxWindow);
    }

    function showContextMenu(mouseX:Float, mouseY:Float, draggable:DraggableSprite) {
        Screen.instance.removeComponent(contextMenu);
        var spriteType = draggable.spriteType;

        contextMenu = new Menu();
        contextMenu.width = 350;
        contextMenu.x = Math.max(0, Math.min(mouseX, FlxG.width - contextMenu.width));
        contextMenu.y = mouseY;

        var frame:Frame = new Frame();
        frame.text = "Sprite Settings";
        frame.padding = 5;

        var vbox = new VBox();
        vbox.percentWidth = 100;
        vbox.verticalSpacing = 10;

        frame.addComponent(vbox);

        var resetContainer = new VBox();
        resetContainer.percentWidth = 100;
        resetContainer.paddingBottom = 5;

        var resetDialog = new MessageBox();
        resetDialog.title = "Confirm Reset of HUD Element ?";
        trace(resetDialog.iconImage);
        resetDialog.text = "You are about to PERMANENTLY reset this HUD Element to its default position settings.\n\n⚠️ This action CANNOT be undone!\n\nAre you absolutely sure you want to proceed?";
        resetDialog.type = "yesno";
        resetDialog.iconImage.styleString = "resource: 'haxeui-core/styles/shared/warning-large.png'";
        resetDialog.width = 400;
        resetDialog.height = 200;

        var resetButton:Button = new Button();
        resetButton.text = "Reset Element Position";
        resetButton.horizontalAlign = "center";
        resetButton.percentWidth = 60;
        resetButton.onClick = (event:MouseEvent) -> {
            resetDialog.showDialog();
            openedDialog = true;
        }

        resetDialog.onDialogClosed = (event:DialogEvent) -> {
            openedDialog = false;
            if (event.button == "{{yes}}") {
                Save.instance.modOptions.remove(spriteType + "Settings");

                draggableSprites = draggableSprites.filter(oldDraggable -> oldDraggable.spriteType != spriteType);

                for (newDraggable in draggableSprites) {
                    if (newDraggable.spriteType == spriteType) {
                        newDraggable.isSelected = true;
                        updateHighlight(newDraggable);
                        updateText(newDraggable);
                        break;
                    }
                }
            }
            contextMenu.hide();
        }

        resetContainer.addComponent(resetButton);
        contextMenu.addComponent(frame);
        contextMenu.addComponent(resetContainer);
        Screen.instance.addComponent(contextMenu);
    }

    // Handlers
    function handleDragging(draggable:DraggableSprite, mouseX:Float, mouseY:Float) {
        if (FlxG.mouse.pressed) {
            if (FlxG.keys.pressed.ALT) {
                var spriteMiddleX = draggable.sprite.x + draggable.sprite.width / 2;
                var spriteMiddleY = draggable.sprite.y + draggable.sprite.height / 2;
                var angle = FlxAngle.degreesFromOrigin(mouseX - spriteMiddleX, mouseY - spriteMiddleY);
                draggable.sprite.angle = Math.round(angle);

                if (draggable.linkedSprites != null) for (linked in draggable.linkedSprites) linked.sprite.angle = draggable.sprite.angle;
            } else {
                draggable.sprite.alpha = 0.4;
                var newPos = calculateDragPosition(draggable, mouseX, mouseY);
                draggable.sprite.setPosition(newPos.x, newPos.y);

                // Move linked sprites
                if (draggable.linkedSprites != null) {
                    for (linked in draggable.linkedSprites) {
                        linked.sprite.alpha = 0.4;
                        syncSpriteWithTarget(linked, draggable);
                    }
                }
            }
            updateText(draggable);
        } else { // Mouse released
            draggable.isDragging = false;
            draggable.sprite.alpha = prevAlpha;
            if (draggable.linkedSprites != null && draggable.linkedSprites.length > 0) for (linked in draggable.linkedSprites) linked.sprite.alpha = prevAlpha;
            saveSpriteSettings(draggable);
        }
    }

    function handleSelected(draggable:DraggableSprite) {
        var holdDelayThreshold:Float = 0.25;
        var moveSpeed:Float = 10;
        if (FlxG.keys.pressed.CONTROL) moveSpeed = 0.5;
        else if (FlxG.keys.pressed.SHIFT) moveSpeed = 0.25;

        var newX = draggable.sprite.x;
        var newY = draggable.sprite.y;

        if (holdArray.contains(true)) {
            if (!isHolding) {
                holdDelayTimer = 0;
                isHolding = true;
            } else holdDelayTimer += FlxG.elapsed;
        } else {
            isHolding = false;
            holdDelayTimer = 0;
        }

        for (i in 0...pressArray.length) {
            if (pressArray[i]) {
                switch (i) {
                    case 0: newX -= moveSpeed; // Left
                    case 1: newY += moveSpeed; // Down
                    case 2: newY -= moveSpeed; // Up
                    case 3: newX += moveSpeed; // Right
                }
            } else if (holdArray[i] && (holdDelayTimer > holdDelayThreshold)) {
                // Only apply hold movement after the delay threshold
                switch (i) {
                    case 0: newX -= moveSpeed; // Left
                    case 1: newY += moveSpeed; // Down
                    case 2: newY -= moveSpeed; // Up
                    case 3: newX += moveSpeed; // Right
                }
            }
        }

        var constrained = applyBoundaryConstraints(newX, newY, draggable.sprite);
        draggable.sprite.setPosition(constrained.x, constrained.y);

        if (controls.UI_DOWN_R || controls.UI_UP_R || controls.UI_LEFT_R || controls.UI_RIGHT_R) saveSpriteSettings(draggable);

        if (FlxG.mouse.wheel != 0) {
            var maxScaleX:Float = FlxG.width / draggable.sprite.frameWidth;
            var maxScaleY:Float = FlxG.height / draggable.sprite.frameHeight;

            // Store original center coordinates
            var centerX = draggable.sprite.x + draggable.sprite.width / 2;
            var centerY = draggable.sprite.y + draggable.sprite.height / 2;

            var scaleChange = FlxG.mouse.wheel > 0 ? 0.1 : -0.1;
            var newScaleX = draggable.sprite.scale.x;
            var newScaleY = draggable.sprite.scale.y;

            if (FlxG.keys.pressed.CONTROL) newScaleX = Math.min(Math.round((draggable.sprite.scale.x + scaleChange) * 10) / 10, maxScaleX);
            else if (FlxG.keys.pressed.SHIFT) newScaleY = Math.min(Math.round((draggable.sprite.scale.y + scaleChange) * 10) / 10, maxScaleY);
            else {
                newScaleX = Math.min(Math.round((draggable.sprite.scale.x + scaleChange) * 10) / 10, maxScaleX);
                newScaleY = Math.min(Math.round((draggable.sprite.scale.y + scaleChange) * 10) / 10, maxScaleY);
            }
            draggable.sprite.updateHitbox();

            // Reposition to maintain center
            draggable.sprite.setPosition(centerX - draggable.sprite.width / 2, centerY - draggable.sprite.height / 2);

            // Scale linked sprites together
            if (checkScaleBounds(draggable.sprite, newScaleX, newScaleY, centerX, centerY)) {
                draggable.sprite.scale.set(newScaleX, newScaleY);
                draggable.sprite.updateHitbox();
                draggable.sprite.setPosition(centerX - draggable.sprite.width / 2, centerY - draggable.sprite.height / 2);

                // Scale linked sprites together
                if (draggable.linkedSprites != null) for (linked in draggable.linkedSprites) {
                    syncSpriteWithTarget(linked, draggable);
                    linked.sprite.scale = draggable.sprite.scale;
                    linked.sprite.updateHitbox();
                }
                saveSpriteSettings(draggable);
            }
        } else {
            if (draggable.linkedSprites != null) for (linked in draggable.linkedSprites) syncSpriteWithTarget(linked, draggable);
        }

        updateText(draggable);
    }

    function handleNotePress() {
        if (playerStrumline == null || isSearching) return;
        var notePressArray:Array<Bool> = [controls.NOTE_LEFT_P, controls.NOTE_DOWN_P, controls.NOTE_UP_P, controls.NOTE_RIGHT_P];
        var noteHoldArray:Array<Bool> = [controls.NOTE_LEFT, controls.NOTE_DOWN, controls.NOTE_UP, controls.NOTE_RIGHT];
        var noteReleaseArray:Array<Bool> = [controls.NOTE_LEFT_R, controls.NOTE_DOWN_R, controls.NOTE_UP_R, controls.NOTE_RIGHT_R];
        for (i in 0...pressArray.length) {
            if (pressArray[i] || notePressArray[i]) playerStrumline.playConfirm(i);
            else if (holdArray[i] || noteHoldArray[i]) playerStrumline.holdConfirm(i);
            if (releaseArray[i] || noteReleaseArray[i]) playerStrumline.playStatic(i);
        }
    }

    function handleCursor(hoveredDraggable) {
        // Mouse sounds
        if (Cursor.cursorMode != CursorMode.Default || isOverToolbox) {
            if (FlxG.mouse.justPressed || FlxG.mouse.justPressedRight) FunkinSound.playOnce(Paths.sound("chartingSounds/ClickDown"));
            if (FlxG.mouse.justReleased || FlxG.mouse.justReleasedRight) FunkinSound.playOnce(Paths.sound("chartingSounds/ClickUp"));
        }

        // Switch Sprites
        if (hoveredDraggable != null) Cursor.cursorMode = hoveredDraggable.isDragging ? CursorMode.Grabbing : CursorMode.Pointer;
        else Cursor.cursorMode = CursorMode.Default;
    }

    // Util Methods
    function createCheckBox(text:String, tooltip:String, value:Bool, width:Float, onChange:UIEvent -> Void):CheckBox {
        var checkbox = checkboxPool.length > 0 ? checkboxPool.pop() : new CheckBox();

        checkbox.text = text;
        checkbox.tooltip = tooltip;
        checkbox.selected = value;
        checkbox.percentWidth = width;
        checkbox.onChange = onChange;

        return checkbox;
    }

    function createOptionBox(labelText:String, tooltip:String, currentValue:String, options:Array<BasicEntry>, onChangeHandler:String -> Void):HBox {
        var box = new HBox();
        box.percentWidth = 100;

        var label = new Label();
        label.text = labelText;
        label.percentWidth = 35;
        label.verticalAlign = "center";

        var stepper:OptionStepper = new OptionStepper();
        stepper.tooltip = tooltip;
        stepper.percentWidth = 65;
        stepper.dataSource = new ArrayDataSource();
        for (option in options) stepper.dataSource.add(option);

        for (i in 0...stepper.dataSource.size)
            if (stepper.dataSource.get(i).id == currentValue) {
                stepper.selectedIndex = i;
                break;
            }

        var callback_persist = onChangeHandler;
        stepper.onChange = (event:UIEvent) -> callback_persist(stepper.value.id);

        box.addComponent(label);
        box.addComponent(stepper);
        return box;
    }

    function createNumberBox(labelText:String, tooltip:String, valueFormat:String, min:Float, step:Float, precision:Int, currentValue:Float, onChangeHandler:Float -> Void):HBox {
        var box = new HBox();
        box.percentWidth = 100;

        var label = new Label();
        label.text = labelText;
        label.percentWidth = 55;
        label.verticalAlign = "center";

        var stepper:NumberStepper = new NumberStepper();
        stepper.percentWidth = 35;
        stepper.pos = currentValue;
        stepper.min = min;
        stepper.precision = precision;
        stepper.step = step;
        stepper.tooltip = tooltip;

        var callback_persist = onChangeHandler;
        stepper.onChange = (event:UIEvent) -> callback_persist(stepper.pos);

        var symbolLabel = new Label();
        symbolLabel.text = valueFormat;
        symbolLabel.percentWidth = 10;
        symbolLabel.verticalAlign = "center";

        box.addComponent(label);
        box.addComponent(stepper);
        box.addComponent(symbolLabel);
        return box;
    }

    function updateHighlight(?draggable:DraggableSprite) {
        if (draggable == null || !draggable.isSelected) {
            highlightOutline.visible = false;
            return;
        }

        // Start with the main sprite's bounds
        var minX = draggable.sprite.x;
        var maxX = draggable.sprite.x + draggable.sprite.width;
        var minY = draggable.sprite.y;
        var maxY = draggable.sprite.y + draggable.sprite.height;

        // Include all linked sprites in the bounds
        if (draggable.linkedSprites != null && draggable.linkedSprites.length > 0) {
            for (linkedSprite in draggable.linkedSprites) {
                if (linkedSprite != null && linkedSprite.sprite != null) {
                    var spriteX = linkedSprite.sprite.x;
                    var spriteY = linkedSprite.sprite.y;
                    var spriteMaxX = spriteX + linkedSprite.sprite.width;
                    var spriteMaxY = spriteY + linkedSprite.sprite.height;

                    // Update bounds if needed
                    minX = Math.min(minX, spriteX);
                    maxX = Math.max(maxX, spriteMaxX);
                    minY = Math.min(minY, spriteY);
                    maxY = Math.max(maxY, spriteMaxY);
                }
            }
        }

        // Calculate total width and height with padding
        var totalWidth = maxX - minX;
        var totalHeight = maxY - minY;
        var padding = 5;
        var targetWidth = Std.int(totalWidth + (padding * 2));
        var targetHeight = Std.int(totalHeight + (padding * 2));

        // Only recreate when dimensions change
        if (!highlightInitialized || highlightOutline.width != targetWidth || highlightOutline.height != targetHeight) {
            highlightOutline.makeGraphic(targetWidth, targetHeight, 0x00000000, true);
            FlxSpriteUtil.drawRect(highlightOutline, 0, 0, highlightOutline.width, highlightOutline.height, 0x00000000,
            {color: 0xFF339933, thickness: 3});
            highlightInitialized = true;
        }

        // Position the highlight at the min bounds minus padding
        highlightOutline.x = minX - padding;
        highlightOutline.y = minY - padding;
        highlightOutline.angle = draggable.sprite.angle; // Use the main sprite's angle
        highlightOutline.visible = true;
    }

    function addDraggableSprite(sprite:FlxSprite, type:String):DraggableSprite {
        var draggable:DraggableSprite = {
            sprite: sprite,
            isDragging: false,
            isSelected: false,
            dragOffsetX: 0,
            dragOffsetY: 0,
            spriteType: type,
            linkedSprites: []
        };

        draggableSprites.push(draggable);
        return draggable;
    }

    function linkSpriteToTarget(targetDraggable:DraggableSprite, sprite:FlxSprite, index:Int = 1) {
        var linked:LinkedSprite = {
            sprite: sprite,
            index: index
        };
        targetDraggable.linkedSprites.push(linked);

        if (targetDraggable.spriteType != "combo") syncSpriteWithTarget(linked, targetDraggable);
    }

    function syncSpriteWithTarget(linkedSprite:LinkedSprite, targetSprite:DraggableSprite) {
        linkedSprite.sprite.angle = targetSprite.sprite.angle;
        if (!Std.isOfType(linkedSprite.sprite, FlxBar) && targetSprite.spriteType != "restBar") linkedSprite.sprite.scale = targetSprite.sprite.scale;
        linkedSprite.sprite.updateHitbox();

        var targetCenterX = targetSprite.sprite.x + targetSprite.sprite.width / 2;
        var targetCenterY = targetSprite.sprite.y + targetSprite.sprite.height / 2;

        if (Std.isOfType(linkedSprite.sprite, FlxText)) {
            var text = Std.downcast(linkedSprite.sprite, FlxText);
            linkedSprite.sprite.setPosition(
                targetCenterX - linkedSprite.sprite.width / 2,
                targetCenterY - text.fieldHeight / 2);
        } else {
            var indexOffset = 0.0;
            if (targetSprite.spriteType == "combo") indexOffset = -((38 - (noteStyle.buildComboNumSprite(3 - linkedSprite.index).width - linkedSprite.sprite.width)) * linkedSprite.index);

            linkedSprite.sprite.setPosition(
                targetCenterX - linkedSprite.sprite.width / 2 + indexOffset,
                targetCenterY - linkedSprite.sprite.height / 2);
        }
    }

    function updateText(?draggable:DraggableSprite) {
        if (draggable == null) {
            spriteSettingsText.text = "";
            return;
        }
        if (spriteSettingsText != null) spriteSettingsText.text = "Offsets: " + draggable.sprite.getPosition() + "\nScale: " + draggable.sprite.scale + "\nRotation: " + draggable.sprite.angle;

        if ((draggable.spriteType == "judgementsText" || draggable.spriteType == "statsText" || draggable.spriteType == "kpsText") && Std.isOfType(draggable.sprite, FlxText)) {
            var text = Std.downcast(draggable.sprite, FlxText);
            if (text.x < FlxG.width / 2) text.alignment = "left";
            else text.alignment = "right";
        }
    }

    function saveSpriteSettings(draggable:DraggableSprite) {
        var originalScale = {x: 0.0, y: 0.0};
        if (draggable.spriteType == "judgement") originalScale = noteStyle.buildJudgementSprite("sick").scale;
        else if (draggable.spriteType == "combo") originalScale = noteStyle.buildComboNumSprite(0).scale;

        var xPos = Std.int(draggable.sprite.x + draggable.sprite.width / 2);
        if (draggable.spriteType == "kpsText") xPos = Std.int(draggable.sprite.x);
        else if ((draggable.spriteType == "statsText" || draggable.spriteType == "judgementsText") && Std.isOfType(draggable.sprite, FlxText)) {
            var text = Std.downcast(draggable.sprite, FlxText);
            if (text.alignment == "right") xPos = Std.int(draggable.sprite.x + draggable.sprite.width);
            else xPos = Std.int(draggable.sprite.x);
        }

        var yPos = (draggable.spriteType == "statsText" || draggable.spriteType == "judgementsText" || draggable.spriteType == "kpsText")
        ? Std.int(draggable.sprite.y)
        : Std.int(draggable.sprite.y + draggable.sprite.height / 2);

        var settingsKey = draggable.spriteType + "Settings";
        Save.instance.modOptions.set(settingsKey, [
            xPos, yPos,
            draggable.sprite.scale.x - originalScale.x, draggable.sprite.scale.y - originalScale.y,
            draggable.sprite.angle
        ]);
    }

    function positionUIElement(sprite:FlxSprite, settingsKey:String, additionalSettings:String -> Void, defaultPosition:FlxSprite -> Void, centered:Bool) {
        var settings = Save.instance.modOptions.get(settingsKey);
        if (settings != null) {
            sprite.angle = settings[4];
            sprite.scale.x = settings[2];
            sprite.scale.y = settings[3];
            sprite.updateHitbox();
            if (centered) sprite.setPosition(settings[0] - sprite.width / 2, settings[1] - sprite.height / 2);
            else sprite.setPosition(settings[0], settings[1]);

            if (additionalSettings != null) additionalSettings(settings);
        } else { if (defaultPosition != null) defaultPosition(sprite); }
    }

    function populateKeybindsTable(tableView:TableView):Array<KeybindEntry> {
        tableView.dataSource.clear();
        var keybinds:Array<KeybindEntry> = [
            {action: "Show Guide", keybind: "F1"},
            {action: "Return to Options", keybind: "Esc/F5"},
            {action: "Open Sprite Context Menu", keybind: "Right Mouse Button"},
            {action: "Drag / Select Sprite", keybind: "Left Mouse Button"},
            {action: "Rotate Sprite", keybind: "Alt + Right Mouse Button"},
            {action: "Precise Sprite Movement", keybind: "W/A/S/D (+ 10) \nCtrl + W/A/S/D (+ 0.5)\nShift + W/A/S/D (+ 0.25)"},
            {action: "Precise Sprite Scaling", keybind: "Mouse Wheel (-/+ 0.1) \nCtrl + Mouse Wheel (-/+ 0.1 y-axis)\nShift + W/A/S/D (-/+ 0.1 x-axis)"},
        ];

        for (keybind in keybinds) tableView.dataSource.add(keybind);
        return keybinds;
    }

    function placeOpponentNotes(strumline:Strumline) {
        if (!badOptions.middlescroll || badOptions.opponentNoteOpacity <= 0) return;
        if (badOptions.oppMiddlescroll) {
            strumline.scale.set(noteStyle.getNoteScale(), noteStyle.getNoteScale());
            var rightXOffset = badOptions.healthBar ? Constants.STRUMLINE_X_OFFSET : 150;
            for (i in 2...4) {
                var note = strumline.strumlineNotes.members[i];
                note.x = FlxG.width - strumline.width + rightXOffset + Strumline.NOTE_SPACING * (i - 2);
            }
        } else {
            var scaling = 0.5;
            strumline.scale.set(noteStyle.getNoteScale() - noteStyle.getNoteScale() * scaling, noteStyle.getNoteScale() - noteStyle.getNoteScale() * scaling);
            strumline.y = Preferences.downscroll ? FlxG.height - 350 : 200;
            var noteSpacing = Strumline.NOTE_SPACING - Strumline.NOTE_SPACING * scaling;
            for (note in strumline.strumlineNotes.members) {
                note.x = strumline.x;
                note.x += switch (note.direction % Strumline.KEY_COUNT) {
                    case 0: 0;
                    case 1: (1 * noteSpacing);
                    case 2: (2 * noteSpacing);
                    case 3: (3 * noteSpacing);
                    default: 0;
                };
                note.x -= ((note.width - Strumline.STRUMLINE_SIZE) / 2) * scaling;
                note.x -= Strumline.NUDGE * scaling;
            }
        }
    }

    function setupWelcomeMusic() {
        if (FlxG.sound.music != null) FlxG.sound.music.pause();
        welcomeMusic = FunkinSound.load(Paths.music("chartEditorLoop/chartEditorLoop"), true, true);
        welcomeMusic.play(false, FlxG.random.int(0, Std.int(welcomeMusic.length / 2)));
    }
    //  RotationUtil
    function checkScaleBounds(sprite:FlxSprite, newScaleX:Float, newScaleY:Float, centerX:Float, centerY:Float):Bool {
        // Store original values
        var origX = sprite.x;
        var origY = sprite.y;
        var origScaleX = sprite.scale.x;
        var origScaleY = sprite.scale.y;

        // Apply new scale temporarily
        sprite.scale.set(newScaleX, newScaleY);
        sprite.updateHitbox();
        sprite.setPosition(centerX - sprite.width / 2, centerY - sprite.height / 2);

        // Check if sprite would be out of bounds with new scale
        var corners = getRotatedCorners(sprite);
        var bounds = getMinMaxBounds(corners);
        var outOfBounds = (bounds.minX < 0 || bounds.minY < 0 ||
        bounds.maxX > FlxG.width || bounds.maxY > FlxG.height);

        // Restore original values
        sprite.scale.set(origScaleX, origScaleY);
        sprite.updateHitbox();
        sprite.setPosition(origX, origY);

        return !outOfBounds;
    }

    function calculateDragPosition(draggable:DraggableSprite, mouseX:Float, mouseY:Float) {
        var newX = mouseX - draggable.dragOffsetX;
        var newY = mouseY - draggable.dragOffsetY;

        return applyBoundaryConstraints(newX, newY, draggable.sprite);
    }

    function applyBoundaryConstraints(newX:Float, newY:Float, sprite:FlxSprite):{x:Float, y:Float} {
        // Fast path for unrotated sprites
        if (sprite.angle % 360 == 0) return {
            x: Math.max(0, Math.min(FlxG.width - sprite.width, newX)),
            y: Math.max(0, Math.min(FlxG.height - sprite.height, newY))
        };

        // Only calculate corners for rotated sprites
        var origX = sprite.x;
        var origY = sprite.y;

        sprite.setPosition(newX, newY);
        var corners = getRotatedCorners(sprite);
        sprite.setPosition(origX, origY);

        var bounds = getMinMaxBounds(corners);

        // Apply constraints only if needed
        if (bounds.minX < 0) newX += (0 - bounds.minX);
        if (bounds.minY < 0) newY += (0 - bounds.minY);
        if (bounds.maxX > FlxG.width) newX -= (bounds.maxX - FlxG.width);
        if (bounds.maxY > FlxG.height) newY -= (bounds.maxY - FlxG.height);

        return {x: newX, y: newY};
    }

    function isPointInsideRotatedSprite(pointX:Float, pointY:Float, sprite:FlxSprite):Bool {
        // If sprite isn't rotated, use simple bounding box check
        if (sprite.angle % 360 == 0) {
            return pointX >= sprite.x &&
            pointX <= sprite.x + sprite.width &&
            pointY >= sprite.y &&
            pointY <= sprite.y + sprite.height;
        }

        var corners = getRotatedCorners(sprite);
        return isPointInPolygon(pointX, pointY, corners);
    }

    function isPointInPolygon(pointX:Float, pointY:Float, vertices:Array<{x:Float, y:Float}>):Bool {
        var inside = false;
        var n = vertices.length;
        var j = n - 1;

        for (i in 0...n) {
            // Cache vertex lookups to avoid repeated array access
            var vertexI = vertices[i];
            var vertexJ = vertices[j];

            // Faster computation by avoiding division when possible
            if (((vertexI.y > pointY) != (vertexJ.y > pointY)) && (pointX < ((vertexJ.x - vertexI.x) * (pointY - vertexI.y) / (vertexJ.y - vertexI.y) + vertexI.x))) inside = !inside;
            j = i;
        }

        return inside;
    }

    function getRotatedCorners(sprite:FlxSprite):Array<{x:Float, y:Float}> {
        var centerX = sprite.x + sprite.width / 2;
        var centerY = sprite.y + sprite.height / 2;
        var halfWidth = sprite.width / 2;
        var halfHeight = sprite.height / 2;

        // Cache these calculations
        var angleRad = FlxAngle.asRadians(sprite.angle);
        var cos = Math.cos(angleRad);
        var sin = Math.sin(angleRad);

        // Pre-allocate array with fixed size for better memory management
        var corners:Array<{x:Float, y:Float}> = [
            { x: (-halfWidth * cos) - (-halfHeight * sin) + centerX, y: (-halfWidth * sin) + (-halfHeight * cos) + centerY },
            { x: (halfWidth * cos) - (-halfHeight * sin) + centerX, y: (halfWidth * sin) + (-halfHeight * cos) + centerY },
            { x: (halfWidth * cos) - (halfHeight * sin) + centerX, y: (halfWidth * sin) + (halfHeight * cos) + centerY },
            { x: (-halfWidth * cos) - (halfHeight * sin) + centerX, y: (-halfWidth * sin) + (halfHeight * cos) + centerY }
        ];

        return corners;
    }

    function getMinMaxBounds(corners:Array<{x:Float, y:Float}>):{minX:Float, minY:Float, maxX:Float, maxY:Float} {
        var minX = Math.POSITIVE_INFINITY, minY = Math.POSITIVE_INFINITY;
        var maxX = Math.NEGATIVE_INFINITY, maxY = Math.NEGATIVE_INFINITY;

        for (corner in corners) {
            minX = Math.min(minX, corner.x);
            minY = Math.min(minY, corner.y);
            maxX = Math.max(maxX, corner.x);
            maxY = Math.max(maxY, corner.y);
        }

        return {minX: minX, minY: minY, maxX: maxX, maxY: maxY};
    }

    // Cleanup
    override function close() {
        cleanup();
        super.close();
    }

    override function destroy() {
        cleanup();
        super.destroy();
    }

    function cleanup() {
        Cursor.hide();
        if (welcomeMusic != null) welcomeMusic.destroy();
        if (FlxG.sound.music != null) FlxG.sound.music.resume();
        FlxG.state.persistentUpdate = prevPersistentUpdate;
    }
}

typedef DraggableSprite = {
    sprite:FlxSprite,
    isDragging:Bool,
    isSelected:Bool,
    dragOffsetX:Float,
    dragOffsetY:Float,
    spriteType:String,
    linkedSprites:Array<LinkedSprite>
}

typedef LinkedSprite = {
    sprite:FlxSprite,
    index:Int
}

typedef KeybindEntry = {
    action:String,
    keybind:String
}

typedef BasicEntry = {
    id:String,
    text:String
}