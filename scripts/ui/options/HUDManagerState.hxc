package ui.options;

import funkin.Paths;
import funkin.Preferences;
import funkin.audio.FunkinSound;
import funkin.data.notestyle.NoteStyleRegistry;
import funkin.graphics.FunkinSprite;
import funkin.input.Cursor;
import funkin.input.CursorMode;
import funkin.modding.base.ScriptedFlxSpriteGroup;
import funkin.modding.base.ScriptedMusicBeatSubState;
import funkin.modding.module.ModuleHandler;
import funkin.play.PauseSubState;
import funkin.play.notes.Strumline;
import funkin.play.notes.notestyle.NoteStyle;
import funkin.save.Save;
import funkin.ui.debug.charting.util.ChartEditorDropdowns;
import funkin.ui.options.OptionsState;
import funkin.util.Constants;

import flixel.FlxG;
import flixel.FlxSprite;
import flixel.text.FlxText;
import flixel.ui.FlxBar;
import flixel.ui.FlxBarFillDirection;

import haxe.ui.components.CheckBox;
import haxe.ui.components.DropDown;
import haxe.ui.components.Label;
import haxe.ui.containers.HBox;
import haxe.ui.containers.TableView;
import haxe.ui.containers.windows.Window;
import haxe.ui.containers.windows.WindowManager;
import haxe.ui.events.MouseEvent;
import haxe.ui.events.UIEvent;

class HUDManagerState extends ScriptedMusicBeatSubState {
    var badOptions:Null<BadSaveData> = Save.instance.modOptions.get("badOptions");

    var welcomeMusic:FunkinSound = new FunkinSound();
    var playerStrumline:Strumline;
    var opponentStrumline:Strumline;
    var noteStyle:NoteStyle;

    var ratingsPopUps:RatingPopUps;
    var comboSprites:Array<FunkinSprite> = [];
    var draggableSprites:Array<DraggableSprite> = [];

    var highlightOutline:FunkinSprite;

    var spriteSettingsText:FlxText;

    var toolboxWindow:Window;
    var isOverToolbox:Bool = false;

    var holdDelayTimer:Float = 0;
    var isHolding:Bool = false;

    // Prevet OptionsState update
    var prevPersistentUpdate:Bool;

    override function create() {
        super.create();

        prevPersistentUpdate = FlxG.state.persistentUpdate;
        FlxG.state.persistentUpdate = false;

        Cursor.show();
        setupWelcomeMusic();

        var menuBG = new FlxSprite().loadGraphic(Paths.image("menuDesat"));
        menuBG.setGraphicSize(Std.int(menuBG.width * 1.1));
        menuBG.updateHitbox();
        menuBG.screenCenter();
        menuBG.scrollFactor.set(0, 0);
        menuBG.color = 0xFF550011;
        add(menuBG);

        noteStyle = NoteStyleRegistry.instance.fetchEntry(Constants.DEFAULT_NOTE_STYLE);

        initStrumline();

        initDraggableSprites();

        highlightOutline = new FunkinSprite();
        highlightOutline.makeGraphic(0, 0, 0x00000000);
        highlightOutline.visible = false;
        add(highlightOutline);

        spriteSettingsText = new FlxText(10, 0, 0).setFormat(Paths.font("vcr.ttf"), 20);
        spriteSettingsText.y = Preferences.downscroll ? 20 : FlxG.height * 0.95 - spriteSettingsText.height;
        add(spriteSettingsText);

        initToolbox();
    }

    override function update(elapsed:Float) {
        var mouseX = FlxG.mouse.x;
        var mouseY = FlxG.mouse.y;
        var hoveredSprite = null;

        if (!isOverToolbox || toolboxWindow.hidden) {
            for (i in 0...draggableSprites.length) {
                var draggable = draggableSprites[draggableSprites.length - 1 - i];
                var sprite = draggable.sprite;

                var isMouseOver:Bool = isPointInsideRotatedSprite(mouseX, mouseY, sprite);

                if (isMouseOver) {
                    hoveredSprite = draggable;
                    break;
                }
            }
        }

        if (hoveredSprite != null && FlxG.mouse.justPressed) {
            for (draggable in draggableSprites) { draggable.isSelected = false; draggable.isDragging = false; }
            hoveredSprite.isSelected = true;
            hoveredSprite.isDragging = true;
            hoveredSprite.dragOffsetX = mouseX - hoveredSprite.sprite.x;
            hoveredSprite.dragOffsetY = mouseY - hoveredSprite.sprite.y;
        }

        // Handling the sprite movement
        for (draggable in draggableSprites) {
            if (draggable.isDragging) {
                if (FlxG.mouse.pressed) {
                    if (FlxG.keys.pressed.ALT) {
                        var spriteMiddleX = draggable.sprite.x + draggable.sprite.width / 2;
                        var spriteMiddleY = draggable.sprite.y + draggable.sprite.height / 2;
                        var angle = Math.atan2(mouseY - spriteMiddleY, mouseX - spriteMiddleX) * 180 / Math.PI;
                        draggable.sprite.angle = Math.round(angle);

                        // Rotate linked/combo sprites together
                        if (draggable.linkedSprites != null && draggable.linkedSprites.length > 0) for (linked in draggable.linkedSprites) linked.sprite.angle = draggable.sprite.angle;
                        if (draggable.spriteType == "combo") for (i in 1...comboSprites.length)comboSprites[i].angle = draggable.sprite.angle;
                    } else {
                        var newX = mouseX - draggable.dragOffsetX;
                        var newY = mouseY - draggable.dragOffsetY;

                        // Calculate movement limits considering rotation
                        if (draggable.sprite.angle % 360 != 0) {
                            // Calculate rotated bounds
                            var corners = getRotatedCorners(draggable.sprite);

                            // Find min/max bounds of rotated sprite
                            var minX = Math.POSITIVE_INFINITY, minY = Math.POSITIVE_INFINITY;
                            var maxX = Math.NEGATIVE_INFINITY, maxY = Math.NEGATIVE_INFINITY;

                            for (corner in corners) {
                                minX = Math.min(minX, corner.x);
                                minY = Math.min(minY, corner.y);
                                maxX = Math.max(maxX, corner.x);
                                maxY = Math.max(maxY, corner.y);
                            }

                            // Calculate offsets from sprite's top-left to rotated bounds
                            var leftOffset = draggable.sprite.x - minX;
                            var topOffset = draggable.sprite.y - minY;
                            var rightOffset = maxX - draggable.sprite.x - draggable.sprite.width;
                            var bottomOffset = maxY - draggable.sprite.y - draggable.sprite.height;

                            // Apply boundary constraints with rotated dimensions
                            newX = Math.max(leftOffset, Math.min(FlxG.width - draggable.sprite.width - rightOffset, newX));
                            newY = Math.max(topOffset, Math.min(FlxG.height - draggable.sprite.height - bottomOffset, newY));
                        } else {
                            // Non-rotated sprite uses standard bounds
                            newX = Math.max(0, Math.min(FlxG.width - draggable.sprite.width, newX));
                            newY = Math.max(0, Math.min(FlxG.height - draggable.sprite.height, newY));
                        }

                        var oldX = draggable.sprite.x;
                        var oldY = draggable.sprite.y;

                        draggable.sprite.setPosition(newX, newY);

                        // Move all combo sprites together
                        if (draggable.spriteType == "combo") {
                            var offsetX = newX - oldX;
                            var offsetY = newY - oldY;

                            for (i in 1...comboSprites.length) {
                                comboSprites[i].x += offsetX;
                                comboSprites[i].y += offsetY;
                            }
                        }
                        if (draggable.linkedSprites != null && draggable.linkedSprites.length > 0) for (linked in draggable.linkedSprites) linked.sprite.setPosition(newX + linked.offsetX, newY + linked.offsetY);
                    }
                    updateText(draggable);
                } else { // Mouse released
                    draggable.isDragging = false;
                    saveSpriteSettings(draggable);
                }
            } else if (draggable.isSelected) {
                var pressArray:Array<Bool> = [controls.UI_LEFT_P, controls.UI_DOWN_P, controls.UI_UP_P, controls.UI_RIGHT_P];
                var holdArray:Array<Bool> = [controls.UI_LEFT, controls.UI_DOWN, controls.UI_UP, controls.UI_RIGHT];

                var holdDelayThreshold:Float = 0.25;
                var moveSpeed:Float = 10;
                if (FlxG.keys.pressed.CONTROL) moveSpeed = 0.5;
                else if (FlxG.keys.pressed.SHIFT) moveSpeed = 0.25;

                var newX = draggable.sprite.x;
                var newY = draggable.sprite.y;
                var oldX = newX;
                var oldY = newY;

                if (holdArray.contains(true)) {
                    if (!isHolding) {
                        holdDelayTimer = 0;
                        isHolding = true;
                    } else holdDelayTimer += FlxG.elapsed;
                } else {
                    isHolding = false;
                    holdDelayTimer = 0;
                }

                for (i in 0...pressArray.length) {
                    if (pressArray[i]) {
                        // Initial press - move immediately
                        switch (i) {
                            case 0: newX -= moveSpeed; // Left
                            case 1: newY += moveSpeed; // Down
                            case 2: newY -= moveSpeed; // Up
                            case 3: newX += moveSpeed; // Right
                        }
                    } else if (holdArray[i] && (holdDelayTimer > holdDelayThreshold)) {
                        // Only apply hold movement after the delay threshold
                        switch (i) {
                            case 0: newX -= moveSpeed; // Left
                            case 1: newY += moveSpeed; // Down
                            case 2: newY -= moveSpeed; // Up
                            case 3: newX += moveSpeed; // Right
                        }
                    }
                }

                // Calculate movement limits considering rotation
                if (draggable.sprite.angle % 360 != 0) {
                    // Store original position to calculate rotated corners
                    var origX = draggable.sprite.x;
                    var origY = draggable.sprite.y;

                    // Temporarily set position to new position to calculate rotated bounds
                    draggable.sprite.setPosition(newX, newY);

                    // Calculate rotated bounds at new position
                    var corners = getRotatedCorners(draggable.sprite);

                    // Restore original position
                    draggable.sprite.setPosition(origX, origY);

                    // Find min/max bounds of rotated sprite
                    var minX = Math.POSITIVE_INFINITY, minY = Math.POSITIVE_INFINITY;
                    var maxX = Math.NEGATIVE_INFINITY, maxY = Math.NEGATIVE_INFINITY;

                    for (corner in corners) {
                        minX = Math.min(minX, corner.x);
                        minY = Math.min(minY, corner.y);
                        maxX = Math.max(maxX, corner.x);
                        maxY = Math.max(maxY, corner.y);
                    }

                    // Check bounds and adjust if needed
                    if (minX < 0) newX += (0 - minX);
                    if (minY < 0) newY += (0 - minY);
                    if (maxX > FlxG.width) newX -= (maxX - FlxG.width);
                    if (maxY > FlxG.height) newY -= (maxY - FlxG.height);
                } else {
                    // Non-rotated sprite uses standard bounds
                    newX = Math.max(0, Math.min(FlxG.width - draggable.sprite.width, newX));
                    newY = Math.max(0, Math.min(FlxG.height - draggable.sprite.height, newY));
                }

                draggable.sprite.setPosition(newX, newY);

                // Move all linked/combo sprites together
                if (draggable.spriteType == "combo") {
                    var offsetX = newX - oldX;
                    var offsetY = newY - oldY;

                    for (i in 1...comboSprites.length) {
                        comboSprites[i].x += offsetX;
                        comboSprites[i].y += offsetY;
                    }
                }

                if (controls.UI_DOWN_R || controls.UI_UP_R || controls.UI_LEFT_R || controls.UI_RIGHT_R) saveSpriteSettings(draggable);

                if (FlxG.mouse.wheel != 0) {
                    var maxScaleX:Float = FlxG.width / draggable.sprite.frameWidth;
                    var maxScaleY:Float = FlxG.height / draggable.sprite.frameHeight;

                    // Store original center coordinates
                    var centerX = draggable.sprite.x + draggable.sprite.width / 2;
                    var centerY = draggable.sprite.y + draggable.sprite.height / 2;

                    var scaleChange = FlxG.mouse.wheel > 0 ? 0.1 : -0.1;

                    if (FlxG.keys.pressed.CONTROL) draggable.sprite.scale.x = Math.min(Math.round((draggable.sprite.scale.x + scaleChange) * 10) / 10, maxScaleX);
                    else if (FlxG.keys.pressed.SHIFT) draggable.sprite.scale.y = Math.min(Math.round((draggable.sprite.scale.y + scaleChange) * 10) / 10, maxScaleY);
                    else {
                        draggable.sprite.scale.x = Math.min(
                            Math.round((draggable.sprite.scale.x + scaleChange) * 10) / 10,
                            maxScaleX
                        );
                        draggable.sprite.scale.y = Math.min(
                            Math.round((draggable.sprite.scale.y + scaleChange) * 10) / 10,
                            maxScaleY
                        );
                    }
                    draggable.sprite.updateHitbox();

                    // Reposition to maintain center
                    draggable.sprite.setPosition(centerX - draggable.sprite.width / 2, centerY - draggable.sprite.height / 2);

                    // Scale linked/combo sprites together
                    if (draggable.spriteType == "combo") {
                        for (i in 1...comboSprites.length) {
                            var comboSprite = comboSprites[i];
                            var originalWidth = comboSprite.width;
                            // Apply the same scaling
                            if (FlxG.keys.pressed.CONTROL) comboSprite.scale.x = draggable.sprite.scale.x;
                            else if (FlxG.keys.pressed.SHIFT) comboSprite.scale.y = draggable.sprite.scale.y;
                            else {
                                comboSprite.scale.x = draggable.sprite.scale.x;
                                comboSprite.scale.y = draggable.sprite.scale.y;
                            }

                            // Store original center
                            var comboCenterX = comboSprite.x + comboSprite.width / 2;
                            var comboCenterY = comboSprite.y + comboSprite.height / 2;

                            comboSprite.updateHitbox();

                            // Reposition to maintain center
                            comboSprite.x = comboCenterX - comboSprite.width / 2 + ((originalWidth - comboSprite.width) * i);
                            comboSprite.y = comboCenterY - comboSprite.height / 2;
                        }
                    }
                    if (draggable.linkedSprites != null && draggable.linkedSprites.length > 0) {
                        for (linked in draggable.linkedSprites) {
                            linked.sprite.scale = draggable.sprite.scale;
                            linked.sprite.updateHitbox();
                            linked.sprite.setPosition(draggable.sprite.x + (draggable.sprite.width / 2) - (linked.sprite.width / 2), draggable.sprite.y + (draggable.sprite.height / 2) - (linked.sprite.height / 2));
                        }
                    }

                    saveSpriteSettings(draggable);
                } else {
                    if (draggable.linkedSprites != null && draggable.linkedSprites.length > 0) {
                        for (linked in draggable.linkedSprites) {
                            linked.sprite.setPosition(draggable.sprite.x + (draggable.sprite.width / 2) - (linked.sprite.width / 2), draggable.sprite.y + (draggable.sprite.height / 2) - (linked.sprite.height / 2));
                        }
                    }
                }

                updateText(draggable);
            }

            if (draggable.isSelected || draggable.isDragging) updateHighlight(draggable);
        }

        handleCursor(hoveredSprite);

        if (FlxG.keys.justPressed.F1 && toolboxWindow.hidden) initToolbox();

        // Exit to OptionsState (Doesn't work with Pause Options)
        if (controls.BACK) FlxG.switchState(() -> new OptionsState());

        super.update(elapsed);
    }

    // Init
    function initStrumline() {
        if (playerStrumline != null) remove(playerStrumline);
        playerStrumline = new Strumline(noteStyle, true);
        playerStrumline.y = Preferences.downscroll ? FlxG.height - playerStrumline.height - Constants.STRUMLINE_Y_OFFSET : Constants.STRUMLINE_Y_OFFSET;
        if (badOptions.middlescroll) playerStrumline.screenCenter(0x01);
        else playerStrumline.x = FlxG.width / 2 + Constants.STRUMLINE_X_OFFSET;
        add(playerStrumline);

        if (badOptions.opponentNoteOpacity > 0) {
            if (opponentStrumline != null) remove(opponentStrumline);
            opponentStrumline = new Strumline(noteStyle, true);
            opponentStrumline.x = Constants.STRUMLINE_X_OFFSET;
            opponentStrumline.y = Preferences.downscroll ? FlxG.height - opponentStrumline.height - Constants.STRUMLINE_Y_OFFSET : Constants.STRUMLINE_Y_OFFSET;
            opponentStrumline.alpha = badOptions.opponentNoteOpacity / 100;
            if (badOptions.middlescroll) {
                var rightXOffset = badOptions.healthBar ? Constants.STRUMLINE_X_OFFSET : 150;
                for (i in 2...4) {
                    var note = opponentStrumline.strumlineNotes.members[i];
                    note.x = FlxG.width - opponentStrumline.width + rightXOffset + Strumline.NOTE_SPACING * (i - 2);
                }
            }
            add(opponentStrumline);
        }
    }

    function initDraggableSprites() {
        ratingsPopUps = ScriptedFlxSpriteGroup.init("RatingPopUps");
        ratingsPopUps.scriptSet("noteStyle", noteStyle);
        ratingsPopUps.zIndex = 900;
        add(ratingsPopUps);

        var judgementSprite:FunkinSprite = ratingsPopUps.scriptCall("initJudgementSprite", ["sick"]);
        addDraggableSprite(judgementSprite, "judgement");

        for (sprite in comboSprites) if (sprite != null) remove(sprite);
        comboSprites = [];

        for (i in 0...3) {
            var comboSprite = ratingsPopUps.scriptCall("initComboSprite", [3 - i, i]);
            if (comboSprite != null) {
                comboSprites.push(comboSprite);
                if (i == 0) addDraggableSprite(comboSprite, "combo");
            }
        }

        var healthBarBG:FunkinSprite = initHealthBarSprite();
    }

    function initHealthBarSprite():FunkinSprite {
        var healthBarBG:FunkinSprite = new FunkinSprite();
        healthBarBG.loadTexture("healthBar");
        var healthBarSettings = Save.instance.modOptions.get("healthBarSettings");
        if (healthBarSettings != null) {
            healthBarBG.angle = healthBarSettings[4];
            healthBarBG.scale.x = healthBarSettings[2];
            healthBarBG.scale.y = healthBarSettings[3];
            healthBarBG.updateHitbox();
            healthBarBG.setPosition(healthBarSettings[0] - healthBarBG.width / 2, healthBarSettings[1] - healthBarBG.height / 2);
        } else {
            healthBarBG.height = Preferences.downscroll ? FlxG.height * 0.1 : FlxG.height * 0.9;
        }
        healthBarBG.zIndex = 800;
        add(healthBarBG);

        var draggableHealthBar = addDraggableSprite(healthBarBG, "healthBar");

        var healthBar:FlxBar = new FlxBar(0, 0, FlxBarFillDirection.RIGHT_TO_LEFT, Std.int(healthBarBG.width - 8));
        healthBar.createFilledBar(Constants.COLOR_HEALTH_BAR_RED, Constants.COLOR_HEALTH_BAR_GREEN);
        healthBar.percent = 50;
        healthBar.zIndex = 801;
        add(healthBar);
        linkSpriteToTarget(draggableHealthBar, healthBar);

        return healthBarBG;
    }

    function initToolbox() {
        WindowManager.instance.reset();

        toolboxWindow = new Window();
        toolboxWindow.width = 420;
        toolboxWindow.height = 400;
        toolboxWindow.x = 10;
        toolboxWindow.y = (FlxG.height - toolboxWindow.height) / 2;
        toolboxWindow.title = "HUD Manager Guide";
        toolboxWindow.maximizable = false;
        toolboxWindow.maximized = true;

        toolboxWindow.onMouseOver = (event:MouseEvent) -> {
            isOverToolbox = true;
            Cursor.cursorMode = CursorMode.Default;
        }
        toolboxWindow.onMouseOut = (event:MouseEvent) -> isOverToolbox = false;

        var keybindsTable:TableView = new TableView();
        keybindsTable.id = "keybindsTable";
        keybindsTable.percentWidth = 100;
        keybindsTable.height = 196;

        // Add Columns
        var actionColumn = keybindsTable.addColumn("Action");
        actionColumn.percentWidth = 50;
        actionColumn.id = "action";
        var keybindColumn = keybindsTable.addColumn("Keybind");
        keybindColumn.percentWidth = 50;
        keybindColumn.id = "keybind";

        var header = keybindsTable.header;
        if (header != null) header.percentWidth = 100;

        keybindsTable.value = populateKeybindsTable(keybindsTable);

        var noteStyleBox = new HBox();
        noteStyleBox.percentWidth = 100;

        var label = new Label();
        label.text = "Note Style:";
        label.percentWidth = 20;
        label.verticalAlign = "center";
        label.textAlign = "right";

        var noteStyleList:DropDown = new DropDown();
        noteStyleList.id = "noteStyleList";
        noteStyleList.value = ChartEditorDropdowns.populateDropdownWithNoteStyles(noteStyleList, noteStyle.id);
        noteStyleList.percentWidth = 80;
        noteStyleList.searchable = true;
        // Change NoteStyle
        noteStyleList.onChange = (event:UIEvent) -> {
            if (event.data?.id == null) return;
            noteStyle = NoteStyleRegistry.instance.fetchEntry(event.data.id);
            initStrumline();
            remove(ratingsPopUps);
            for (draggable in draggableSprites) {
                remove(draggable.sprite);
                for (linked in draggable.linkedSprites) remove(linked.sprite);
            }
            draggableSprites = [];
            initDraggableSprites();
        }

        noteStyleBox.addComponent(label);
        noteStyleBox.addComponent(noteStyleList);

        var checkboxBox = new HBox();
        checkboxBox.percentWidth = 100;

        var oppNotes:CheckBox = new CheckBox();
        oppNotes.text = "Enable Opponent Strumline";
        oppNotes.selected = true;
        oppNotes.percentWidth = 50;
        oppNotes.onChange = (event:UIEvent) -> opponentStrumline.visible = oppNotes.selected;

        var playerNotes:CheckBox = new CheckBox();
        playerNotes.text = "Enable Player Strumline";
        playerNotes.selected = true;
        playerNotes.percentWidth = 50;
        playerNotes.onChange = (event:UIEvent) -> playerStrumline.visible = playerNotes.selected;

        checkboxBox.addComponent(oppNotes);
        checkboxBox.addComponent(playerNotes);

        toolboxWindow.addComponent(keybindsTable);
        toolboxWindow.addComponent(noteStyleBox);
        toolboxWindow.addComponent(checkboxBox);

        WindowManager.instance.addWindow(toolboxWindow);
    }

    // Helper Methods
    function isPointInsideRotatedSprite(pointX:Float, pointY:Float, sprite:FlxSprite):Bool {
        // Get the sprite's center
        var centerX:Float = sprite.x + sprite.width / 2;
        var centerY:Float = sprite.y + sprite.height / 2;

        // If sprite isn't rotated, use simple bounding box check
        if (sprite.angle % 360 == 0) {
            return pointX >= sprite.x &&
            pointX <= sprite.x + sprite.width &&
            pointY >= sprite.y &&
            pointY <= sprite.y + sprite.height;
        }

        // Calculate the four corners of the sprite
        var halfWidth:Float = sprite.width / 2;
        var halfHeight:Float = sprite.height / 2;

        // Get rotation in radians
        var angleRad:Float = sprite.angle * Math.PI / 180;
        var cos:Float = Math.cos(angleRad);
        var sin:Float = Math.sin(angleRad);

        // Calculate corner positions (relative to center)
        var corners:Array<{x:Float, y:Float}> = [
            { x: -halfWidth, y: -halfHeight }, // Top-left
            { x: halfWidth, y: -halfHeight }, // Top-right
            { x: halfWidth, y: halfHeight }, // Bottom-right
            { x: -halfWidth, y: halfHeight } // Bottom-left
        ];

        // Rotate corners and translate to world position
        for (i in 0...corners.length) {
            var rotX:Float = corners[i].x * cos - corners[i].y * sin;
            var rotY:Float = corners[i].x * sin + corners[i].y * cos;
            corners[i].x = rotX + centerX;
            corners[i].y = rotY + centerY;
        }

        // Check if point is inside the rotated rectangle using point-in-polygon test
        return isPointInPolygon(pointX, pointY, corners);
    }

    function isPointInPolygon(pointX:Float, pointY:Float, vertices:Array<{x:Float, y:Float}>):Bool {
        var inside:Bool = false;
        var j:Int = vertices.length - 1;

        for (i in 0...vertices.length) {
            if (((vertices[i].y > pointY) != (vertices[j].y > pointY)) &&
            (pointX < (vertices[j].x - vertices[i].x) * (pointY - vertices[i].y) /
            (vertices[j].y - vertices[i].y) + vertices[i].x)) {
                inside = !inside;
            }
            j = i;
        }

        return inside;
    }

    function getRotatedCorners(sprite:FlxSprite):Array<{x:Float, y:Float}> {
        var centerX = sprite.x + sprite.width / 2;
        var centerY = sprite.y + sprite.height / 2;
        var halfWidth = sprite.width / 2;
        var halfHeight = sprite.height / 2;

        // Get rotation in radians
        var angleRad = sprite.angle * Math.PI / 180;
        var cos = Math.cos(angleRad);
        var sin = Math.sin(angleRad);

        // Calculate corner positions (relative to center)
        var corners:Array<{x:Float, y:Float}> = [
            { x: -halfWidth, y: -halfHeight }, // Top-left
            { x: halfWidth, y: -halfHeight }, // Top-right
            { x: halfWidth, y: halfHeight }, // Bottom-right
            { x: -halfWidth, y: halfHeight } // Bottom-left
        ];

        // Rotate corners and translate to world position
        for (i in 0...corners.length) {
            var rotX = corners[i].x * cos - corners[i].y * sin;
            var rotY = corners[i].x * sin + corners[i].y * cos;
            corners[i].x = rotX + centerX;
            corners[i].y = rotY + centerY;
        }

        return corners;
    }

    function updateHighlight(selectedSprite:DraggableSprite) {
        if (selectedSprite != null) {
            updateHighlightOutline(selectedSprite.sprite);
            highlightOutline.visible = true;
        } else highlightOutline.visible = false;
    }

    function updateHighlightOutline(sprite:FlxSprite) {
        var padding = 2;
        var width = Std.int(sprite.width + padding * 2);
        var height = Std.int(sprite.height + padding * 2);

        // Only remake the graphic if the size has changed
        if (highlightOutline.width != width || highlightOutline.height != height) {
            highlightOutline.makeGraphic(width, height, 0x00000000);

            var lineThickness:Int = 2;
            var highlightColor:Int = 0xFF339933;

            // Draw border lines
            var outline = highlightOutline.pixels;
            outline.lock();

            // Top and bottom lines
            for (i in 0...width) {
                for (t in 0...lineThickness) {
                    outline.setPixel32(i, t, highlightColor);
                    outline.setPixel32(i, height - 1 - t, highlightColor);
                }
            }

            // Left and right lines
            for (i in 0...height) {
                for (t in 0...lineThickness) {
                    outline.setPixel32(t, i, highlightColor);
                    outline.setPixel32(width - 1 - t, i, highlightColor);
                }
            }

            outline.unlock();
            highlightOutline.dirty = true;
        }

        // Get sprite center coordinates
        var spriteCenterX = sprite.x + sprite.width / 2;
        var spriteCenterY = sprite.y + sprite.height / 2;

        // Position the highlight from center
        highlightOutline.x = spriteCenterX - highlightOutline.width / 2;
        highlightOutline.y = spriteCenterY - highlightOutline.height / 2;
        highlightOutline.angle = sprite.angle;

        highlightOutline.origin.set(highlightOutline.width / 2, highlightOutline.height / 2);
    }

    function handleCursor(hoveredSprite) {
        // Mouse sounds
        if (Cursor.cursorMode != CursorMode.Default || isOverToolbox) {
            if (FlxG.mouse.justPressed) FunkinSound.playOnce(Paths.sound("chartingSounds/ClickDown"));
            if (FlxG.mouse.justReleased) FunkinSound.playOnce(Paths.sound("chartingSounds/ClickUp"));
        }

        // Switch Sprites
        if (hoveredSprite != null) Cursor.cursorMode = hoveredSprite.isDragging ? CursorMode.Grabbing : CursorMode.Pointer;
        else Cursor.cursorMode = CursorMode.Default;
    }

    function addDraggableSprite(sprite:FunkinSprite, type:String):DraggableSprite {
        var draggable:DraggableSprite = {
            sprite: sprite,
            isDragging: false,
            isSelected: false,
            dragOffsetX: 0,
            dragOffsetY: 0,
            spriteType: type,
            linkedSprites: []
        };

        draggableSprites.push(draggable);
        return draggable;
    }

    function linkSpriteToTarget(targetDraggable:DraggableSprite, sprite:FlxSprite) {
        // Calculate initial offset
        sprite.angle = targetDraggable.sprite.angle;
        sprite.scale = targetDraggable.sprite.scale;
        sprite.updateHitbox();

        var targetCenterX = targetDraggable.sprite.x + targetDraggable.sprite.width / 2;
        var targetCenterY = targetDraggable.sprite.y + targetDraggable.sprite.height / 2;
        sprite.setPosition(targetCenterX - sprite.width / 2, targetCenterY - sprite.height / 2);

        var offsetX = sprite.x - targetDraggable.sprite.x;
        var offsetY = sprite.y - targetDraggable.sprite.y;
        targetDraggable.linkedSprites.push({
            sprite: sprite,
            offsetX: offsetX,
            offsetY: offsetY
        });
    }

    function updateText(draggable:DraggableSprite) {
        if (spriteSettingsText != null) spriteSettingsText.text = "Offsets: " + draggable.sprite.getPosition() + "\nScale: " + draggable.sprite.scale + "\nRotation: " + draggable.sprite.angle;
    }

    function saveSpriteSettings(draggable:DraggableSprite) {
        var originalScaleX = draggable.spriteType == "judgement" ? noteStyle.buildJudgementSprite("sick").scale.x : draggable.spriteType == "combo" ? noteStyle.buildComboNumSprite(0).scale.x : 0;
        var originalScaleY = draggable.spriteType == "judgement" ? noteStyle.buildJudgementSprite("sick").scale.y : draggable.spriteType == "combo" ? noteStyle.buildComboNumSprite(0).scale.y : 0;

        var settingsKey = (draggable.spriteType == "judgement") ? "judgementSettings" :
        (draggable.spriteType == "combo") ? "comboSettings" :
        (draggable.spriteType == "healthBar") ? "healthBarSettings" : null;
        if (settingsKey != null) Save.instance.modOptions.set(settingsKey, [
            Std.int(draggable.sprite.x + draggable.sprite.width / 2), Std.int(draggable.sprite.y + draggable.sprite.height / 2),
            draggable.sprite.scale.x - originalScaleX, draggable.sprite.scale.y - originalScaleY,
            draggable.sprite.angle]);
    }

    function populateKeybindsTable(tableView:TableView):Array<KeybindEntry> {
        tableView.dataSource.clear();
        var keybinds:Array<KeybindEntry> = [
            {action: "Show Guide", keybind: "F1"},
            {action: "Return to Options", keybind: "BACK/F5"},
            {action: "Drag Sprite", keybind: "Right Mouse Button"},
            {action: "Rotate Sprite", keybind: "Alt + Right Mouse Button"},
            {action: "Precise Sprite Movement", keybind: "W/A/S/D (+ 10) \nCtrl + W/A/S/D (+ 0.5)\nShift + W/A/S/D (+ 0.25)"},
            {action: "Precise Sprite Scaling", keybind: "Mouse Wheel (-/+ 0.1) \nCtrl + Mouse Wheel (-/+ 0.1 y-axis)\nShift + W/A/S/D (-/+ 0.1 x-axis)"},
        ];

        for (keybind in keybinds) tableView.dataSource.add(keybind);
        return keybinds;
    }

    function setupWelcomeMusic() {
        if (FlxG.sound.music != null) FlxG.sound.music.pause();
        var pauseState:PauseSubState = ModuleHandler.getModule("PauseOptions").scriptGet("pauseState");
        if (pauseState != null) pauseState.pauseMusic.pause();
        welcomeMusic = FunkinSound.load(Paths.music("chartEditorLoop/chartEditorLoop"), true, true);
        welcomeMusic.play(false, FlxG.random.int(0, Std.int(welcomeMusic.length / 2)));
    }

    // Cleanup
    override function close() {
        cleanup();
        super.close();
    }

    override function destroy() {
        cleanup();
        super.destroy();
    }

    function cleanup() {
        Cursor.hide();
        if (welcomeMusic != null) welcomeMusic.destroy();
        if (FlxG.sound.music != null) FlxG.sound.music.resume();
        FlxG.state.persistentUpdate = prevPersistentUpdate;
    }
}

typedef DraggableSprite = {
    sprite:FunkinSprite,
    isDragging:Bool,
    isSelected:Bool,
    dragOffsetX:Float,
    dragOffsetY:Float,
    spriteType:String,
    linkedSprites:Array<{sprite:FlxSprite, offsetX:Float, offsetY:Float}>
}

typedef KeybindEntry = {
    action:String,
    keybind:String
}