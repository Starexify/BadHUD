package ui.options;

import funkin.Paths;
import funkin.Preferences;
import funkin.audio.FunkinSound;
import funkin.data.notestyle.NoteStyleRegistry;
import funkin.graphics.FunkinSprite;
import funkin.input.Cursor;
import funkin.input.CursorMode;
import funkin.modding.base.ScriptedMusicBeatSubState;
import funkin.modding.module.ModuleHandler;
import funkin.play.PauseSubState;
import funkin.play.notes.Strumline;
import funkin.play.notes.notestyle.NoteStyle;
import funkin.save.Save;
import funkin.ui.debug.charting.handlers.ChartEditorThemeHandler;
import funkin.ui.options.OptionsState;
import funkin.util.Constants;

import flixel.FlxG;
import flixel.FlxSprite;
import flixel.text.FlxText;
import flixel.text.FlxInputText;

class PositionsState extends ScriptedMusicBeatSubState {
    var badOptions:Null<BadSaveData> = Save.instance.modOptions.get("badOptions");

    var welcomeMusic:FunkinSound = new FunkinSound();
    var strumLine:Strumline;

    var noteStyle:NoteStyle;

    var draggableSprites:Array<DraggableSprite> = [];

    var spriteSettingsText:FlxText;

    var toolboxSprite:FunkinSprite;
    var toolboxTitleBar:FunkinSprite;
    var toolboxTitleText:FlxText;
    var toolboxContentText:FlxText;
    var toolboxCloseButton:FunkinSprite;
    var toolboxTextField:FlxInputText;
    var isToolboxVisible:Bool = false;
    var isToolboxDragging:Bool = false;
    var toolboxDragOffsetX:Float = 0;
    var toolboxDragOffsetY:Float = 0;

    // Prevet OptionsState update
    var prevPersistentUpdate:Bool;

    override function create() {
        super.create();

        prevPersistentUpdate = FlxG.state.persistentUpdate;
        FlxG.state.persistentUpdate = false;

        Cursor.show();
        setupWelcomeMusic();

        var menuBG = new FlxSprite().loadGraphic(Paths.image('menuDesat'));
        menuBG.setGraphicSize(Std.int(menuBG.width * 1.1));
        menuBG.updateHitbox();
        menuBG.screenCenter();
        menuBG.scrollFactor.set(0, 0);
        menuBG.color = ChartEditorThemeHandler.BACKGROUND_COLOR_DARK;
        add(menuBG);

        noteStyle = NoteStyleRegistry.instance.fetchEntry(Constants.DEFAULT_NOTE_STYLE);

        initStrumline();

        var helpText:FlxText = new FlxText(0, 0, 0, "Press BACK/ESC to return to Options").setFormat(Paths.font("vcr.ttf"), 20);
        helpText.x = FlxG.width - helpText.width - 10;
        helpText.y = helpText.height * 2;
        add(helpText);

        spriteSettingsText = new FlxText(10, FlxG.height * 0.9, 0).setFormat(Paths.font("vcr.ttf"), 20);
        spriteSettingsText.y -= spriteSettingsText.height;
        add(spriteSettingsText);

        initDraggableSprites();

        initToolboxSprite();
    }

    override function update(elapsed:Float) {
        var mouseX = FlxG.mouse.x;
        var mouseY = FlxG.mouse.y;
        var hoveredSprite = null;

        if (isToolboxVisible) {
            var isOverTitleBar = mouseX >= toolboxTitleBar.x &&
            mouseX <= toolboxTitleBar.x + toolboxTitleBar.width &&
            mouseY >= toolboxTitleBar.y &&
            mouseY <= toolboxTitleBar.y + toolboxTitleBar.height;

            if (isOverTitleBar && FlxG.mouse.justPressed) {
                isToolboxDragging = true;
                toolboxDragOffsetX = mouseX - toolboxSprite.x;
                toolboxDragOffsetY = mouseY - toolboxSprite.y;
            }

            if (isToolboxDragging) {
                if (FlxG.mouse.pressed) {
                    var newX = mouseX - toolboxDragOffsetX;
                    var newY = mouseY - toolboxDragOffsetY;

                    // Keep toolbox within screen bounds
                    newX = Math.max(0, Math.min(FlxG.width - toolboxSprite.width, newX));
                    newY = Math.max(0, Math.min(FlxG.height - toolboxSprite.height, newY));

                    // Move all toolbox elements
                    moveToolbox(newX, newY);
                } else {
                    isToolboxDragging = false;
                }
            }
        }

        if (!isToolboxDragging) {
            for (i in 0...draggableSprites.length) {
                var draggable = draggableSprites[draggableSprites.length - 1 - i];
                var sprite = draggable.sprite;

                var isMouseOver:Bool = mouseX >= sprite.x &&
                mouseX <= sprite.x + sprite.width &&
                mouseY >= sprite.y &&
                mouseY <= sprite.y + sprite.height;

                if (isMouseOver) {
                    hoveredSprite = draggable;
                    break;
                }
            }
        }

        if (hoveredSprite != null && FlxG.mouse.justPressed) {
            for (draggable in draggableSprites) { draggable.isSelected = false; draggable.isDragging = false; }
            hoveredSprite.isSelected = true;
            hoveredSprite.isDragging = true;
            hoveredSprite.dragOffsetX = mouseX - hoveredSprite.sprite.x;
            hoveredSprite.dragOffsetY = mouseY - hoveredSprite.sprite.y;
        }

        // Handling the sprite movement
        for (draggable in draggableSprites) {
            if (draggable.isDragging) {
                if (FlxG.mouse.pressed) {
                    if (FlxG.keys.pressed.ALT) {
                        var spriteMiddleX = draggable.sprite.x + draggable.sprite.width / 2;
                        var spriteMiddleY = draggable.sprite.y + draggable.sprite.height / 2;
                        var angle = Math.atan2(mouseY - spriteMiddleY, mouseX - spriteMiddleX) * 180 / Math.PI;
                        draggable.sprite.angle = Math.round(angle);
                    } else {
                        var newX = mouseX - draggable.dragOffsetX;
                        var newY = mouseY - draggable.dragOffsetY;

                        newX = Math.max(0, Math.min(FlxG.width - draggable.sprite.width, newX));
                        newY = Math.max(0, Math.min(FlxG.height - draggable.sprite.height, newY));

                        draggable.sprite.setPosition(newX, newY);
                    }
                    updateText(draggable);
                } else { // Mouse released
                    draggable.isDragging = false;
                    saveSpriteSettings(draggable);
                }
            } else if (draggable.isSelected) {
                var pressArray:Array<Bool> = [
                    controls.UI_LEFT_P,
                    controls.UI_DOWN_P,
                    controls.UI_UP_P,
                    controls.UI_RIGHT_P
                ];

                var holdArray:Array<Bool> = [
                    controls.UI_LEFT,
                    controls.UI_DOWN,
                    controls.UI_UP,
                    controls.UI_RIGHT
                ];

                var moveSpeed = 10;
                if (FlxG.keys.pressed.CONTROL) moveSpeed /= 2;
                else if (FlxG.keys.pressed.SHIFT) moveSpeed /= 4;
                var holdSpeed = 2;

                var newX = draggable.sprite.x;
                var newY = draggable.sprite.y;

                for (i in 0...pressArray.length) {
                    if (pressArray[i]) {
                        switch (i) {
                            case 0: newX -= moveSpeed; // Left
                            case 1: newY += moveSpeed; // Down
                            case 2: newY -= moveSpeed; // Up
                            case 3: newX += moveSpeed; // Right
                        }
                    } else if (holdArray[i]) {
                        switch (i) {
                            case 0: newX -= holdSpeed; // Left
                            case 1: newY += holdSpeed; // Down
                            case 2: newY -= holdSpeed; // Up
                            case 3: newX += holdSpeed; // Right
                        }
                    }
                }

                newX = Math.max(0, Math.min(FlxG.width - draggable.sprite.width, newX));
                newY = Math.max(0, Math.min(FlxG.height - draggable.sprite.height, newY));

                draggable.sprite.setPosition(newX, newY);

                if (controls.UI_DOWN_R || controls.UI_UP_R || controls.UI_LEFT_R || controls.UI_RIGHT_R) saveSpriteSettings(draggable);

                if (FlxG.mouse.wheel != 0) {
                    var maxScaleX:Float = FlxG.width / draggable.sprite.frameWidth;
                    var maxScaleY:Float = FlxG.height / draggable.sprite.frameHeight;

                    // Store original center coordinates
                    var centerX = draggable.sprite.x + draggable.sprite.width / 2;
                    var centerY = draggable.sprite.y + draggable.sprite.height / 2;

                    var scaleChange = FlxG.mouse.wheel > 0 ? 0.1 : -0.1;

                    if (FlxG.keys.pressed.CONTROL)
                        draggable.sprite.scale.x = Math.min(
                            Math.round((draggable.sprite.scale.x + scaleChange) * 10) / 10,
                            maxScaleX
                        );
                    else if (FlxG.keys.pressed.SHIFT)
                        draggable.sprite.scale.y = Math.min(
                            Math.round((draggable.sprite.scale.y + scaleChange) * 10) / 10,
                            maxScaleY
                        );
                    else {
                        draggable.sprite.scale.x = Math.min(
                            Math.round((draggable.sprite.scale.x + scaleChange) * 10) / 10,
                            maxScaleX
                        );
                        draggable.sprite.scale.y = Math.min(
                            Math.round((draggable.sprite.scale.y + scaleChange) * 10) / 10,
                            maxScaleY
                        );
                    }
                    draggable.sprite.updateHitbox();

                    // Reposition to maintain center
                    draggable.sprite.x = centerX - draggable.sprite.width / 2;
                    draggable.sprite.y = centerY - draggable.sprite.height / 2;

                    saveSpriteSettings(draggable);
                }
                updateText(draggable);
            }
        }

        if (FlxG.keys.justPressed.TAB && !isToolboxVisible) {
            showToolbox("BadHUD Toolbox",
            "Testing position has been saved.\nNoteStyle: "
            );
        }

        toolboxTextField.onTextChange.add((text, change) -> {
            if (change == "input") {
                var styleIds = NoteStyleRegistry.instance.listEntryIds();
                if (styleIds.contains(text)) {
                    noteStyle = NoteStyleRegistry.instance.fetchEntry(text);
                    // Reinit Sprites
                    initStrumline();
                    for (draggable in draggableSprites) remove(draggable.sprite);
                    draggableSprites = [];
                    initDraggableSprites();
                }
            }
        });

        handleToolbox();
        handleCursor(hoveredSprite);

        // Exit to OptionsState (Doesn't work with Pause Options)
        if (controls.BACK && !toolboxTextField.hasFocus) FlxG.switchState(() -> new OptionsState());

        super.update(elapsed);
    }

    // Inits
    function initStrumline() {
        if (strumLine != null) remove(strumLine);
        strumLine = new Strumline(noteStyle, true);
        strumLine.x = FlxG.width / 2 + Constants.STRUMLINE_X_OFFSET;
        strumLine.y = Preferences.downscroll ? FlxG.height - strumLine.height - Constants.STRUMLINE_Y_OFFSET : Constants.STRUMLINE_Y_OFFSET;
        if (badOptions.middlescroll) strumLine.screenCenter(0x01);
        add(strumLine);
    }

    function initDraggableSprites() {
        var judgementSprite = noteStyle.buildJudgementSprite("sick");
        var judgementSettings = Save.instance.modOptions.get("judgementSettings");
        if (judgementSettings != null) {
            var originalScaleX = judgementSprite.scale.x;
            var originalScaleY = judgementSprite.scale.y;
            judgementSprite.scale.set(originalScaleX + judgementSettings[2], originalScaleY + judgementSettings[3]);
            judgementSprite.angle = judgementSettings[4];
            judgementSprite.updateHitbox();
            judgementSprite.setPosition(judgementSettings[0] - judgementSprite.width / 2, judgementSettings[1] - judgementSprite.height / 2);
        } else {
            judgementSprite.x = (FlxG.width * 0.474);
            judgementSprite.x -= judgementSprite.width / 2;
            judgementSprite.y = (FlxG.camera.height * 0.45 - 60);
            judgementSprite.y -= judgementSprite.height / 2;
            var judgementSpriteOffsets = noteStyle.getJudgementSpriteOffsets("sick");
            judgementSprite.x += judgementSpriteOffsets[0];
            judgementSprite.y += judgementSpriteOffsets[1];
        }
        addDraggableSprite(judgementSprite, "judgement");
        add(judgementSprite);

        var comboSprite = noteStyle.buildComboNumSprite(0);
        var comboSettings = Save.instance.modOptions.get("comboSettings");
        if (comboSettings != null) {
            var originalScaleX = comboSprite.scale.x;
            var originalScaleY = comboSprite.scale.y;
            comboSprite.scale.set(originalScaleX + comboSettings[2], originalScaleY + comboSettings[3]);
            comboSprite.angle = comboSettings[4];
            comboSprite.updateHitbox();
            comboSprite.setPosition(comboSettings[0] - comboSprite.width / 2, comboSettings[1] - comboSprite.height / 2);
        } else {
            comboSprite.x = (FlxG.width * 0.507) - (36 * 1) - 65;
            comboSprite.y = (FlxG.camera.height * 0.44);
            var comboSpriteOffsets = noteStyle.getComboNumSpriteOffsets(0);
            comboSprite.x += comboSpriteOffsets[0];
            comboSprite.y += comboSpriteOffsets[1];
        }
        addDraggableSprite(comboSprite, "combo");
        add(comboSprite);
    }

    function initToolboxSprite() {
        // Main window container
        toolboxSprite = new FunkinSprite(0, 0);
        toolboxSprite.makeGraphic(300, 200, 0xFF2C2F30);
        toolboxSprite.screenCenter();
        toolboxSprite.visible = false;

        // Title bar
        toolboxTitleBar = new FunkinSprite(toolboxSprite.x + 100, toolboxSprite.y + 2);
        toolboxTitleBar.makeGraphic(294, 30, 0xFF3D3F41);
        toolboxTitleBar.visible = false;

        // Title text
        toolboxTitleText = new FlxText(toolboxTitleBar.x + 5, toolboxSprite.y + 5, 290, "");
        toolboxTitleText.setFormat(Paths.font("vcr.ttf"), 16, 0xFFFFFFFF, "left");
        toolboxTitleText.visible = false;

        // Content text
        toolboxContentText = new FlxText(toolboxSprite.x + 10, toolboxSprite.y + 40, 280, "");
        toolboxContentText.setFormat(Paths.font("vcr.ttf"), 14, 0xFFFFFFFF, "left");
        toolboxContentText.visible = false;

        // Text Field
        toolboxTextField = new FlxInputText(toolboxSprite.x + 10, toolboxSprite.y + 120, 280, "", 14, 0xFFFFFFFF, 0xFF000000);
        toolboxTextField.font = Paths.font("vcr.ttf");
        toolboxTextField.visible = false;

        // Close button
        toolboxCloseButton = new FunkinSprite(toolboxSprite.x + toolboxSprite.width - 25, toolboxSprite.y + 5);
        toolboxCloseButton.makeGraphic(20, 20, 0xFFFF4040);
        toolboxCloseButton.visible = false;

        add(toolboxSprite);
        add(toolboxTitleBar);
        add(toolboxTitleText);
        add(toolboxContentText);
        add(toolboxTextField);
        add(toolboxCloseButton);
    }

    // Toolbox Methods
    function handleToolbox() {
        if (isToolboxVisible) {
            // Check for close button click
            var mouseX = FlxG.mouse.x;
            var mouseY = FlxG.mouse.y;
            var isOverCloseButton = mouseX >= toolboxCloseButton.x &&
            mouseX <= toolboxCloseButton.x + toolboxCloseButton.width &&
            mouseY >= toolboxCloseButton.y &&
            mouseY <= toolboxCloseButton.y + toolboxCloseButton.height;

            if (isOverCloseButton) {
                toolboxCloseButton.color = 0xFFAA4040; // Highlight on hover

                if (FlxG.mouse.justPressed) {
                    closeToolbox();
                    FunkinSound.playOnce(Paths.sound("cancelMenu"));
                }
            } else {
                toolboxCloseButton.color = 0xFFFF4040; // Normal color
            }
        }
    }

    function moveToolbox(newX:Float, newY:Float) {
        toolboxSprite.setPosition(newX, newY);
        toolboxTitleBar.setPosition(newX, newY);
        toolboxTitleText.setPosition(newX + 5, newY + 5);
        toolboxContentText.setPosition(newX + 10, newY + 40);
        toolboxTextField.setPosition(newX + 10, newY + 120);
        toolboxCloseButton.setPosition(newX + toolboxSprite.width - 25, newY + 5);
    }

    function showToolbox(title:String, content:String) {
        toolboxTitleText.text = title;
        toolboxContentText.text = content;

        // Center the window
        toolboxSprite.screenCenter();
        toolboxTitleBar.setPosition(toolboxSprite.x + 3, toolboxSprite.y + 3);
        toolboxTitleText.setPosition(toolboxTitleBar.x + 5, toolboxSprite.y + 5);
        toolboxContentText.setPosition(toolboxSprite.x + 10, toolboxSprite.y + 40);
        toolboxTextField.setPosition(toolboxSprite.x + 10, toolboxSprite.y + 120);
        toolboxCloseButton.setPosition(toolboxSprite.x + toolboxSprite.width - 25, toolboxSprite.y + 5);

        // Make visible
        toolboxSprite.visible = true;
        toolboxTitleBar.visible = true;
        toolboxTitleText.visible = true;
        toolboxContentText.visible = true;
        toolboxTextField.visible = true;
        toolboxCloseButton.visible = true;

        isToolboxVisible = true;

        // Play sound
        FunkinSound.playOnce(Paths.sound("confirmMenu"));
    }

    function closeToolbox() {
        isToolboxVisible = false;
        toolboxSprite.visible = false;
        toolboxTitleBar.visible = false;
        toolboxTitleText.visible = false;
        toolboxContentText.visible = false;
        toolboxTextField.visible = false;
        toolboxCloseButton.visible = false;
        isToolboxDragging = false;
    }

    // Helper Methods
    function updateText(draggable:DraggableSprite) {
        if (spriteSettingsText != null) spriteSettingsText.text = "NoteSkin: " + noteStyle.id + "\nOffsets: " + draggable.sprite.getPosition() + "\nScale: " + draggable.sprite.scale + "\nRotation: " + draggable.sprite.angle;
    }

    function saveSpriteSettings(draggable:DraggableSprite) {
        var originalScaleX = draggable.spriteType == "judgement" ? noteStyle.buildJudgementSprite("sick").scale.x : noteStyle.buildComboNumSprite(0).scale.x;
        var originalScaleY = draggable.spriteType == "judgement" ? noteStyle.buildJudgementSprite("sick").scale.y : noteStyle.buildComboNumSprite(0).scale.y;
        var settingsKey = (draggable.spriteType == "judgement") ? "judgementSettings" : (draggable.spriteType == "combo") ? "comboSettings" : null;
        if (settingsKey != null) Save.instance.modOptions.set(settingsKey, [
            Std.int(draggable.sprite.x + draggable.sprite.width / 2),
            Std.int(draggable.sprite.y + draggable.sprite.height / 2),
            draggable.sprite.scale.x - originalScaleX,
            draggable.sprite.scale.y - originalScaleY,
            draggable.sprite.angle]);
    }

    function handleCursor(hoveredSprite) {
        // Mouse sounds
        if (Cursor.cursorMode != CursorMode.Default) {
            if (FlxG.mouse.justPressed) FunkinSound.playOnce(Paths.sound("chartingSounds/ClickDown"));
            if (FlxG.mouse.justReleased) FunkinSound.playOnce(Paths.sound("chartingSounds/ClickUp"));
            if (FlxG.mouse.justPressedRight) FunkinSound.playOnce(Paths.sound("chartingSounds/ClickDown"));
            if (FlxG.mouse.justReleasedRight) FunkinSound.playOnce(Paths.sound("chartingSounds/ClickUp"));
        }

        // Switch Sprites
        if (hoveredSprite != null) Cursor.cursorMode = hoveredSprite.isDragging ? CursorMode.Grabbing : CursorMode.Pointer;
        else Cursor.cursorMode = CursorMode.Default;
    }

    function setupWelcomeMusic() {
        if (FlxG.sound.music != null) FlxG.sound.music.pause();
        var pauseState:PauseSubState = ModuleHandler.getModule("PauseOptions").scriptGet("pauseState");
        if (pauseState != null) pauseState.pauseMusic.pause();
        welcomeMusic = FunkinSound.load(Paths.music('chartEditorLoop/chartEditorLoop'), true, true);
        welcomeMusic.play(false, FlxG.random.int(0, Std.int(welcomeMusic.length / 2)));
    }

    function addDraggableSprite(sprite:FunkinSprite, type:String) {
        draggableSprites.push({
            sprite: sprite,
            isDragging: false,
            isSelected: false,
            dragOffsetX: 0,
            dragOffsetY: 0,
            spriteType: type
        });
    }

    // Cleanup
    override function close() {
        cleanup();
        super.close();
    }

    override function destroy() {
        cleanup();
        super.destroy();
    }

    function cleanup() {
        Cursor.hide();
        if (welcomeMusic != null) welcomeMusic.destroy();
        if (FlxG.sound.music != null) FlxG.sound.music.resume();
        FlxG.state.persistentUpdate = prevPersistentUpdate;
    }
}

typedef DraggableSprite = {
    sprite:FunkinSprite,
    isDragging:Bool,
    isSelected:Bool,
    dragOffsetX:Float,
    dragOffsetY:Float,
    spriteType:String
}