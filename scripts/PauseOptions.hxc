import funkin.modding.base.ScriptedMusicBeatSubState;
import funkin.modding.events.ScriptEvent;
import funkin.modding.module.ScriptedModule;
import funkin.play.PauseSubState;
import funkin.play.PlayState;
import funkin.ui.debug.charting.ChartEditorState;
import funkin.ui.debug.latency.LatencyState;
import funkin.ui.options.OptionsState;
import funkin.util.ReflectUtil;

import flixel.FlxG;
import flixel.tweens.FlxEase;
import flixel.tweens.FlxTween;

import polymod.hscript._internal.PolymodScriptClass;

class PauseOptions extends ScriptedModule {
    var wasPaused:Bool = false;
    var isChartingState:Bool = false;
    var stateParams:PlayStateParams;
    var pauseState:PauseSubState;
    var currentSongId:String;

    function new() {
        super("PauseOptions");
    }

    override function onSongLoaded(event:SongLoadScriptEvent) {
        if (PlayState.instance == null) return;
        stateParams = PlayState.instance.lastParams;
        isChartingState = PlayState.instance.isChartingMode;
        currentSongId = PlayState.instance.currentSong.id;
    }

    override function onStateChangeEnd(event:StateChangeScriptEvent) {
        if (Std.isOfType(event.targetState, OptionsState)) {
            //DiscordClient.instance.setPresence({ state: "Setting up Options", details: null });
            // HUD Manager Entry
            var options:OptionsMenu = event.targetState.optionsCodex.get_currentPage();
            for (optionEntries in options.items.members) optionEntries.y -= 80;
            var exit = options.items.members[options.items.length - 1];
            exit.y += 110;
            options.items.remove(exit);
            var hudManager = options.items.createItem(0, (options.items.length - 1) * 100 + 20, "HUD MANAGER", "bold", () -> FlxG.state.openSubState(ScriptedMusicBeatSubState.init("ui.options.HUDManagerState")));
            hudManager.x = (FlxG.width - hudManager.width) / 2;
            options.items.add(exit);

            if (wasPaused && pauseState != null) pauseState.startPauseMusic();
        }
    }

    override function onSubStateOpenBegin(event:SubStateScriptEvent) {
        var state:PolymodScriptClass = event.targetState._asc;
        if (event.targetState != PlayState.instance && wasPaused && !Std.isOfType(event.targetState, LatencyState) && ReflectUtil.getAnonymousField(ReflectUtil.getAnonymousField(state, "_c"), "name") != "HUDManagerState") {
            if (isChartingState) {
                FlxG.switchState(() -> new ChartEditorState({ targetSongId: currentSongId }));
                wasPaused = false;
                isChartingState = false;
            } else {
                FlxG.switchState(() -> new PlayState(stateParams));
                wasPaused = false;
            }
        }
    }

    override function onSubStateOpenEnd(event:SubStateScriptEvent) {
        if (Std.isOfType(event.targetState, PauseSubState) && !PlayState.instance.isMinimalMode) {
            pauseState = event.targetState;
            var menuEntries = pauseState.currentMenuEntries;
            menuEntries.insert(menuEntries.length - 1, {
                text: "Options",
                callback: openOptionsCallback
            });

            pauseState.clearAndAddMenuEntries();
            pauseState.changeSelection();
        }
    }

    function openOptionsCallback() {
        wasPaused = true;
        if (pauseState == null) return;
        // Fade out animation
        var duration = 0.4;
        for (entry in pauseState.currentMenuEntries.copy()) {
            if (entry.sprite != null) {
                if (entry.text == "Options") FlxTween.tween(entry.sprite, { alpha: 0 }, duration, { ease: FlxEase.quadOut });
                else entry.sprite.visible = false;
            }
        }
        FlxG.camera.fade(0xFF000000, duration, false, () -> FlxG.switchState(() -> new OptionsState()));
    }
}