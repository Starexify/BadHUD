import funkin.Highscore;
import funkin.PlayerSettings;
import funkin.Preferences;
import funkin.data.notestyle.NoteStyleRegistry;
import funkin.graphics.FunkinSprite;
import funkin.input.PreciseInputManager;
import funkin.modding.base.ScriptedFlxSpriteGroup;
import funkin.modding.events.ScriptEvent;
import funkin.modding.module.ModuleHandler;
import funkin.modding.module.ScriptedModule;
import funkin.play.notes.Strumline;
import funkin.play.notes.notestyle.NoteStyle;
import funkin.play.PauseSubState;
import funkin.play.PlayState;
import funkin.ui.debug.charting.ChartEditorState;
import funkin.util.Constants;
import funkin.util.InputUtil;
import funkin.save.Save;

import flixel.FlxG;
import flixel.text.FlxText;
import flixel.text.FlxTextBorderStyle;
import flixel.tweens.FlxEase;
import flixel.tweens.FlxTween;

import openfl.display.BitmapData;

import haxe.Exception;

import StringTools;

class ExtraStrumline extends ScriptedModule {
    var badOptions:Null<BadSaveData> = Save.instance.modOptions.get("badOptions");
    var state:PlayState;

    var laneUnderlay:FunkinSprite;
    var oppLaneUnderlay:FunkinSprite;
    var leftGradient:FunkinSprite;
    var rightGradient:FunkinSprite;
    var underlaySprites:Array<FunkinSprite>;

    var keybindTexts:Array<FlxText> = [];

    var ratingsPopUps:RatingPopUps;
    var noteStyle:NoteStyle;

    var noteScaling = 0.5;

    function new() {
        super("ExtraStrumline", 3);
    }

    override function onSongLoaded(event:SongLoadScriptEvent) {
        var badHooks:ScriptedModule = ModuleHandler.getModule("BadHooks");
        if (badHooks != null) state = badHooks.scriptGet("state");
        if (state == null) return;
        noteStyle = NoteStyleRegistry.instance.fetchEntry(state.currentChart.noteStyle);
        if (noteStyle == null) noteStyle = NoteStyleRegistry.instance.fetchDefault();

        // Center player strumline
        if (badOptions.middlescroll && new BadHooks().strumlineExcluded.indexOf(state.currentChart.songName) == -1) {
            state.playerStrumline.x = FlxG.width / 2 - state.playerStrumline.width / 2;
            placeOpponentNotes(state.opponentStrumline);
        }

        if (badOptions.opponentNoteOpacity > 0) state.opponentStrumline.alpha = badOptions.opponentNoteOpacity / 100;
        else state.opponentStrumline.visible = false;

        // Note Underlay
        if (Preferences.strumlineBackgroundOpacity > 0) {
            state.playerStrumline.background.visible = false;
            laneUnderlay = new FunkinSprite(state.playerStrumline.x - Strumline.BACKGROUND_PAD).makeSolidColor(Std.int(state.playerStrumline.width + Strumline.BACKGROUND_PAD * 2), FlxG.height, Std.parseInt("0xFF" + (badOptions.strumBgColor == 0 ? "000000" : StringTools.hex(badOptions.strumBgColor))));
            laneUnderlay.alpha = Preferences.strumlineBackgroundOpacity / 100;
            var fadeRegionWidth = Std.int(state.playerStrumline.width * 0.04);
            leftGradient = createGradient(fadeRegionWidth, FlxG.height * 2, 0, Preferences.strumlineBackgroundOpacity / 100, true);
            leftGradient.x = laneUnderlay.x - fadeRegionWidth;

            rightGradient = createGradient(fadeRegionWidth, FlxG.height * 2, 0, Preferences.strumlineBackgroundOpacity / 100, false);
            rightGradient.x = laneUnderlay.x + laneUnderlay.width;

            underlaySprites = [laneUnderlay, leftGradient, rightGradient];
            for (sprite in underlaySprites) {
                sprite.scrollFactor.set();
                sprite.zIndex = -1;
                sprite.camera = state.camHUD;
                state.add(sprite);
            }
        }

        // Replace Rating PopUps
        state.remove(state.comboPopUps);
        ratingsPopUps = ScriptedFlxSpriteGroup.init("RatingPopUps");
        ratingsPopUps.scriptSet("noteStyle", noteStyle);
        ratingsPopUps.camera = state.camHUD;
        ratingsPopUps.zIndex = 900;
        state.add(ratingsPopUps);

        // Remind Keybinds
        if (badOptions.remindKeys) {
            var noteHeigth:Int;
            for (staticNote in state.playerStrumline.strumlineNotes.members) {
                var keyArray = PreciseInputManager.getKeysForDirection(PlayerSettings.player1.controls, staticNote.direction);
                var keyName = InputUtil.getKeyName(keyArray[0]);
                var keybindText = new FlxText(staticNote.x, staticNote.y, staticNote.width, keyName);
                keybindText.y = staticNote.y + staticNote.height / 2 - keybindText.height * staticNote.scale.y;
                keybindText.setFormat(Paths.font(badOptions.hudFont), 32, 0xFFFFFFFF, "center", FlxTextBorderStyle.OUTLINE_FAST, 0xFF000000);
                keybindText.alpha = 0;
                keybindText.camera = state.camHUD;
                state.add(keybindText);
                keybindTexts.push(keybindText);
                noteHeigth = Std.int(staticNote.height);
            }
            fadeInKeybinds(noteHeigth);
        }

        state.opponentStrumline.background.visible = false;
        if (badOptions.middlescroll && !badOptions.oppMiddlescroll) {
            oppLaneUnderlay = new FunkinSprite();
            if (badOptions.middlescroll) {
                oppLaneUnderlay.x = state.opponentStrumline.x + (state.opponentStrumline.width / 4 - Strumline.NOTE_SPACING / 4) * noteScaling - Strumline.BACKGROUND_PAD * noteScaling;
                oppLaneUnderlay.makeSolidColor(Std.int(state.opponentStrumline.width * noteScaling + (Strumline.BACKGROUND_PAD * noteScaling) * 2), FlxG.height, Std.parseInt("0xFF" + (badOptions.strumBgColor == 0 ? "000000" : StringTools.hex(badOptions.strumBgColor))));
            } else {
                oppLaneUnderlay.x = state.opponentStrumline.x - Strumline.BACKGROUND_PAD;
                oppLaneUnderlay.makeSolidColor(Std.int(state.opponentStrumline.width + Strumline.BACKGROUND_PAD * 2), FlxG.height, Std.parseInt("0xFF" + (badOptions.strumBgColor == 0 ? "000000" : StringTools.hex(badOptions.strumBgColor))));
            }
            oppLaneUnderlay.alpha = Preferences.strumlineBackgroundOpacity / 100;
            oppLaneUnderlay.scrollFactor.set();
            oppLaneUnderlay.zIndex = -1;
            oppLaneUnderlay.camera = state.camHUD;
            state.add(oppLaneUnderlay);
        }
    }

    override function onUpdate(event:UpdateScriptEvent) {
        if (state == null || badOptions.opponentNoteOpacity <= 0) return;
        try {
            if ((state.currentStage != null && new BadHooks().strumlineExcluded.indexOf(state.currentChart.songName) == -1) || state.isMinimalMode) updateOpponentNotes();
        }
        catch (e:Exception) throw trace("[BadHUD] " + e);
    }

    override function onNoteHit(event:HitNoteScriptEvent) { if (state != null && !Std.isOfType(event.targetState, ChartEditorState) && event.note.noteData.getMustHitNote()) popUpRatings(event.judgement); }

    override function onNoteMiss(event:NoteScriptEvent) { event.playSound = !badOptions.muteMiss; }

    override function onNoteGhostMiss(event:GhostMissNoteScriptEvent) { event.playSound = !badOptions.muteMiss; }

    // Gradient Underlay
    function createGradient(width:Int, height:Int, alphaStart:Float, alphaEnd:Float, isLeftToRight:Bool = true):FunkinSprite {
        var gradientSprite = new FunkinSprite();
        var bitmap = new BitmapData(2, 1, true, 0x0);

        var leftAlpha = isLeftToRight ? alphaStart : alphaEnd;
        leftAlpha = Math.max(0, Math.min(leftAlpha, 1));
        var leftColor = (Std.int(leftAlpha * 255) << 24) | Std.parseInt(badOptions.strumBgColor);

        var rightAlpha = isLeftToRight ? alphaEnd : alphaStart;
        rightAlpha = Math.max(0, Math.min(rightAlpha, 1));
        var rightColor = (Std.int(rightAlpha * 255) << 24) | Std.parseInt(badOptions.strumBgColor);

        bitmap.setPixel32(0, 0, leftColor);
        bitmap.setPixel32(1, 0, rightColor);

        gradientSprite.loadBitmapData(bitmap, false);

        gradientSprite.scale.set(width / 2, height);
        gradientSprite.updateHitbox();

        return gradientSprite;
    }

    // Helper Methods
    function popUpRatings(judgement:String, ?combo:Int) {
        if (judgement == "miss" || badOptions.popUpType == "off" || ratingsPopUps == null) return;
        ratingsPopUps.scriptCall("displayJudgement", [judgement]);

        if (combo == null) combo = Highscore.tallies.combo;
        if (combo >= 10) ratingsPopUps.scriptCall("displayCombo", [combo]);
    }

    function updateOpponentNotes() {
        // Transparent Opponent Strumline
        for (note in state.opponentStrumline.strumlineNotes.members) note.alpha = badOptions.opponentNoteOpacity / 100;

        // Incoming Notes
        for (note in state.opponentStrumline.notes.members) {
            if (note == null || !note.alive) continue;
            if (badOptions.middlescroll && !badOptions.oppMiddlescroll) note.scale.set(noteStyle.getNoteScale() - noteStyle.getNoteScale() * noteScaling, noteStyle.getNoteScale() - noteStyle.getNoteScale() * noteScaling);
            note.x = state.opponentStrumline.strumlineNotes.members[note.direction].x + (state.opponentStrumline.strumlineNotes.members[note.direction].width - note.width) * 0.5;
            note.alpha = badOptions.opponentNoteOpacity / 100;
        }

        // Hold Notes
        for (note in state.opponentStrumline.holdNotes.members) {
            if (note == null || !note.alive) continue;
            if (badOptions.middlescroll && !badOptions.oppMiddlescroll) note.scale.set(noteStyle.getNoteScale() - noteStyle.getNoteScale() * noteScaling, noteStyle.getNoteScale() - noteStyle.getNoteScale() * noteScaling);
            note.x = state.opponentStrumline.strumlineNotes.members[note.noteDirection].x + (state.opponentStrumline.strumlineNotes.members[note.noteDirection].width - note.width) * 0.5;
            note.alpha = badOptions.opponentNoteOpacity / 100;
        }

        // Hold Covers / Hold Splashes
        for (note in state.opponentStrumline.noteHoldCovers.members) {
            if (note == null || !note.alive) continue;
            if (badOptions.middlescroll && !badOptions.oppMiddlescroll) note.scale.set(noteStyle.getNoteScale() - noteStyle.getNoteScale() * noteScaling, noteStyle.getNoteScale() - noteStyle.getNoteScale() * noteScaling);
            note.x = state.opponentStrumline.strumlineNotes.members[note.holdNote.noteDirection].x + (state.opponentStrumline.strumlineNotes.members[note.holdNote.noteDirection].width - note.width) * 0.5;
            note.alpha = badOptions.opponentNoteOpacity / 100;
        }
    }

    function fadeInKeybinds(noteHeight:Float) {
        var index = 0;
        for (text in keybindTexts) {
            var textYDirI = Preferences.downscroll ? text.y - noteHeight / 2 : text.y + noteHeight / 2;
            var textYDirII = Preferences.downscroll ? text.y + 20 : text.y - 20;
            FlxTween.tween(text, {y: textYDirI, alpha: 1}, 1, {
                ease: FlxEase.circOut,
                startDelay: 0.5 + (0.2 * index),
                onComplete: tween -> FlxTween.tween(text, {y: textYDirII, alpha: 0}, 0.8, {
                    ease: FlxEase.circIn,
                    onComplete: _ -> {
                        text.destroy();
                        state.remove(text);
                        keybindTexts = [];
                    }
                })
            });
            index++;
        }
    }

    function placeOpponentNotes(strumline:Strumline) {
        if (!badOptions.middlescroll || badOptions.opponentNoteOpacity <= 0) return;
        if (badOptions.oppMiddlescroll) {
            var rightXOffset = badOptions.healthBar ? Constants.STRUMLINE_X_OFFSET : 150;
            for (i in 2...4) strumline.strumlineNotes.members[i].x = FlxG.width - strumline.width + rightXOffset + Strumline.NOTE_SPACING * (i - 2);
        } else {
            strumline.scale.set(noteStyle.getNoteScale() - noteStyle.getNoteScale() * noteScaling, noteStyle.getNoteScale() - noteStyle.getNoteScale() * noteScaling);
            var yPos = Preferences.downscroll ? FlxG.height - 350 : 200;
            strumline.y = yPos;
            var noteSpacing = Strumline.NOTE_SPACING - Strumline.NOTE_SPACING * noteScaling;
            for (note in strumline.strumlineNotes.members) {
                FlxTween.cancelTweensOf(note);
                note.x = strumline.x;
                note.x += switch (note.direction % Strumline.KEY_COUNT) {
                    case 0: 0;
                    case 1: (1 * noteSpacing);
                    case 2: (2 * noteSpacing);
                    case 3: (3 * noteSpacing);
                    default: 0;
                };
                note.x -= ((note.width - Strumline.STRUMLINE_SIZE) / 2) * noteScaling;
                note.x -= Strumline.NUDGE * noteScaling;
                note.y -= 10;
                FlxTween.tween(note, {y: yPos, alpha: badOptions.opponentNoteOpacity / 100}, 1, {
                    ease: FlxEase.circOut, startDelay: 0.5 + (0.2 * note.direction),
                    onComplete: tween -> note.y = yPos
                });
            }
        }
    }

    // Cleanup Stuff
    override function onSubStateOpenBegin(event:SubStateScriptEvent) { if (!Std.isOfType(event.targetState, PlayState) && !Std.isOfType(event.targetState, PauseSubState)) cleanup(); }

    override function onSubStateCloseBegin(event:SubStateScriptEvent) { if (Std.isOfType(event.targetState, PlayState)) cleanup(); }

    override function onSongRetry(event:ScriptEvent) { cleanup(); }

    override function onSongEnd(event:ScriptEvent) { cleanup(); }

    override function onDestroy(event:ScriptEvent) { cleanup(); }

    function cleanup() {
        if (laneUnderlay != null) laneUnderlay.destroy();
        if (leftGradient != null) leftGradient.destroy();
        if (rightGradient != null) rightGradient.destroy();
        if (oppLaneUnderlay != null) oppLaneUnderlay.destroy();
        if (ratingsPopUps != null) ratingsPopUps.destroy();
        laneUnderlay = null;
        leftGradient = null;
        rightGradient = null;
        oppLaneUnderlay = null;
        ratingsPopUps = null;
    }
}