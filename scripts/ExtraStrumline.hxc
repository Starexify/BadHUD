import funkin.Highscore;
import funkin.PlayerSettings;
import funkin.Preferences;
import funkin.data.notestyle.NoteStyleRegistry;
import funkin.graphics.FunkinSprite;
import funkin.input.PreciseInputManager;
import funkin.modding.events.ScriptEvent;
import funkin.modding.module.ScriptedModule;
import funkin.play.PauseSubState;
import funkin.play.PlayState;
import funkin.play.notes.Strumline;
import funkin.play.notes.notestyle.NoteStyle;
import funkin.play.scoring.Scoring;
import funkin.save.Save;
import funkin.util.Constants;
import funkin.util.HostPlatform;
import funkin.util.InputUtil;
import funkin.util.PlatformUtil;

import flixel.FlxG;
import flixel.text.FlxText;
import flixel.text.FlxTextBorderStyle;
import flixel.tweens.FlxEase;
import flixel.tweens.FlxTween;

import openfl.display.BitmapData;

import haxe.Exception;

import StringTools;

class ExtraStrumline extends ScriptedModule {
    var badOptions:Null<BadSaveData> = Save.instance.modOptions.get("badOptions");
    var settings;

    var playState(get, never):PlayState;
    function get_playState():PlayState { return PlayState.instance; }

    var underlayWidth:Float;
    var laneUnderlay:FunkinSprite;
    var oppLaneUnderlay:FunkinSprite;
    var leftGradient:FunkinSprite;
    var rightGradient:FunkinSprite;
    var underlaySprites:Array<FunkinSprite> = [];

    var keybindTexts:Array<FlxText> = [];
    var hitDiffText:FlxText;
    var hitDiffTween:FlxTween;

    var ratingsPopUps:RatingPopUps;
    var noteStyle:NoteStyle;

    var noteScaling = 0.5;
    var STRUMLINE_DOWNSCROLL = 200;
    var STRUMLINE_UPSCROLL = -400;

    var PERFECT_COLOR:Int = 0xFFFFFFFF;
    var KILLER_COLOR:Int = 0xFF00FFFF;
    var SICK_COLOR:Int = 0xFF2DE356;
    var GOOD_COLOR:Int = 0xFFFFFF00;
    var BAD_COLOR:Int = 0xFFE6B72B;
    var SHIT_COLOR:Int = 0xFFDC3834;

    function new() {
        super("ExtraStrumline", 3);
    }

    override function onSongLoaded(event:SongLoadScriptEvent) {
        if (playState == null) return;
        noteStyle = NoteStyleRegistry.instance.fetchEntry(playState.currentChart.noteStyle);
        if (noteStyle == null) noteStyle = NoteStyleRegistry.instance.fetchDefault();

        // Center player strumline
        if (badOptions.middlescroll && !BadHooks.strumlineExcluded.contains(playState.currentChart.songName) && !FlxG.onMobile) {
            playState.playerStrumline.x = FlxG.width * 0.5 - playState.playerStrumline.width * 0.5;
            placeOpponentNotes(playState.opponentStrumline);
        }

        if (badOptions.opponentNoteOpacity > 0) playState.opponentStrumline.alpha = badOptions.opponentNoteOpacity / 100;
        else playState.opponentStrumline.visible = false;

        // Note Underlay
        if (Preferences.strumlineBackgroundOpacity > 0) {
            playState.playerStrumline.background.visible = false;

            underlayWidth = playState.playerStrumline.width + Strumline.BACKGROUND_PAD * 2;
            if (playState.playerStrumline.inArrowContorlSchemeMode && playState.playerStrumline.isPlayer) underlayWidth *= 1.05;

            laneUnderlay = new FunkinSprite(playState.playerStrumline.x - Strumline.BACKGROUND_PAD).makeSolidColor(Std.int(underlayWidth), FlxG.height, Std.parseInt("0xFF" + (badOptions.strumBgColor == 0 ? "000000" : StringTools.hex(badOptions.strumBgColor))));
            if (playState.playerStrumline.inArrowContorlSchemeMode && playState.playerStrumline.isPlayer) laneUnderlay.x -= 85;
            laneUnderlay.alpha = Preferences.strumlineBackgroundOpacity / 100;
            // Add gradients
            var fadeRegionWidth = Std.int(playState.playerStrumline.width * 0.04);
            leftGradient = createGradient(fadeRegionWidth, FlxG.height * 2, 0, Preferences.strumlineBackgroundOpacity / 100, true);
            leftGradient.x = laneUnderlay.x - fadeRegionWidth;

            rightGradient = createGradient(fadeRegionWidth, FlxG.height * 2, 0, Preferences.strumlineBackgroundOpacity / 100, false);
            rightGradient.x = laneUnderlay.x + laneUnderlay.width;

            underlaySprites = [laneUnderlay, leftGradient, rightGradient];
            for (sprite in underlaySprites) {
                sprite.scrollFactor.set();
                sprite.zIndex = -1;
                sprite.camera = PlayState.instance.camHUD;
                PlayState.instance.add(sprite);
            }
        }

        // Replace Rating PopUps
        playState.remove(playState.comboPopUps);
        ratingsPopUps = new RatingPopUps();
        ratingsPopUps.noteStyle = noteStyle;
        ratingsPopUps.camera = playState.camHUD;
        ratingsPopUps.zIndex = 900;
        playState.add(ratingsPopUps);

        // Hit Diff Text
        if (badOptions.hitDiffBool) initHitDiffText();

        // Remind Keybinds
        if (badOptions.remindKeys) {
            var noteHeigth:Int;
            for (staticNote in playState.playerStrumline.strumlineNotes.members) {
                var keyArray = PreciseInputManager.getKeysForDirection(PlayerSettings.player1.controls, staticNote.direction);
                var keyName = InputUtil.getKeyName(keyArray[0]);
                var keybindText = new FlxText(staticNote.x, staticNote.y, staticNote.width, keyName);
                keybindText.setFormat(Paths.font(badOptions.hudFont), 32, 0xFFFFFFFF, "center", FlxTextBorderStyle.OUTLINE_FAST, 0xFF000000);
                keybindText.y = staticNote.y + staticNote.height * 0.5;
                keybindText.y += Preferences.downscroll || FlxG.onMobile ? -keybindText.height : keybindText.height;
                keybindText.alpha = 0;
                keybindText.camera = PlayState.instance.camHUD;
                PlayState.instance.add(keybindText);
                keybindTexts.push(keybindText);
                noteHeigth = Std.int(staticNote.height);
            }
            fadeInKeybinds(noteHeigth);
        }

        // Opponent Strumline Background
        playState.opponentStrumline.background.visible = false;
        if (badOptions.opponentNoteOpacity > 0 && playState.opponentStrumline.visible == true) {
            if (FlxG.onMobile) playState.opponentStrumline.x -= 100;
            if (badOptions.middlescroll && !badOptions.oppMiddlescroll) {
                oppLaneUnderlay = new FunkinSprite();
                oppLaneUnderlay.x = playState.opponentStrumline.x;
                oppLaneUnderlay.makeSolidColor(Std.int(playState.opponentStrumline.width * noteScaling + (Strumline.BACKGROUND_PAD * noteScaling) * 2), FlxG.height, Std.parseInt("0xFF" + (badOptions.strumBgColor == 0 ? "000000" : StringTools.hex(badOptions.strumBgColor))));
                if (playState.opponentStrumline.noteStyle.id == Constants.DEFAULT_NOTE_STYLE) oppLaneUnderlay.x += 30;
                oppLaneUnderlay.alpha = Preferences.strumlineBackgroundOpacity / 100;
                oppLaneUnderlay.scrollFactor.set();
                oppLaneUnderlay.zIndex = -1;
                oppLaneUnderlay.camera = playState.camHUD;
                playState.add(oppLaneUnderlay);
            } else if (!badOptions.middlescroll) {
                oppLaneUnderlay = new FunkinSprite();
                oppLaneUnderlay.x = playState.opponentStrumline.x - Strumline.BACKGROUND_PAD;
                if (FlxG.onMobile) oppLaneUnderlay.x += Strumline.BACKGROUND_PAD * 2;
                oppLaneUnderlay.makeSolidColor(Std.int(playState.opponentStrumline.width + Strumline.BACKGROUND_PAD * 2 - (FlxG.onMobile ? Strumline.BACKGROUND_PAD : 0)), FlxG.height, Std.parseInt("0xFF" + (badOptions.strumBgColor == 0 ? "000000" : StringTools.hex(badOptions.strumBgColor))));
                oppLaneUnderlay.alpha = Preferences.strumlineBackgroundOpacity / 100;
                oppLaneUnderlay.scrollFactor.set();
                oppLaneUnderlay.zIndex = -1;
                oppLaneUnderlay.camera = playState.camHUD;
                playState.add(oppLaneUnderlay);
            }
        }
    }

    override function onUpdate(event:UpdateScriptEvent) {
        if (playState == null || badOptions.opponentNoteOpacity <= 0 || playState.opponentStrumline.visible == false || BadHooks.strumlineExcluded.indexOf(playState.currentChart.songName) != -1) return;
        try {
            if (playState.currentStage != null) {
                // Opponent Hold Covers / Splashes
                for (note in playState.opponentStrumline.noteHoldCovers.members) {
                    if (note == null || !note.alive) continue;
                    note.alpha = badOptions.opponentNoteOpacity / 100;
                    if (badOptions.middlescroll && !badOptions.oppMiddlescroll) note.scale.set(noteStyle.getNoteScale() - noteStyle.getNoteScale() * noteScaling, noteStyle.getNoteScale() - noteStyle.getNoteScale() * noteScaling);
                    note.x = playState.opponentStrumline.strumlineNotes.members[note.holdNote.noteDirection].x
                    + ((playState.opponentStrumline.strumlineNotes.members[note.holdNote.noteDirection].width - note.width) * 0.5)
                    + noteStyle.getHoldCoverOffsets()[0] * note.scale.x
                    - 12;
                }
            }
        } catch (e:Exception) trace("[BadHUD] " + e);
    }

    override function onNoteIncoming(event:NoteScriptEvent) {
        if (FlxG.onMobile) return;
        if (playState == null || badOptions.opponentNoteOpacity <= 0 || event.note.noteData.getMustHitNote(Strumline.KEY_COUNT) || BadHooks.strumlineExcluded.indexOf(playState.currentChart.songName) != -1) return;
        try {
            if (playState.currentStage != null && event.note != null && event.note.alive) {
                // Basic Notes
                event.note.alpha = badOptions.opponentNoteOpacity / 100;
                if (badOptions.middlescroll && !badOptions.oppMiddlescroll) event.note.scale.set(noteStyle.getNoteScale() - noteStyle.getNoteScale() * noteScaling, noteStyle.getNoteScale() - noteStyle.getNoteScale() * noteScaling);
                event.note.x = playState.opponentStrumline.strumlineNotes.members[event.note.direction].x + (playState.opponentStrumline.strumlineNotes.members[event.note.direction].width - event.note.width) * 0.5;
                event.note.alpha = badOptions.opponentNoteOpacity / 100;

                // Hold Notes
                if (event.note.isHoldNote && event.note.holdNoteSprite != null) {
                    event.note.holdNoteSprite.alpha = badOptions.opponentNoteOpacity / 100;
                    if (badOptions.middlescroll && !badOptions.oppMiddlescroll) {
                        event.note.holdNoteSprite.scale.set(noteStyle.getNoteScale() - noteStyle.getNoteScale() * noteScaling, noteStyle.getNoteScale() - noteStyle.getNoteScale() * noteScaling);
                        event.note.holdNoteSprite.graphicWidth *= noteScaling;
                        event.note.holdNoteSprite.updateClipping();
                    }
                    event.note.holdNoteSprite.x = event.note.x + ((event.note.width - event.note.holdNoteSprite.graphicWidth) * 0.5);
                }
            }

        } catch (e:Exception) trace("[BadHUD] " + e);
    }

    override function onNoteHit(event:HitNoteScriptEvent) {
        if (playState != null && event.note.noteData.getMustHitNote(Strumline.KEY_COUNT)) popUpRatings(event.judgement, event.hitDiff);
    }

    override function onNoteMiss(event:NoteScriptEvent) { event.playSound = !badOptions.muteMiss; }

    override function onNoteGhostMiss(event:GhostMissNoteScriptEvent) { event.playSound = !badOptions.muteMiss; }

    override function onNoteHoldDrop(event:HoldNoteScriptEvent) { event.playSound = !badOptions.muteMiss; }

    // Gradient Underlay
    function createGradient(width:Int, height:Int, alphaStart:Float, alphaEnd:Float, isLeftToRight:Bool = true):FunkinSprite {
        var gradientSprite = new FunkinSprite();
        if (PlatformUtil.detectHostPlatform() == HostPlatform.LINUX || FlxG.onMobile) gradientSprite.visible = false;
        var bitmap = new BitmapData(2, 1, true, 0x0);

        var leftAlpha = isLeftToRight ? alphaStart : alphaEnd;
        leftAlpha = Math.max(0, Math.min(leftAlpha, 1));
        var leftColor = (Std.int(leftAlpha * 255) << 24) | badOptions.strumBgColor;

        var rightAlpha = isLeftToRight ? alphaEnd : alphaStart;
        rightAlpha = Math.max(0, Math.min(rightAlpha, 1));
        var rightColor = (Std.int(rightAlpha * 255) << 24) | badOptions.strumBgColor;

        bitmap.setPixel32(0, 0, leftColor);
        bitmap.setPixel32(1, 0, rightColor);

        gradientSprite.loadBitmapData(bitmap, false);

        gradientSprite.scale.set(width * 0.5, height);
        gradientSprite.updateHitbox();

        return gradientSprite;
    }

    // Helper Methods
    function popUpRatings(judgement:String, hitDiff:Float, ?combo:Int) {
        if (hitDiffText != null) {
            hitDiffText.text = hitDiff + " ms";
            if (badOptions.hitDiffColor) hitDiffText.color = getTimingColor(hitDiff);
            hitDiffText.alpha = 1.0;

            // Fade out hit difference
            if (badOptions.hitDiffFade) {
                if (hitDiffTween != null) {
                    hitDiffTween.cancel();
                    hitDiffTween = null;
                }

                hitDiffTween = FlxTween.tween(hitDiffText, {alpha: 0}, 0.2, {
                    ease: FlxEase.quadOut,
                    startDelay: 0.3 + playState.conductorInUse.beatLengthMs * 0.001,
                    onComplete: tween -> hitDiffTween = null
                });
            }

            if (settings != null) hitDiffText.setPosition(settings[0] - hitDiffText.width * 0.5, settings[1] - hitDiffText.height * 0.5);
        }

        if (badOptions.popUpType == "off" || ratingsPopUps == null || judgement == "miss") return;
        var judgementSprite:FunkinSprite = ratingsPopUps.displayJudgement(judgement);

        if (combo == null) combo = Highscore.tallies.combo;
        if (combo >= 10) ratingsPopUps.displayCombo(combo);

        if (hitDiffText != null && settings == null && judgementSprite != null) hitDiffText.setPosition(judgementSprite.x + judgementSprite.width, judgementSprite.y + judgementSprite.height + hitDiffText.height);
    }

    function getTimingColor(msTiming:Float) {
        var absTiming:Float = Math.abs(msTiming);

        // Add directional hint (blue for early, red tint for late) to the color
        var directionHint:Int = (msTiming < 0) ? 0x000088 : 0x880000;

        if (absTiming < Scoring.PBOT1_PERFECT_THRESHOLD) return PERFECT_COLOR;
        else if (absTiming < Scoring.PBOT1_KILLER_THRESHOLD) return KILLER_COLOR | directionHint;
        else if (absTiming < Scoring.PBOT1_SICK_THRESHOLD) return SICK_COLOR | directionHint;
        else if (absTiming < Scoring.PBOT1_GOOD_THRESHOLD) return GOOD_COLOR | directionHint;
        else if (absTiming < Scoring.PBOT1_BAD_THRESHOLD) return BAD_COLOR | directionHint;
        else if (absTiming < Scoring.PBOT1_SHIT_THRESHOLD) return SHIT_COLOR | directionHint;
    }

    function fadeInKeybinds(noteHeight:Float) {
        var index = 0;
        for (text in keybindTexts) {
            var textYDirI = Preferences.downscroll || FlxG.onMobile ? -noteHeight * 0.5 : noteHeight * 0.5;
            var textYDirII = Preferences.downscroll || FlxG.onMobile ? 20 : -20;
            FlxTween.tween(text, {y: text.y + textYDirI, alpha: 1}, 1, {
                ease: FlxEase.circOut,
                startDelay: 0.5 + (0.2 * index),
                onComplete: tween -> FlxTween.tween(text, {y: text.y + textYDirII, alpha: 0}, 0.8, {
                    ease: FlxEase.circIn,
                    onComplete: tween -> {
                        text.destroy();
                        keybindTexts = [];
                    }
                })
            });
            index++;
        }
    }

    function placeOpponentNotes(strumline:Strumline) {
        if (!badOptions.middlescroll || badOptions.opponentNoteOpacity <= 0) return;
        if (badOptions.oppMiddlescroll) {
            var rightXOffset = badOptions.healthBar ? Constants.STRUMLINE_X_OFFSET : 150;
            rightXOffset += noteStyle.getStrumlineOffsets()[0];
            for (i in 2...4) strumline.strumlineNotes.members[i].x = FlxG.width - strumline.width + rightXOffset + Strumline.NOTE_SPACING * (i - 2);
        } else {
            strumline.scale.set(noteStyle.getNoteScale() - noteStyle.getNoteScale() * noteScaling, noteStyle.getNoteScale() - noteStyle.getNoteScale() * noteScaling);
            strumline.y = Preferences.downscroll ? FlxG.height + STRUMLINE_UPSCROLL : STRUMLINE_DOWNSCROLL;
            var noteSpacing = Strumline.NOTE_SPACING - Strumline.NOTE_SPACING * noteScaling;
            for (note in strumline.strumlineNotes.members) {
                FlxTween.cancelTweensOf(note);
                note.x = strumline.x;
                note.x += switch (note.direction % Strumline.KEY_COUNT) {
                    case 0: 0;
                    case 1: (1 * noteSpacing);
                    case 2: (2 * noteSpacing);
                    case 3: (3 * noteSpacing);
                    default: 0;
                };
                note.x -= (((note.width - Strumline.STRUMLINE_SIZE) * 0.5) * noteScaling)
                - (Strumline.NUDGE * noteScaling)
                + (noteStyle.getStrumlineOffsets()[0] * noteScaling);

                note.y = strumline.y + noteStyle.getStrumlineOffsets()[1];
                if (!playState.needsReset) {
                    FlxTween.tween(note, {y: note.y, alpha: badOptions.opponentNoteOpacity / 100}, 1, {
                        onStart: tween -> note.y -= 10, ease: FlxEase.circOut, startDelay: 0.5 + (0.2 * note.direction)
                    });
                }
            }
        }
    }

    function initHitDiffText() {
        hitDiffText = new FlxText();
        hitDiffText.setFormat(Paths.font(badOptions.hudFont), badOptions.hudFontSize, 0xFFFFFFFF, "center", FlxTextBorderStyle.OUTLINE_FAST, 0xFF000000);
        hitDiffText.borderSize = 1.25;
        settings = Save.instance.modOptions.get("hitDiffTextSettings");
        if (settings != null) {
            hitDiffText.angle = settings[4];
            hitDiffText.scale.x = settings[2];
            hitDiffText.scale.y = settings[3];
            hitDiffText.updateHitbox();
        } else hitDiffText.setPosition(FlxG.width * 0.55, FlxG.height * 0.45);
        hitDiffText.zIndex = 851;
        hitDiffText.scrollFactor.set();
        hitDiffText.camera = playState.camHUD;
        hitDiffText.alpha = 0;
        playState.add(hitDiffText);
    }

    // Cleanup Stuff
    override function onSubStateOpenBegin(event:SubStateScriptEvent) { if (!(event.targetState is PlayState) && !(event.targetState is PauseSubState)) cleanup(); }

    override function onSubStateCloseBegin(event:SubStateScriptEvent) { if (event.targetState is PlayState) cleanup(); }

    override function onSongRetry(event:ScriptEvent) { cleanup(); }

    override function onSongEnd(event:ScriptEvent) { cleanup(); }

    override function onDestroy(event:ScriptEvent) { cleanup(); }

    function cleanup() {
        if (playState != null && !playState.needsReset) {
            if (ratingsPopUps != null) ratingsPopUps.destroy();
            ratingsPopUps = null;
        }
        if (laneUnderlay != null) laneUnderlay.destroy();
        if (leftGradient != null) leftGradient.destroy();
        if (rightGradient != null) rightGradient.destroy();
        if (oppLaneUnderlay != null) oppLaneUnderlay.destroy();
        if (hitDiffText != null) hitDiffText.destroy();
        laneUnderlay = null;
        leftGradient = null;
        rightGradient = null;
        underlaySprites = [];
        oppLaneUnderlay = null;
        hitDiffText = null;
        hitDiffTween = null;
    }
}