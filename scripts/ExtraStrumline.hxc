import funkin.Highscore;
import funkin.Paths;
import funkin.PlayerSettings;
import funkin.Preferences;
import funkin.data.notestyle.NoteStyleRegistry;
import funkin.graphics.FunkinSprite;
import funkin.input.PreciseInputManager;
import funkin.modding.events.ScriptEvent;
import funkin.modding.module.ModuleHandler;
import funkin.modding.module.ScriptedModule;
import funkin.play.notes.Strumline;
import funkin.play.notes.notestyle.NoteStyle;
import funkin.play.PauseSubState;
import funkin.play.PlayState;
import funkin.util.Constants;
import funkin.util.EaseUtil;
import funkin.util.InputUtil;
import funkin.save.Save;

import flixel.FlxG;
import flixel.FlxSprite;
import flixel.text.FlxText;
import flixel.text.FlxTextBorderStyle;
import flixel.tweens.FlxEase;
import flixel.tweens.FlxTween;

import openfl.display.BitmapData;

import Std;

class ExtraStrumline extends ScriptedModule {
    var badOptions:Null<BadSaveData> = Save.instance.modOptions.get("badOptions");
    var state:PlayState;

    var laneUnderlay:FlxSprite;
    var leftGradient:FlxSprite;
    var rightGradient:FlxSprite;
    var underlaySprites:Array<FlxSprite>;

    var keybindTexts:Array<FlxText> = [];

    var tempComboSprites:Array<FunkinSprite> = [];
    var tempJudgementSprite:FunkinSprite;

    var noteStyle:NoteStyle;

    function new() {
        super("ExtraStrumline", 3);
    }

    override function onSongLoaded(event:SongLoadScriptEvent) {
        var badHooks = ModuleHandler.getModule("BadHooks");
        if (badHooks != null) state = badHooks.scriptGet("state");
        if (state == null) return;
        noteStyle = NoteStyleRegistry.instance.fetchEntry(state.currentChart.noteStyle);
        if (noteStyle == null) noteStyle = NoteStyleRegistry.instance.fetchDefault();

        // Center player strumline
        if (badOptions.middlescroll && new BadHooks().strumlineExcluded.indexOf(state.currentChart.songName) == -1) {
            state.playerStrumline.x = FlxG.width / 2 - state.playerStrumline.width / 2;

            // Opponent Strumline
            if (badOptions.opponentNoteOpacity != 0) {
                var rightXOffset = badOptions.healthBarPosition == "vertical" ? -Constants.STRUMLINE_X_OFFSET : -150;

                // Place last 2 notes on right side
                for (i in 2...4) {
                    var note = state.opponentStrumline.strumlineNotes.members[i];
                    note.x = FlxG.width - state.opponentStrumline.width - rightXOffset + Strumline.NOTE_SPACING * (i - 2);
                }
            }
        }

        if (badOptions.opponentNoteOpacity > 0) state.opponentStrumline.alpha = badOptions.opponentNoteOpacity / 100;

        // Note Underlay
        if (badOptions.underlayOpacity > 0) {
            laneUnderlay = new FlxSprite(0, 0).makeGraphic(Std.int(state.playerStrumline.get_width()), FlxG.height * 2);
            laneUnderlay.x = state.playerStrumline.x;
            laneUnderlay.color = 0x000000;
            laneUnderlay.alpha = badOptions.underlayOpacity / 100;

            var fadeRegionWidth = Std.int(state.playerStrumline.width * 0.05);

            leftGradient = createGradient(fadeRegionWidth, FlxG.height * 2, 0, badOptions.underlayOpacity / 100, true);
            leftGradient.x = state.playerStrumline.x - fadeRegionWidth;

            rightGradient = createGradient(fadeRegionWidth, FlxG.height * 2, 0, badOptions.underlayOpacity / 100, false);
            rightGradient.x = state.playerStrumline.x + state.playerStrumline.width;

            underlaySprites = [laneUnderlay, leftGradient, rightGradient];
            for (sprite in underlaySprites) {
                sprite.scrollFactor.set();
                sprite.zIndex = -1;
                sprite.cameras = [state.camHUD];
                state.add(sprite);
            }
        }

        // Replace Combo PopUps
        state.remove(state.comboPopUps);

        // Remind Keybinds
        if (badOptions.remindKeys) {
            for (staticNote in state.playerStrumline.strumlineNotes.members) {
                var keyArray = PreciseInputManager.getKeysForDirection(PlayerSettings.player1.controls, staticNote.direction);
                var keyName = InputUtil.getKeyName(keyArray[0]) ;
                var keybindText = new FlxText(staticNote.x, staticNote.y, staticNote.width, keyName);
                keybindText.y = staticNote.y + (Preferences.downscroll ? keybindText.height * 2 : staticNote.height - keybindText.height * 2);
                keybindText.setFormat(Paths.font(new BadHUDOptions().font), 32, 0xFFFFFFFF, "center", FlxTextBorderStyle.OUTLINE_FAST, 0xFF000000);
                keybindText.alpha = 0;
                keybindText.cameras = [state.camHUD];
                state.add(keybindText);
                keybindTexts.push(keybindText);
            }
            fadeInKeybinds();
        }
    }

    override function onUpdate(event:UpdateScriptEvent) {
        if (state == null) return;
        try {
            if (badOptions.underlayOpacity > 0) updatePosition();
            if (badOptions.middlescroll && !badOptions.oppNotes) {
                if (state.currentStage != null && new BadHooks().strumlineExcluded.indexOf(state.currentChart.songName) == -1) updateOpponentNotes();
                else if (state.isMinimalMode) updateOpponentNotes();
            }
        } catch (e:Exception) {
            throw trace("[BadHUD] " + e);
        }
    }

    override function onNoteHit(event:HitNoteScriptEvent) { if (state != null && !state.isPracticeMode && event.note.noteData.getMustHitNote()) displayPopUps(event.judgement); }

    override function onNoteMiss(event:NoteScriptEvent) { event.playSound = !badOptions.muteMiss; }

    override function onNoteGhostMiss(event:GhostMissNoteScriptEvent) { event.playSound = !badOptions.muteMiss; }

    // Gradient Underlay
    function createGradient(width:Int, height:Int, alphaStart:Float, alphaEnd:Float, isLeftToRight:Bool = true):FlxSprite {
        var gradientSprite = new FlxSprite();
        var bitmap = new BitmapData(width, height, true, 0x0);

        for (x in 0...width) {
            // If isLeftToRight is true, fades left to right. If false, fades right to left
            var progress = isLeftToRight ? (x / width) : (1.0 - (x / width));
            var alpha = alphaStart + (alphaEnd - alphaStart) * progress;
            alpha = Math.max(0, Math.min(alpha, 1));
            var color = (Std.int(alpha * 255) << 24) | 0x000000;

            for (y in 0...height) {
                bitmap.setPixel32(x, y, color);
            }
        }

        gradientSprite.pixels = bitmap;
        gradientSprite.dirty = true;
        return gradientSprite;
    }

    // Helper Methods
    function displayPopUps(judgement:String, ?combo:Int) {
        if (judgement == "miss" || badOptions.popUpType == "off") return;
        displayJudgements(judgement);

        if (combo == null) combo = Highscore.tallies.combo;
        if (combo >= 10) displayCombo(combo);
    }

    function displayCombo(combo:Int = 0) {
        if (tempComboSprites.length > 0 && badOptions.popUpType == "popup") {
            for (sprite in tempComboSprites) {
                state.remove(sprite, true);
                sprite.destroy();
            }
            tempComboSprites = [];
        }

        var seperatedScore:Array<Int> = [];
        var tempCombo:Int = combo;

        while (tempCombo != 0) {
            seperatedScore.push(tempCombo % 10);
            tempCombo = Std.int(tempCombo / 10);
        }
        while (seperatedScore.length < 3) seperatedScore.push(0);

        var daLoop:Int = 1;

        for (digit in seperatedScore) {
            var numCombo:FunkinSprite = noteStyle.buildComboNumSprite(digit);
            if (numCombo == null) continue;

            var comboOffsets = Save.instance.modOptions.get("comboOffsets");
            if (comboOffsets != null) {
                var originalWidth = numCombo.width;
                numCombo.scale.set(comboOffsets[2], comboOffsets[3]);
                numCombo.updateHitbox();
                var newWidth = numCombo.width;
                numCombo.setPosition(comboOffsets[0] - ((38 - (originalWidth - newWidth)) * (daLoop - 1)), comboOffsets[1]);
            } else {
                numCombo.x = (FlxG.width * 0.507) - (38 * daLoop) - 65;
                numCombo.y = (FlxG.camera.height * 0.44);
                var styleOffsets = noteStyle.getComboNumSpriteOffsets(digit);
                numCombo.x += styleOffsets[0];
                numCombo.y += styleOffsets[1];
            }

            numCombo.zIndex = 900;
            numCombo.cameras = [state.camHUD];
            state.add(numCombo);
            tempComboSprites.push(numCombo);
            state.refresh();

            var fadeEase = noteStyle.isComboNumSpritePixel(digit) ? EaseUtil.stepped(2) : null;
            switch (badOptions.popUpType) {
                case "vanilla":
                    numCombo.acceleration.y = FlxG.random.int(250, 300);
                    numCombo.velocity.y -= FlxG.random.int(130, 150);
                    numCombo.velocity.x = FlxG.random.float(-5, 5);
                    FlxTween.tween(numCombo, {alpha: 0}, 0.2, {
                        onComplete: tween -> {
                            state.remove(numCombo, true);
                            numCombo.destroy();
                        },
                        startDelay: state.conductorInUse.beatLengthMs * 0.002,
                        ease: fadeEase
                    });
                case "popup":
                    FlxTween.tween(numCombo, {alpha: 0}, 0.2, {
                        onComplete: tween -> {
                            state.remove(numCombo, true);
                            numCombo.destroy();
                            tempComboSprites.remove(numCombo);
                        },
                        startDelay: state.conductorInUse.beatLengthMs * 0.002,
                        ease: fadeEase
                    });
            }
            daLoop++;
        }
    }

    function displayJudgements(judgement:String) {
        if (judgement == null) return;

        // Remove existing judgement sprite if it exists
        if (tempJudgementSprite != null && badOptions.popUpType == "popup") {
            state.remove(tempJudgementSprite, true);
            tempJudgementSprite.destroy();
            tempJudgementSprite = null;
        }

        // Create new rating sprite
        var judgementSprite:FunkinSprite = noteStyle.buildJudgementSprite(judgement);
        if (judgementSprite == null) return;

        var judgementOffsets = Save.instance.modOptions.get("judgementOffsets");
        if (judgementOffsets != null) {
            judgementSprite.setPosition(judgementOffsets[0], judgementOffsets[1]);
            judgementSprite.scale.set(judgementOffsets[2], judgementOffsets[3]);
            judgementSprite.updateHitbox();
        } else {
            judgementSprite.x = (FlxG.width * 0.474);
            judgementSprite.x -= judgementSprite.width / 2;
            judgementSprite.y = (FlxG.camera.height * 0.45 - 60);
            judgementSprite.y -= judgementSprite.height / 2;
            var styleOffsets = noteStyle.getJudgementSpriteOffsets(judgement);
            judgementSprite.x += styleOffsets[0];
            judgementSprite.y += styleOffsets[1];
        }

        // Save reference to current sprite
        tempJudgementSprite = judgementSprite;

        judgementSprite.zIndex = 900;
        judgementSprite.cameras = [state.camHUD];
        state.add(judgementSprite);
        state.refresh();

        var fadeEase = noteStyle.isJudgementSpritePixel(judgement) ? EaseUtil.stepped(2) : null;
        switch (badOptions.popUpType) {
            case "vanilla":
                judgementSprite.acceleration.y = 550;
                judgementSprite.velocity.y -= FlxG.random.int(140, 175);
                judgementSprite.velocity.x -= FlxG.random.int(0, 10);
                FlxTween.tween(judgementSprite, {alpha: 0}, 0.2, {
                    onComplete: tween -> {
                        state.remove(judgementSprite, true);
                        judgementSprite.destroy();
                    },
                    startDelay: state.conductorInUse.beatLengthMs * 0.001,
                    ease: fadeEase
                });
            case "popup":
                var originalScaleX = judgementSprite.scale.x;
                var originalScaleY = judgementSprite.scale.y;
                judgementSprite.scale.set(originalScaleX * 0.8, originalScaleX * 0.8);
                FlxTween.tween(judgementSprite.scale, {x: originalScaleX, y: originalScaleY}, 0.2, {
                    ease: FlxEase.backOut,
                    onComplete: tween -> {
                        FlxTween.tween(judgementSprite, {alpha: 0}, 0.3, {
                            onComplete: tween -> {
                                state.remove(judgementSprite, true);
                                judgementSprite.destroy();
                                if (tempJudgementSprite == judgementSprite) tempJudgementSprite = null;
                            },
                            startDelay: state.conductorInUse.beatLengthMs * 0.001,
                            ease: fadeEase
                        });
                    }
                });
        }
    }

    function updateOpponentNotes() {
        // Transparent Opponent Strumline
        for (staticNote in state.opponentStrumline.strumlineNotes.members) staticNote.alpha = badOptions.opponentNoteOpacity / 100;

        // Incoming Notes
        for (note in state.opponentStrumline.notes.members) {
            if (note == null || !note.alive) continue;
            note.x = state.opponentStrumline.strumlineNotes.members[note.direction].x + (state.opponentStrumline.strumlineNotes.members[note.direction].width - note.width) * 0.5;
            note.alpha = badOptions.opponentNoteOpacity / 100;
        }

        // Hold Notes
        for (note in state.opponentStrumline.holdNotes.members) {
            if (note == null || !note.alive) continue;
            note.x = state.opponentStrumline.strumlineNotes.members[note.noteDirection].x + (state.opponentStrumline.strumlineNotes.members[note.noteDirection].width - note.width) * 0.5;
            note.alpha = badOptions.opponentNoteOpacity / 100;
        }

        // Hold Covers / Hold Splashes
        for (note in state.opponentStrumline.noteHoldCovers.members) {
            if (note == null || !note.alive) continue;
            note.x = state.opponentStrumline.strumlineNotes.members[note.holdNote.noteDirection].x + (state.opponentStrumline.strumlineNotes.members[note.holdNote.noteDirection].width - note.width) * 0.5;
            note.alpha = badOptions.opponentNoteOpacity / 100;
        }
    }

    function updatePosition() {
        if (laneUnderlay == null || laneUnderlay.x == state.playerStrumline.x) return;
        trace("[BadHud] Updating Note Underlay Position");
        var fadeRegionWidth = Std.int(state.playerStrumline.width * 0.05);

        laneUnderlay.x = state.playerStrumline.x;
        leftGradient.x = state.playerStrumline.x - fadeRegionWidth;
        rightGradient.x = state.playerStrumline.x + state.playerStrumline.width;
    }

    function fadeInKeybinds() {
        var index = 0;
        for (text in keybindTexts) {
            var textYDirI = Preferences.downscroll ? text.y - text.height : text.y + text.height;
            var textYDirII = Preferences.downscroll ? text.y + 20 : text.y - 20;
            FlxTween.tween(text, {y: textYDirI, alpha: 1}, 1, {
                ease: FlxEase.circOut,
                startDelay: 0.5 + (0.2 * index),
                onComplete: _ -> FlxTween.tween(text, {y: textYDirII, alpha: 0}, 0.8, {
                    ease: FlxEase.circIn,
                    onComplete: _ -> {
                        text.destroy();
                        state.remove(text);
                        keybindTexts = [];
                    }
                })
            });
            index++;
        }
    }

    // Cleanup Stuff
    override function onSubStateOpenBegin(event:SubStateScriptEvent) { if (!Std.isOfType(event.targetState, PlayState) && !Std.isOfType(event.targetState, PauseSubState)) cleanup(); }

    override function onSubStateCloseBegin(event:SubStateScriptEvent) { if (Std.isOfType(event.targetState, PlayState)) cleanup(); }

    override function onSongRetry(event:ScriptEvent) { cleanup(); }

    override function onSongEnd(event:ScriptEvent) { cleanup(); }

    override function onDestroy(event:ScriptEvent) { cleanup(); }

    function cleanup() {
        if (laneUnderlay != null) laneUnderlay.destroy();
        if (leftGradient != null) leftGradient.destroy();
        if (rightGradient != null) rightGradient.destroy();
        laneUnderlay = null;
        leftGradient = null;
        rightGradient = null;
        tempJudgementSprite = null;
    }
}