import funkin.graphics.FunkinSprite;
import funkin.modding.events.ScriptEvent;
import funkin.modding.module.ModuleHandler;
import funkin.modding.module.ScriptedModule;
import funkin.play.PlayState;
import funkin.play.character.BaseCharacter;
import funkin.play.components.HealthIcon;
import funkin.util.Constants;
import funkin.save.Save;

import flixel.FlxSprite;
import flixel.math.FlxAngle;
import flixel.math.FlxMath;
import flixel.ui.FlxBar;

import Std;

class BadHealthBar extends ScriptedModule {
    var badOptions:Null<BadSaveData> = Save.instance.modOptions.get("badOptions");
    var state:PlayState;
    var currentP1:BaseCharacter = null;
    var currentP2:BaseCharacter = null;

    var healthBarBG:FunkinSprite;
    var healthBar:FlxBar;
    var iconP1:HealthIcon;
    var iconP2:HealthIcon;

    var iconSpacing:Float = 50;

    function new() {
        super("BadHealthBar");
    }

    override function onSongLoaded(event:SongLoadScriptEvent) {
        var badHooks = ModuleHandler.getModule("BadHooks");
        if (badHooks != null) state = badHooks.scriptGet('state');
        if (state == null) return;
        if (new BadHooks().healthBarExcluded.indexOf(state.currentChart.songName) != -1) return;
        healthBarBG = state.healthBarBG;
        healthBar = state.healthBar;
        iconP1 = state.iconP1;
        iconP2 = state.iconP2;
        if (state.currentStage != null) {
            currentP1 = state.currentStage.getBoyfriend();
            currentP2 = state.currentStage.getDad();
        }

        // Health Bar
        if (badOptions.healthBar) {
            var settings = Save.instance.modOptions.get("healthBarSettings");
            if (settings != null) {
                healthBarBG.angle = healthBar.angle = settings[4];
                healthBarBG.scale.x = healthBar.scale.x = settings[2];
                healthBarBG.scale.y = healthBar.scale.y = settings[3];
                healthBarBG.updateHitbox();
                healthBarBG.setPosition(settings[0] - healthBarBG.width / 2, settings[1] - healthBarBG.height / 2);
                healthBar.setPosition(state.healthBarBG.x + (state.healthBarBG.width / 2) - (state.healthBar.width / 2), state.healthBarBG.y + (state.healthBarBG.height / 2) - (state.healthBar.height / 2));

                if (!state.isMinimalMode) {
                    if (iconP1 != null) iconP1.autoUpdate = false;
                    if (iconP2 != null) iconP2.autoUpdate = false;
                }
            }

            // Icon Colored Health Bar
            updateHealthIconsColor(3);
            state.healthBar.alpha = badOptions.hudOpacity / 100;
            state.healthBarBG.alpha = badOptions.hudOpacity / 100;
        } else {
            state.remove(healthBar);
            state.remove(healthBarBG);
        }

        if (badOptions.smoothBars) state.healthBar.numDivisions = Std.int(state.healthBarBG.width / 1.3);

        // Health Icon Positions
        if (!state.isMinimalMode) {
            switch (badOptions.healthIconPosition) {
                case "off":
                    state.remove(iconP1);
                    state.remove(iconP2);
                case "flipped":
                    if (iconP1 != null) iconP1.flipX = false;
                    if (iconP2 != null) iconP2.flipX = true;
                case "centered":
                    var healthBarX:Float = healthBar.x;
                    var healthBarY:Float = healthBar.y;
                    var healthBarWidth:Float = healthBar.width;
                    var healthBarHeight:Float = healthBar.height;
                    var centerX:Float = healthBarX + (healthBarWidth / 2);
                    var centerY:Float = healthBarY + (healthBarHeight / 2);

                    var angleRad = FlxAngle.asRadians(healthBar.angle);

                    var offsetX:Float = Math.cos(angleRad) * iconSpacing;
                    var offsetY:Float = -Math.sin(angleRad) * iconSpacing;

                    if (iconP1 != null) {
                        iconP1.x = centerX + offsetX - (iconP1.width / 2);
                        iconP1.y = centerY - offsetY - (iconP1.height / 2);
                    }
                    if (iconP2 != null) {
                        iconP2.x = centerX - offsetX - (iconP2.width / 2);
                        iconP2.y = centerY + offsetY - (iconP2.height / 2);
                    }
                case "ends":
                    var healthBarX:Float = healthBar.x;
                    var healthBarY:Float = healthBar.y;
                    var healthBarWidth:Float = healthBar.width;
                    var halfBarLength:Float = healthBarWidth / 2;
                    var centerX:Float = healthBarX + halfBarLength;
                    var centerY:Float = healthBarY + healthBar.height / 2;

                    var angleRad = FlxAngle.asRadians(healthBar.angle);

                    var offsetX:Float = Math.cos(angleRad) * halfBarLength;
                    var offsetY:Float = -Math.sin(angleRad) * halfBarLength;

                    if (iconP1 != null) {
                        iconP1.x = centerX + offsetX - (iconP1.width / 2);
                        iconP1.y = centerY - offsetY - (iconP1.height / 2);
                    }
                    if (iconP2 != null) {
                        iconP2.x = centerX - offsetX - (iconP2.width / 2);
                        iconP2.y = centerY + offsetY - (iconP2.height / 2);
                    }
            }
        }

        if (!state.isMinimalMode) {
            if (iconP1 != null) iconP1.alpha = badOptions.hudOpacity / 100;
            if (iconP2 != null) iconP2.alpha = badOptions.hudOpacity / 100;
        }

        if (!state.isMinimalMode) updateIconsPosition();
    }

    override function onSongEvent(event:SongEventScriptEvent) {
        if (state.currentStage == null) return;
        var newP1 = state.currentStage.getBoyfriend();
        var newP2 = state.currentStage.getDad();

        if (newP1 != currentP1 || newP2 != currentP2) {
            currentP1 = newP1;
            currentP2 = newP2;
            updateHealthIconsColor(12);
        }
    }

    // bop for icons, I think onBeatHit is better than onUpdate and fixes it ?
    override function onBeatHit(event:SongTimeScriptEvent) { if (state != null && !state.isMinimalMode) updateIconsPosition(); }

    override function onUpdate(event:UpdateScriptEvent) { if (state != null && !state.isMinimalMode) updateIconsPosition(); }

    // Helper Methods
    function updateHealthIconsColor(sampleRate:Int) {
        if (badOptions.iconColors) {
            var bfHealthColor = getDominantColor(iconP1, sampleRate);
            var opponentHealthColor = getDominantColor(iconP2, sampleRate);
            if (healthBar != null) healthBar.createFilledBar(opponentHealthColor, bfHealthColor);
        }
    }

    function getDominantColor(sprite:FlxSprite, sampleRate:Int = 4) {
        if (sprite == null || sprite.pixels == null) return 0xFFFFFFFF;

        var colorData:Array<{color:Int, count:Int}> = [];
        var maxCount = 0;
        var dominantColor = 0xFFFFFFFF;

        sprite.pixels.lock();

        for (y in 0...sprite.frameHeight) {
            if (y % sampleRate != 0) continue;
            for (x in 0...sprite.frameWidth) {
                if (x % sampleRate != 0) continue;
                var color = sprite.pixels.getPixel32(x, y);

                if (color == 0 || (color >>> 24) <= 13) continue;
                if (color == 0xFFF000000 || color == 0x00FFFFFF) continue;

                var found = false;
                for (i in 0...colorData.length) {
                    if (colorData[i].color == color) {
                        colorData[i].count++;

                        if (colorData[i].count > maxCount) {
                        maxCount = colorData[i].count;
                        dominantColor = color;
                        }

                        found = true;
                        break;
                    }
                }

                // Add new color if not found
                if (!found) colorData.push({ color: color, count: 1 });
            }
        }

        sprite.pixels.unlock();
        return dominantColor;
    }

    function updateIconsPosition() {
        if (iconP1 == null || iconP2 == null || !badOptions.healthBar) return;

        // Rotate and move icons according to the Modified Bar !
        if (badOptions.healthIconPosition != "ends" && badOptions.healthIconPosition != "centered") {
            var healthBarX:Float = healthBar.x;
            var healthBarY:Float = healthBar.y;
            var healthBarWidth:Float = healthBar.width;
            var healthBarHeight:Float = healthBar.height;
            var centerX:Float = healthBarX + (healthBarWidth / 2);
            var centerY:Float = healthBarY + (healthBarHeight / 2);
            var missingHealthPercentage:Float = FlxMath.remapToRange(healthBar.value, 0, 2, 100, 0) / 100;

            var iconSpacing:Float = 50;

            var angleRad:Float = healthBar.angle * (Math.PI / 180);
            var distanceFromCenter:Float = (missingHealthPercentage - 0.5) * healthBarWidth;

            var offsetX:Float = Math.cos(angleRad) * distanceFromCenter;
            var offsetY:Float = -Math.sin(angleRad) * distanceFromCenter;

            var spacingOffsetX:Float = Math.cos(angleRad) * iconSpacing;
            var spacingOffsetY:Float = -Math.sin(angleRad) * iconSpacing;

            iconP1.x = centerX + offsetX + spacingOffsetX - (iconP1.width / 2);
            iconP1.y = centerY - offsetY - spacingOffsetY - (iconP1.height / 2);
            iconP2.x = centerX + offsetX - spacingOffsetX - (iconP2.width / 2);
            iconP2.y = centerY - offsetY + spacingOffsetY - (iconP2.height / 2);

            var settings = Save.instance.modOptions.get("healthBarSettings");
            if (badOptions.healthIconPosition == "rotated" && settings != null) {
                if (iconP1 != null) iconP1.angle = settings[4];
                if (iconP2 != null) iconP2.angle = settings[4];
            }
        }

        updateHealthIcon(iconP1, state.health);
        updateHealthIcon(iconP2, Constants.HEALTH_MAX - state.health);
    }

    function updateHealthIcon(icon:HealthIcon, health:Float) { if (icon != null) icon.playAnimation(health < HealthIcon.LOSING_THRESHOLD ? "losing" : health > HealthIcon.WINNING_THRESHOLD ? "winning" : "idle"); }
}