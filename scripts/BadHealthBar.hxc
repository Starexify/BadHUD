import funkin.modding.events.ScriptEvent;
import funkin.modding.module.ModuleHandler;
import funkin.modding.module.ScriptedModule;
import funkin.play.PlayState;
import funkin.play.components.HealthIcon;
import funkin.util.Constants;
import funkin.save.Save;

import flixel.FlxG;
import flixel.FlxSprite;
import flixel.math.FlxMath;

import Std;

class BadHealthBar extends ScriptedModule {
    var badOptions:Null<BadSaveData> = Save.instance.modOptions.get("badOptions");
    var state:PlayState;

    var iconP1:HealthIcon;
    var iconP2:HealthIcon;

    function new() {
        super("BadHealthBar");
    }

    override function onSongLoaded(event:SongLoadScriptEvent) {
        var badHooks = ModuleHandler.getModule("BadHooks");
        if (badHooks != null) state = badHooks.scriptGet("state");
        if (state == null) return;
        if (new BadHooks().healthBarExcluded.indexOf(state.currentChart.songName) != -1) return;
        iconP1 = state.iconP1;
        iconP2 = state.iconP2;

        if (badOptions.smoothBars) state.healthBar.numDivisions = Std.int(state.healthBarBG.width / 1.2);

        // Health Bar
        if (badOptions.healthBarPosition != "off") {
            if (badOptions.healthBarPosition == "vertical") {
                // Vertical HP Bar
                state.healthBar.x = FlxG.width * 0.7;
                state.healthBar.y = FlxG.height * 0.5;
                state.healthBar.angle = 90;
                state.healthBarBG.angle = 90;

                if (!state.isMinimalMode) {
                    if (iconP1 != null) iconP1.autoUpdate = false;
                    if (iconP2 != null) iconP2.autoUpdate = false;
                }
            }
            state.healthBarBG.setPosition(state.healthBar.x - 4, state.healthBar.y - 4);
            if (!state.isMinimalMode) {
                if (iconP1 != null) iconP1.alpha = badOptions.hudOpacity / 100;
                if (iconP2 != null) iconP2.alpha = badOptions.hudOpacity / 100;
            }
            state.healthBar.alpha = badOptions.hudOpacity / 100;
            state.healthBarBG.alpha = badOptions.hudOpacity / 100;
        } else {
            state.healthBar.visible = false;
            state.healthBarBG.visible = false;
            if (!state.isMinimalMode) {
                if (iconP1 != null) iconP1.visible = false;
                if (iconP2 != null) iconP2.visible = false;
            }
        }

        // Health Icon Positions
        if (!state.isMinimalMode) {
            switch (badOptions.healthIconPosition) {
                case "off":
                    if (iconP1 != null) iconP1.visible = false;
                    if (iconP2 != null) iconP2.visible = false;
                case "vanilla":
                case "flipped":
                    if (iconP1 != null) iconP1.flipX = false;
                    if (iconP2 != null) iconP2.flipX = true;
                case "ends":
                    var healthBarX:Float = state.healthBar.x;
                    var healthBarY:Float = state.healthBar.y;
                    var healthBarWidth:Float = state.healthBar.width;
                    if (iconP1 != null) iconP1.autoUpdate = false;
                    if (iconP2 != null) iconP2.autoUpdate = false;
                    if (badOptions.healthBarPosition == "vertical") {
                        if (iconP1 != null) iconP1.y = healthBarY + (healthBarWidth / 2) - (state.iconP1.width / 2);
                        if (iconP2 != null) iconP2.y = healthBarY - (healthBarWidth / 2) - (state.iconP2.width / 2);
                        if (iconP1 != null) iconP1.x = healthBarX + (healthBarWidth / 2) - (state.iconP1.width / 2);
                        if (iconP2 != null) iconP2.x = healthBarX + (healthBarWidth / 2) - (state.iconP2.width / 2);
                    } else {
                        // Center icons vertically relative to the health bar
                        if (iconP1 != null) iconP1.y = healthBarY - (iconP1.height / 2);
                        if (iconP2 != null) iconP2.y = healthBarY - (iconP2.height / 2);
                        if (iconP1 != null) iconP1.x = healthBarX + healthBarWidth - (iconP1.width / 2);
                        if (iconP2 != null) iconP2.x = healthBarX - (iconP2.width / 2);
                    }
            }
        }

        // Icon Colored Health Bar
        if (badOptions.iconColors) {
            var bfHealthColor = getDominantColor(iconP1);
            var opponentHealthColor = getDominantColor(iconP2);
            state.healthBar.createFilledBar(opponentHealthColor, bfHealthColor);
            state.healthBar.updateBar();
        }
    }

    // bop for icons, I think onBeatHit is better than onUpdate and fixes it ?
    override function onBeatHit(event:SongTimeScriptEvent) { if (state != null && iconP1 != null && !state.isMinimalMode) updateIconsPosition(); }

    override function onUpdate(event:UpdateScriptEvent) { if (state != null && iconP1 != null && !state.isMinimalMode && event.healthChange != 0) updateIconsPosition(); }

    // Helper Methods
    function getDominantColor(sprite:FlxSprite) {
        if (sprite == null || sprite.pixels == null) return;

        var colorData = [];
        var maxCount = 0;
        var dominantColor = 0xFFFFFFFF;

        for (y in 0...sprite.frameHeight) {
            for (x in 0...sprite.frameWidth) {
                var color = sprite.pixels.getPixel32(x, y);
                if (color == 0) continue;
                if (color.alphaFloat <= 0.05) continue;

                var found = false;
                for (data in colorData) {
                    if (data.color == color) {
                        data.count++;
                        found = true;
                        break;
                    }
                }

                // Add new color if not found
                if (!found) colorData.push({ color: color, count: 1 });
            }
        }

        for (data in colorData) {
            if (data.color == 0xFFF000000 || data.color == 0x00FFFFFF) continue;

            if (data.count > maxCount) {
                maxCount = data.count;
                dominantColor = data.color;
            }
        }
        colorData = [];
        return dominantColor;
    }

    function updateIconsPosition() {
        // Vertical Health Icons (WORKING SOMEHOW)
        if (badOptions.healthBarPosition == "vertical" && (badOptions.healthIconPosition == "vanilla" || badOptions.healthIconPosition == "flipped")) {
            var healthBarX:Float = state.healthBar.x;
            var healthBarY:Float = state.healthBar.y;
            var healthBarWidth:Float = state.healthBar.width;
            var yCentering:Float = healthBarWidth / 2 - 15;
            var gapReduction:Float = 5;

            // Move icons horizontally relative to health bar
            iconP1.y = healthBarY
            + (healthBarWidth * (FlxMath.remapToRange(state.healthBar.value, 0, 2, 100, 0) * 0.01) - yCentering
            - HealthIcon.POSITION_OFFSET);
            iconP2.y = healthBarY
            + (healthBarWidth * (FlxMath.remapToRange(state.healthBar.value, 0, 2, 100, 0) * 0.01) - yCentering + gapReduction)
            - (iconP2.height - HealthIcon.POSITION_OFFSET);

            // Center icons vertically relative to the health bar
            iconP1.x = healthBarX + (healthBarWidth / 2) - (state.iconP1.width / 2);
            iconP2.x = healthBarX + (healthBarWidth / 2) - (state.iconP2.width / 2);
        }
        if (badOptions.healthIconPosition == "vanilla" || badOptions.healthIconPosition == "flipped") {
            updateHealthIcon(iconP1, state.health);
            updateHealthIcon(iconP2, Constants.HEALTH_MAX - state.health);
        }
    }

    function updateHealthIcon(icon:HealthIcon, health:Float) { if (icon != null) icon.playAnimation(health < HealthIcon.LOSING_THRESHOLD ? "losing" : health > HealthIcon.WINNING_THRESHOLD ? "winning" : "idle"); }
}