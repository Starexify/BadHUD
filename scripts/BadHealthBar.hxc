import funkin.graphics.FunkinSprite;
import funkin.modding.events.ScriptEvent;
import funkin.modding.module.ScriptedModule;
import funkin.play.PauseSubState;
import funkin.play.PlayState;
import funkin.play.character.BaseCharacter;
import funkin.play.components.HealthIcon;
import funkin.util.Constants;
import funkin.save.Save;

import flixel.FlxSprite;
import flixel.math.FlxAngle;
import flixel.math.FlxMath;
import flixel.ui.FlxBar;

class BadHealthBar extends ScriptedModule {
    var badOptions:Null<BadSaveData> = Save.instance.modOptions.get("badOptions");
    var settings;

    var playState(get, never):PlayState;
    function get_playState():PlayState { return PlayState.instance; }

    var currentP1:BaseCharacter = null;
    var currentP2:BaseCharacter = null;

    var healthBarBG:FunkinSprite;
    var healthBar:FlxBar;
    var iconP1:HealthIcon;
    var iconP2:HealthIcon;

    var iconSpacing:Float = 50;

    var healthLine:FunkinSprite;
    var lineThickness:Float = 3;
    var lineColor:Int = 0xFFFFFFFF;

    var lastHealthValue:Float = -1;
    var cachedHealthPercentage:Float = 0;

    function new() {
        super("BadHealthBar");
    }

    override function onSongLoaded(event:SongLoadScriptEvent) {
        if (playState == null) return;
        if (BadHooks.healthBarExcluded.indexOf(playState.currentChart.songName) != -1) return;
        healthBarBG = playState.healthBarBG;
        healthBar = playState.healthBar;
        iconP1 = playState.iconP1;
        iconP2 = playState.iconP2;
        if (playState.currentStage != null) {
            currentP1 = playState.currentStage.getBoyfriend();
            currentP2 = playState.currentStage.getDad();
        }

        // Health Bar
        if (badOptions.healthBar) {
            var settings = Save.instance.modOptions.get("healthBarSettings");
            if (settings != null) {
                healthBarBG.angle = healthBar.angle = settings[4];
                healthBarBG.scale.x = healthBar.scale.x = settings[2];
                healthBarBG.scale.y = healthBar.scale.y = settings[3];
                healthBarBG.updateHitbox();
                healthBarBG.setPosition(settings[0] - healthBarBG.width / 2, settings[1] - healthBarBG.height / 2);
                healthBar.setPosition(playState.healthBarBG.x + (playState.healthBarBG.width / 2) - (playState.healthBar.width / 2), playState.healthBarBG.y + (playState.healthBarBG.height / 2) - (playState.healthBar.height / 2));

                if (!playState.isMinimalMode) {
                    if (iconP1 != null) iconP1.autoUpdate = false;
                    if (iconP2 != null) iconP2.autoUpdate = false;
                }
            }

            // Icon Colored Health Bar
            updateHealthIconsColor(3);
            playState.healthBar.alpha = badOptions.hudOpacity / 100;
            playState.healthBarBG.alpha = badOptions.hudOpacity / 100;
            if (badOptions.healthIndic) createHealthIndicator();
        } else {
            playState.remove(healthBar);
            playState.remove(healthBarBG);
        }

        if (badOptions.smoothBars) playState.healthBar.numDivisions = Std.int(playState.healthBarBG.width / 1.3);

        // Health Icon Positions
        if (!playState.isMinimalMode) {
            switch (badOptions.healthIconPosition) {
                case "off":
                    playState.remove(iconP1);
                    playState.remove(iconP2);
                case "flipped":
                    if (iconP1 != null) iconP1.flipX = false;
                    if (iconP2 != null) iconP2.flipX = true;
                case "centered":
                    var position1 = calculateRotatedPosition(healthBar, 0.5, iconSpacing);
                    var position2 = calculateRotatedPosition(healthBar, 0.5, -iconSpacing);

                    if (iconP1 != null) {
                        iconP1.x = position1.x - (iconP1.width / 2);
                        iconP1.y = position1.y - (iconP1.height / 2);
                    }

                    if (iconP2 != null) {
                        iconP2.x = position2.x - (iconP2.width / 2);
                        iconP2.y = position2.y - (iconP2.height / 2);
                    }
                case "ends":
                    if (iconP1 != null) {
                        var position = calculateRotatedPosition(healthBar, 1); // Right end
                        iconP1.x = position.x - (iconP1.width / 2);
                        iconP1.y = position.y - (iconP1.height / 2);
                    }
                    if (iconP2 != null) {
                        var position = calculateRotatedPosition(healthBar, 0); // Left end
                        iconP2.x = position.x - (iconP2.width / 2);
                        iconP2.y = position.y - (iconP2.height / 2);
                    }
            }

            if (iconP1 != null) iconP1.alpha = badOptions.hudOpacity / 100;
            if (iconP2 != null) iconP2.alpha = badOptions.hudOpacity / 100;
            settings = Save.instance.modOptions.get("healthBarSettings");
            updateIconsPosition();
        }
    }

    override function onSongEvent(event:SongEventScriptEvent) {
        if (playState.currentStage == null) return;
        var newP1 = PlayState.instance.currentStage.getBoyfriend();
        var newP2 = PlayState.instance.currentStage.getDad();

        if (newP1 != currentP1 || newP2 != currentP2) {
            currentP1 = newP1;
            currentP2 = newP2;
            updateHealthIconsColor(12);
        }
    }

    // bop for icons, I think onBeatHit is better than onUpdate and fixes it ?
    override function onBeatHit(event:SongTimeScriptEvent) { if (playState != null && !playState.isMinimalMode) updateIconsPosition(); }

    override function onUpdate(event:UpdateScriptEvent) {
        if (playState != null && !playState.isMinimalMode) {
            updateIconsPosition();

            if (healthBar != null && healthBar.value != lastHealthValue) {
                lastHealthValue = healthBar.value;

                var step:Float = Constants.HEALTH_MAX / healthBar.numDivisions;
                var stepValue:Float = Math.floor(healthBar.value / step) * step;
                cachedHealthPercentage = stepValue / Constants.HEALTH_MAX;
            }

            updateHealthLinePosition();
        }
    }

    // Helper Methods
    function createHealthIndicator() {
        healthLine = new FunkinSprite().makeSolidColor(Std.int(lineThickness), Std.int(healthBar.height + 10), lineColor);
        updateHealthLinePosition();
        healthLine.camera = playState.camHUD;
        healthLine.zIndex = 802;
        playState.add(healthLine);
        healthLine.alpha = badOptions.hudOpacity / 100;
    }

    function updateHealthLinePosition() {
        if (healthLine == null || healthBar == null || !badOptions.healthIndic) return;

        var position = calculateRotatedPosition(healthBar, cachedHealthPercentage, 0, true);

        healthLine.x = position.x - (healthLine.width / 2);
        healthLine.y = position.y - (healthLine.height / 2);

        healthLine.angle = healthBar.angle;
    }

    function updateHealthIconsColor(sampleRate:Int) {
        if (badOptions.iconColors) {
            var bfHealthColor = getDominantColor(iconP1, sampleRate);
            var opponentHealthColor = getDominantColor(iconP2, sampleRate);
            if (healthBar != null) healthBar.createFilledBar(opponentHealthColor, bfHealthColor);
        }
    }

    function getDominantColor(sprite:FlxSprite, sampleRate:Int = 4) {
        if (sprite == null || sprite.pixels == null) return 0xFFFFFFFF;

        var colorData:Array<{color:Int, count:Int}> = [];
        var maxCount = 0;
        var dominantColor = 0xFFFFFFFF;

        sprite.pixels.lock();

        for (y in 0...sprite.frameHeight) {
            if (y % sampleRate != 0) continue;
            for (x in 0...sprite.frameWidth) {
                if (x % sampleRate != 0) continue;
                var color = sprite.pixels.getPixel32(x, y);

                if (color == 0 || (color >>> 24) <= 13) continue;
                if (color == 0xFFF000000 || color == 0x00FFFFFF) continue;

                var found = false;
                for (i in 0...colorData.length) {
                    if (colorData[i].color == color) {
                        colorData[i].count++;

                        if (colorData[i].count > maxCount) {
                            maxCount = colorData[i].count;
                            dominantColor = color;
                        }

                        found = true;
                        break;
                    }
                }

                // Add new color if not found
                if (!found) colorData.push({ color: color, count: 1 });
            }
        }

        sprite.pixels.unlock();
        return dominantColor;
    }

    function updateIconsPosition() {
        if (!badOptions.healthBar) return;

        // Rotate and move icons according to the Modified Bar !
        if (badOptions.healthIconPosition != "ends" && badOptions.healthIconPosition != "centered") {
            var missingHealthPercentage = FlxMath.remapToRange(healthBar.value, 0, 2, 100, 0) / 100;

            var position = calculateRotatedPosition(healthBar, missingHealthPercentage);

            var angleRad = FlxAngle.asRadians(healthBar.angle);
            var spacingOffsetX = Math.cos(angleRad) * iconSpacing;
            var spacingOffsetY = -Math.sin(angleRad) * iconSpacing;

            if (iconP1 != null) {
                iconP1.x = position.x + spacingOffsetX - (iconP1.width / 2);
                iconP1.y = position.y - spacingOffsetY - (iconP1.height / 2);
            }
            if (iconP2 != null) {
                iconP2.x = position.x - spacingOffsetX - (iconP2.width / 2);
                iconP2.y = position.y + spacingOffsetY - (iconP2.height / 2);
            }

            if (badOptions.healthIconPosition == "rotated" && settings != null) {
                if (iconP1 != null) iconP1.angle = settings[4];
                if (iconP2 != null) iconP2.angle = settings[4];
            }
        }

        if (iconP1 != null) updateHealthIcon(iconP1, playState.health);
        if (iconP2 != null) updateHealthIcon(iconP2, Constants.HEALTH_MAX - playState.health);
    }

    function calculateRotatedPosition(bar:FlxSprite, percentage:Float, offsetDistance:Float = 0, reverseDirection:Bool = false):{ x:Float, y:Float } {
        var barX:Float = bar.x;
        var barY:Float = bar.y;
        var barWidth:Float = bar.width;
        var barHeight:Float = bar.height;
        var barCenterX:Float = barX + (barWidth / 2);
        var barCenterY:Float = barY + (barHeight / 2);
        var angleRad = FlxAngle.asRadians(healthBar.angle);

        var adjustedPercentage:Float = reverseDirection ? (1 - percentage) : percentage;

        var positionX:Float = barX + (barWidth * adjustedPercentage);
        var positionY:Float = barY + (barHeight / 2);

        var relativeX:Float = positionX - barCenterX;
        var relativeY:Float = positionY - barCenterY;

        if (offsetDistance != 0) {
            // Perpendicular direction (90 degrees to the bar orientation)
            var perpX:Float = -Math.sin(angleRad) * offsetDistance;
            var perpY:Float = -Math.cos(angleRad) * offsetDistance;
            relativeX += perpX;
            relativeY += perpY;
        }

        var rotatedX:Float = (relativeX * Math.cos(angleRad)) - (relativeY * Math.sin(angleRad));
        var rotatedY:Float = (relativeX * Math.sin(angleRad)) + (relativeY * Math.cos(angleRad));

        return {x: barCenterX + rotatedX, y: barCenterY + rotatedY};
    }

    function updateHealthIcon(icon:HealthIcon, health:Float) { if (icon != null) icon.playAnimation(health < HealthIcon.LOSING_THRESHOLD ? "losing" : health > HealthIcon.WINNING_THRESHOLD ? "winning" : "idle"); }

    // Cleanup Stuff
    override function onSubStateOpenBegin(event:SubStateScriptEvent) { if (!(event.targetState is PlayState) && !(event.targetState is PauseSubState)) cleanup(); }

    override function onSubStateCloseBegin(event:SubStateScriptEvent) { if (!(event.targetState is PlayState)) cleanup(); }

    override function onSongRetry(event:ScriptEvent) { cleanup(); }

    override function onSongEnd(event:ScriptEvent) { cleanup(); }

    override function onDestroy(event:ScriptEvent) { cleanup(); }

    function cleanup() {
        if (healthLine != null) healthLine.destroy();
        healthLine = null;
        iconP1 = null;
        iconP2 = null;
    }
}