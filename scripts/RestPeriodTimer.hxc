import funkin.Paths;
import funkin.Preferences;
import funkin.graphics.FunkinSprite;
import funkin.modding.events.ScriptEvent;
import funkin.modding.module.ModuleHandler;
import funkin.modding.module.ScriptedModule;
import funkin.play.PauseSubState;
import funkin.play.PlayState;
import funkin.save.Save;

import flixel.FlxSprite;
import flixel.addons.display.FlxPieDialShape;
import flixel.addons.display.FlxRadialGauge;
import flixel.text.FlxText;
import flixel.text.FlxTextBorderStyle;
import flixel.tweens.FlxEase;
import flixel.tweens.FlxTween;

class RestPeriodTimer extends ScriptedModule {
    var badOptions:Null<BadSaveData> = Save.instance.modOptions.get("badOptions");
    var state:PlayState;

    var restBarBG:FunkinSprite;
    var restBar:FlxRadialGauge;
    var restText:FlxText;

    var restTime:Float;
    var lastHitNoteTime:Int = 0;
    var restBarSprites:Array<FlxSprite>;

    function new() {
        super("RestPeriodTimer");
    }

    override function onSongStart(event:ScriptEvent) {
        if (!badOptions.restBar) return;
        var badHooks = ModuleHandler.getModule("BadHooks");
        if (badHooks != null) state = badHooks.scriptGet("state");
        if (state == null) return;
        initRestBar();
    }

    override function onUpdate(event:UpdateScriptEvent) {
        if (state == null || !badOptions.restBar || restText == null) return;
        var restBarFadeOut = 1000; // 1s
        var restBarMinimum = 5000; // 5s
        var songPosition = state.conductorInUse.songPosition;
        var incomingNoteTime = getNextNoteAndTime(songPosition) != null ? getNextNoteAndTime(songPosition).time : 0;
        var noteTimeDelta = incomingNoteTime - lastHitNoteTime;
        restTime = incomingNoteTime - songPosition;

        if (restTime > restBarFadeOut && noteTimeDelta > restBarMinimum) {
            restText.text = Std.string(Math.round((restTime - restBarFadeOut) / 1000));
            restBar.amount = (badOptions.restBarType == "countdown") ? (restTime - restBarFadeOut) / (noteTimeDelta - restBarFadeOut) : 1 - ((restTime - restBarFadeOut) / (noteTimeDelta - restBarFadeOut));

            for (sprite in restBarSprites) if (!sprite.visible) sprite.visible = true;

            // Fade out the rest bar when time is less than 1.5s
            if (restTime <= 1500) for (sprites in restBarSprites) FlxTween.tween(sprites, { alpha: 0 }, 0.5, { ease: FlxEase.expoOut, onComplete: tween -> { sprites.visible = false; sprites.alpha = badOptions.hudOpacity / 100;} });
        }
    }

    override function onNoteHit(event:HitNoteScriptEvent) { if (event.note.noteData.getMustHitNote()) lastHitNoteTime = Std.int(event.note.noteData.time); }

    override function onNoteMiss(event:NoteScriptEvent) { if (event.note.noteData.getMustHitNote()) lastHitNoteTime = Std.int(event.note.noteData.time); }

    // Helper Methods
    function getNextNoteAndTime(currentTime:Float):{note:SongNoteData, time:Float} {
        if (state.currentChart == null || state.currentChart.notes == null) return;
        for (note in state.currentChart.notes) if (note.getMustHitNote() && note.time > currentTime) return { note: note, time: note.time };
    }

    function initRestBar() {
        restBarBG = new FunkinSprite();
        restBarBG.loadTexture("restBackground");
        restBarBG.zIndex = 800;

        restText = new FlxText(0, 0, 400, "", 32);
        restText.setFormat(Paths.font(new BadHUDOptions().font), new BadHUDOptions().fontSize, 0xFFFFFFFF, "center", FlxTextBorderStyle.OUTLINE_FAST, 0xFF000000);
        restText.borderSize = 1.75;
        restText.scrollFactor.set();
        restText.zIndex = 802;

        var restBarRadius:Int = Std.int(restBarBG.width / 2.05);
        restBar = new FlxRadialGauge();
        restBar.makeShapeGraphic(FlxPieDialShape.CIRCLE, restBarRadius, restBarRadius / 1.65, 0xFFFFFFFF);
        restBar.scrollFactor.set(0, 0);
        restBar.zIndex = 801;
        restBar.alpha = badOptions.hudOpacity / 100;

        var settings = Save.instance.modOptions.get("restBarSettings");
        if (settings != null) {
            restBarBG.angle = restText.angle = restBar.angle = settings[4];
            restBarBG.scale.x = restText.scale.x = restBar.scale.x = settings[2];
            restBarBG.scale.y = restText.scale.y = restBar.scale.y = settings[3];
            restBarBG.updateHitbox();
            restBarBG.setPosition(settings[0] - restBarBG.width / 2, settings[1] - restBarBG.height / 2);
        } else {
            restBarBG.x = state.playerStrumline.x + state.playerStrumline.width / 2 - restBarBG.width / 2;
            restBarBG.y = Preferences.downscroll ? state.playerStrumline.y - restBarBG.height : state.playerStrumline.y + restBarBG.height * 1.75;
        }

        var centerX = restBarBG.x + restBarBG.width / 2;
        var centerY = restBarBG.y + restBarBG.height / 2;
        restText.setPosition(centerX - restText.width / 2, centerY - restText.height / 2);
        restBar.setPosition(centerX - restBar.width / 2, centerY - restBar.height / 2);

        restBarSprites = [restBarBG, restBar, restText];

        for (sprite in restBarSprites) if (sprite != null) {
            sprite.cameras = [state.camHUD];
            sprite.visible = false;
            sprite.alpha = badOptions.hudOpacity / 100;
            state.add(sprite);
        }
    }

    // Cleanup stuff
    override function onSubStateOpenBegin(event:SubStateScriptEvent) { if (!Std.isOfType(event.targetState, PlayState) && !Std.isOfType(event.targetState, PauseSubState)) cleanup(); }

    override function onSubStateCloseBegin(event:SubStateScriptEvent) { if (Std.isOfType(event.targetState, PlayState)) cleanup(); }

    override function onSongRetry(event:ScriptEvent) { cleanup(); }

    override function onSongEnd(event:ScriptEvent) { cleanup(); }

    override function onDestroy(event:ScriptEvent) { cleanup(); }

    function cleanup() {
        restBar = null;
        restBarBG = null;
        restText = null;
        lastHitNoteTime = 0;
    }
}