import funkin.Highscore;
import funkin.Paths;
import funkin.modding.events.ScriptEvent;
import funkin.modding.module.ModuleHandler;
import funkin.modding.module.ScriptedModule;
import funkin.play.PauseSubState;
import funkin.play.PlayState;
import funkin.play.PlayStatePlaylist;
import funkin.save.Save;

import flixel.FlxG;
import flixel.text.FlxText;
import flixel.text.FlxTextBorderStyle;
import flixel.text.FlxTextFormat;
import flixel.text.FlxTextFormatMarkerPair;
import flixel.tweens.FlxTween;
import flixel.util.FlxStringUtil;

import Math;
import Std;

class GamePlayStats extends ScriptedModule {
    var badOptions:Null<BadSaveData> = Save.instance.modOptions.get("badOptions");
    var state:PlayState;

    var statsText:FlxText;
    var scoreTextTween;

    var judgementsText:FlxText;

    var ratingPercent:Float;
    var ratingName:String = "?";
    var ratingFC:String;

    var songScore:Int;

    var tallies:Tallies;
    var talliesLevel:Tallies;
    var sicks:Int = 0;
    var goods:Int = 0;
    var bads:Int = 0;
    var shits:Int = 0;
    var missed:Int = 0;
    var combo:Int = 0;
    var totalNotes:Int = 0;
    var totalNotesPlayed:Int = 0;

    function new() { super("GamePlayStats"); }

    override function onSongLoaded(event:SongLoadScriptEvent) {
        var badHooks = ModuleHandler.getModule("BadHooks");
        if (badHooks != null) state = badHooks.scriptGet("state");
        if (state == null) return;
        if (new BadHooks().gameplayExcludedSongs.indexOf(state.currentChart.songName) != -1) return;

        tallies = Highscore.tallies;
        var textFont = new BadHUDOptions().font;
        var textSize = badOptions.hudFontSize;

        // Remove and Init HUD Elements
        state.remove(state.scoreText);
        initJudgements(textSize, textFont);
        initStats(textSize, textFont);

        if (PlayStatePlaylist.isStoryMode) talliesLevel = Highscore.talliesLevel;
    }

    override function onCountdownStart(event:CountdownScriptEvent) {
        if (new BadHooks().gameplayExcludedSongs.indexOf(state.currentChart.songName) != -1) return;
        totalNotes = tallies.totalNotes;
        if (PlayStatePlaylist.isStoryMode) totalNotes += talliesLevel.totalNotes;
        updateScore();
        resetJudgements();
    }

    // Init Methods
    function initJudgements(textSize:Int, textFont:String) {
        judgementsText = new FlxText();
        var settings = Save.instance.modOptions.get("judgementsTextSettings");
        if (settings != null) {
            judgementsText.angle = settings[4];
            judgementsText.scale.x = settings[2];
            judgementsText.scale.y = settings[3];
            judgementsText.updateHitbox();
            judgementsText.setPosition(settings[0] - judgementsText.width / 2, settings[1] - judgementsText.height / 2);
        } else {
            judgementsText.x = 10;
            judgementsText.y = FlxG.height * 0.45;
        }
        var alignment:String = judgementsText.x >= FlxG.width / 2 ? "right" : "left";
        judgementsText.setFormat(Paths.font(textFont), textSize, 0xFFFFFFFF, alignment, FlxTextBorderStyle.OUTLINE_FAST, 0xFF000000);
        judgementsText.scrollFactor.set();
        judgementsText.borderSize = 1.25;
        judgementsText.zIndex = 851;
        judgementsText.cameras = [state.camHUD];
        state.add(judgementsText);
    }

    function initStats(textSize:Int, textFont:String) {
        statsText = new FlxText();
        statsText.setFormat(Paths.font(textFont), textSize, 0xFFFFFFFF, "center", FlxTextBorderStyle.OUTLINE_FAST, 0xFF000000);
        statsText.borderSize = 1.25;
        var settings = Save.instance.modOptions.get("statsTextSettings");
        if (settings != null) {
            statsText.angle = settings[4];
            statsText.scale.x = settings[2];
            statsText.scale.y = settings[3];
            statsText.updateHitbox();
            statsText.setPosition(settings[0] - statsText.width / 2, settings[1] - statsText.height / 2);
            statsText.alignment = statsText.x >= FlxG.width / 2 ? "right" : "left";
        } else {
            statsText.screenCenter(0x01);
            statsText.y = (badOptions.healthBar && Save.instance.modOptions.get("healthBarSettings") != null) ? state.healthBarBG.y + 45 : 40;
        }
        statsText.scrollFactor.set();
        statsText.zIndex = 851;
        statsText.cameras = [state.camHUD];
        state.add(statsText);
    }

    // Helper Methods
    function updateScore(bopScoreOnMiss:Bool = false) {
        calculateRating();

        // Change the scoring system based on accuracyType (funy)
        if (badOptions.accuracyType == "osu") {
            var maxScore = 1000000;

            var hitValue = sicks * 300 + goods * 200 + bads * 100 + shits * 50;
            var hitBonusValue = sicks * 32 + goods * 16 + bads * 8 + shits * 4;
            var hitBonus = sicks;
            var hitPunishment = goods * 8 + bads * 24 + shits * 44 + missed * 100;

            var bonus = Math.max(0, Math.min(100, hitBonus - hitPunishment));

            var baseScore = (maxScore * 0.5 / totalNotes) * (hitValue / 300);
            var bonusScore = (maxScore * 0.5 / totalNotes) * (hitBonusValue * Math.sqrt(bonus) / 300);

            songScore = Math.round(baseScore + bonusScore);
        } else songScore = state.songScore;

        if (badOptions.commaSeparatedScore) songScore = FlxStringUtil.formatMoney(songScore, false, true);

        // Update Text
        if (judgementsText != null) switch (badOptions.judgementsOrt) {
            case "left":
                judgementsText.text = "Sicks: " + sicks + "\nGoods: " + goods + "\nBads: " + bads + "\nShits: " + shits;
            case "center":
                judgementsText.text = "Sicks: " + sicks + " | Goods: " + goods + " | Bads: " + bads + " | Shits: " + shits;
            case "right":
                judgementsText.text = sicks + " Sicks\n" + goods + " Goods\n" + bads + " Bads\n" + shits + " Shits";
        }

        if (statsText != null) {
            var ratingString = totalNotesPlayed != 0 ? ratingPercent + "% - " + ratingFC : ratingName;
            var tempScore:String = "Score: " + songScore + " | Combo Breaks: " + missed + " | Rating: " + ratingString;
            switch (badOptions.statsOrt) {
                case "left":
                    tempScore = "Score: " + songScore + "\nCombo Breaks: " + missed + "\nRating: " + ratingString + "\nCombo: " + combo;
                case "center":
                    if (badOptions.accuracyType == "psych") ratingString = totalNotesPlayed != 0 ? ratingName + " (" + ratingPercent + "%) - " + ratingFC : ratingName;
                    tempScore = "Score: " + songScore + " | Combo Breaks: " + missed + " | Rating: " + ratingString;
                case "right":
                    tempScore = songScore + " Score\n" + missed + " Combo Breaks\n" + ratingString + " Rating\n" + combo + " Combo";
            }
            statsText.text = tempScore;
            if (badOptions.accuracyType == "vanilla") {
                var formatPairs = [
                    new FlxTextFormatMarkerPair(new FlxTextFormat(0xFFF25C), "<$>"), // P+
                    new FlxTextFormatMarkerPair(new FlxTextFormat(0xFFA9FF), "<p>"), // P
                    new FlxTextFormatMarkerPair(new FlxTextFormat(0xFDFCB7), "<e>"), // E
                    new FlxTextFormatMarkerPair(new FlxTextFormat(0xEBF7FF), "<&>"), // G
                    new FlxTextFormatMarkerPair(new FlxTextFormat(0xED9C7A), "<g>"), // G
                    new FlxTextFormatMarkerPair(new FlxTextFormat(0x6B8CFF), "<l>"), // L
                ];
                statsText.applyMarkup(tempScore, formatPairs);
            }
        }

        if (bopScoreOnMiss) scoreBopOnMiss();
    }

    function scoreBopOnMiss() {
        if (badOptions.statsOrt == "center" || badOptions.accuracyType == "psych") return;

        if (scoreTextTween != null) scoreTextTween.cancel();
        statsText.scale.set(1.075, 1.075);
        scoreTextTween = FlxTween.tween(statsText.scale, {x: 1, y: 1}, 0.2, { onComplete: tween -> scoreTextTween = null });
    }

    function calculateRating() {
        if (totalNotesPlayed != 0) {
            //ratingPercent = Math.min(1, Math.max(0, totalNotesHit / totalNotesPlayed)); // Old rating percent
            switch (badOptions.accuracyType) {
                case "vanilla":
                    ratingPercent = Std.int(Math.min(100, Math.max(0, 100 - (shits + bads + missed) / totalNotes * 100)));
                case "psych":
                    ratingPercent = Math.min(100, Math.max(0, 100 - ((sicks * 0 + goods * 0.33 + bads * 0.67 + shits * 1) / totalNotes) * 100));
                    ratingPercent = Math.round(ratingPercent * 100) / 100;
                    for (rating in new BadHooks().ratings) {
                        if (ratingPercent >= rating.min && ratingPercent <= rating.max) ratingName = rating.name;
                    }
                case "osu":
                    ratingPercent = Math.min(100, Math.max(0, ((300 * sicks + 200 * goods + 100 * bads + 50 * shits) / (300 * (sicks + goods + bads + shits + missed))) * 100));
                    ratingPercent = Math.round(ratingPercent * 100) / 100;
            }
        } else {
            ratingName = "?";
            ratingPercent = 0;
        }

        ratingFC = "";

        // Rating grades based on AccuracyType
        switch (badOptions.accuracyType) {
            case "vanilla": ratingFC = vanillaRatingNames();
            case "psych": ratingFC = psychRatingNames();
            case "osu": ratingFC = osuGrades();
        }
    }

    function vanillaRatingNames() {
        return if (ratingPercent == 100 && goods == 0) "<$>P<$> (Perfect+)";
        else if (ratingPercent == 100 && goods >= 1) "<p>P<p> (Perfect)";
        else if (ratingPercent >= 90) "<e>E<e> (Excellent)";
        else if (ratingPercent >= 80) "<&>G<&> (Great)";
        else if (ratingPercent >= 60) "<g>G<g> (Good)";
        else "<l>L<l> (Loss)";
    }

    function psychRatingNames() {
        return if (missed == 0) {
            if (shits == 0 && bads == 0 && goods == 0) "PFC";
            else if (shits > 0 || bads > 0) "FC";
            else if (goods > 0) "GFC";
            else if (sicks > 0) "SFC";
        } else if (missed < 10) "SDCB";
        else "Clear";
    }

    function osuGrades() {
        return if (ratingPercent == 100) "SS";
        else if (ratingPercent > 95) "S";
        else if (ratingPercent > 90) "A";
        else if (ratingPercent > 80) "B";
        else if (ratingPercent > 70) "C";
        else "D";
    }

    function resetJudgements() {
        combo = tallies.combo;
        sicks = tallies.sick;
        goods = tallies.good;
        bads = tallies.bad;
        shits = tallies.shit;
        missed = tallies.missed;
        totalNotesPlayed = tallies.totalNotesHit;
        if (PlayStatePlaylist.isStoryMode) {
            sicks += talliesLevel.sick;
            goods += talliesLevel.good;
            bads += talliesLevel.bad;
            shits += talliesLevel.shit;
            missed += talliesLevel.missed;
            totalNotesPlayed += talliesLevel.totalNotesHit;
        }
    }

    // Events for updating score and judgements
    override function onUpdate(event:UpdateScriptEvent) { if (state != null) updateScore(); }

    override function onNoteHit(event:HitNoteScriptEvent) {
        if (!event.note.noteData.getMustHitNote() || state == null) return;
        if (new BadHooks().gameplayExcludedSongs.indexOf(state.currentChart.songName) != -1) return;

        if (combo >= 0) combo = tallies.combo + 1;

        switch (event.judgement) {
            case "sick":
                if (sicks >= 0) sicks = (PlayStatePlaylist.isStoryMode ? talliesLevel.sick + tallies.sick : tallies.sick) + 1;
            case "good":
                if (goods >= 0) goods = (PlayStatePlaylist.isStoryMode ? talliesLevel.good + tallies.good : tallies.good) + 1;
            case "bad":
                if (bads >= 0) bads = (PlayStatePlaylist.isStoryMode ? talliesLevel.bad + tallies.bad : tallies.bad) + 1;
            case "shit":
                if (shits >= 0) shits = (PlayStatePlaylist.isStoryMode ? talliesLevel.shit + tallies.shit : tallies.shit) + 1;
        }

        totalNotesPlayed = (PlayStatePlaylist.isStoryMode ? talliesLevel.totalNotesHit + tallies.totalNotesHit : tallies.totalNotesHit) + 1;

        updateScore(badOptions.accuracyType != "osu");
    }

    override function onNoteMiss(event:NoteScriptEvent) {
        if (new BadHooks().gameplayExcludedSongs.indexOf(state.currentChart.songName) != -1) return;
        combo = 0;
        if (missed >= 0) missed = PlayStatePlaylist.isStoryMode ? talliesLevel.missed + tallies.missed + 1 : tallies.missed + 1;
        updateScore();
    }

    override function onNoteGhostMiss(event:GhostMissNoteScriptEvent) {
        if (new BadHooks().gameplayExcludedSongs.indexOf(state.currentChart.songName) != -1) return;
        updateScore();
    }

    // Cleanup stuff
    override function onSubStateOpenBegin(event:SubStateScriptEvent) { if (!Std.isOfType(event.targetState, PlayState) && !Std.isOfType(event.targetState, PauseSubState)) cleanup(); }

    override function onSubStateCloseBegin(event:SubStateScriptEvent) { if (Std.isOfType(event.targetState, PlayState)) cleanup(); }

    override function onSongEnd(event:ScriptEvent) { cleanup(); }

    override function onSongRetry(event:ScriptEvent) { cleanup(); }

    override function onDestroy(event:ScriptEvent) { cleanup(); }

    function cleanup() {
        if (statsText != null) {
            statsText.destroy();
            statsText = null;
        }
        if (judgementsText != null) {
            judgementsText.destroy();
            judgementsText = null;
        }

        if (!PlayStatePlaylist.isStoryMode) {
            ratingPercent = 0;
            ratingName = "?";
            ratingFC = "";
        }

        totalNotesPlayed = 0;
        songScore = 0;

        scoreTextTween = null;
    }
}