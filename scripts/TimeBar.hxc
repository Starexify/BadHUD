import funkin.Paths;
import funkin.Preferences;
import funkin.graphics.FunkinSprite;
import funkin.modding.events.ScriptEvent;
import funkin.modding.module.ModuleHandler;
import funkin.modding.module.ScriptedModule;
import funkin.play.PauseSubState;
import funkin.play.PlayState;
import funkin.save.Save;

import flixel.FlxG;
import flixel.FlxSprite;
import flixel.text.FlxTextBorderStyle;
import flixel.text.FlxText;
import flixel.tweens.FlxEase;
import flixel.tweens.FlxTween;
import flixel.util.FlxStringUtil;
import flixel.ui.FlxBar;

import Std;

class TimeBar extends ScriptedModule {
    var badOptions:Null<BadSaveData> = Save.instance.modOptions.get("badOptions");
    var state:PlayState;

    var timeBarBG:FunkinSprite;
    var timeBar:FlxBar;
    var timeText:FlxText;

    var timeBarSprites:Array<FlxSprite>;

    function new() {
        super("TimeBar");
    }

    override function onSongLoaded(event:SongLoadScriptEvent) {
        if (!badOptions.timeBar) return;
        var badHooks = ModuleHandler.getModule("BadHooks");
        if (badHooks != null) state = badHooks.scriptGet("state");
        if (state == null) return;
        initTimeBar();
    }

    function initTimeBar() {
        timeText = new FlxText();
        timeText.setFormat(Paths.font(new BadHUDOptions().font), 21, 0xFFFFFFFF, "center", FlxTextBorderStyle.OUTLINE, 0xFF000000);
        timeText.size = 21;
        timeText.borderSize = 1.75;
        timeText.scrollFactor.set();
        if (!state.isMinimalMode) timeText.zIndex = state.iconP1.zIndex + 1;

        timeBarBG = new FunkinSprite();
        timeBarBG.loadTexture(badOptions.timeBarStyle);
        timeBarBG.scrollFactor.set(0, 0);
        timeBarBG.zIndex = 800;
        timeText.fieldWidth = timeBarBG.width;

        var timeBarHeight = badOptions.timeBarStyle == "timeBarMinimalRounded" ? 4 : 6;
        timeBar = new FlxBar(0, 0, null, Std.int(timeBarBG.width - 5), Std.int(timeBarBG.height - timeBarHeight));
        timeBar.createFilledBar(0xFF000000, 0xFFFFFFFF);
        timeBar.scrollFactor.set();
        timeBar.zIndex = badOptions.timeBarStyle == "timeBarMinimalRounded" ? 799 : 801;

        var timeBarSettings = Save.instance.modOptions.get("timeBarSettings");
        if (timeBarSettings != null) {
            timeText.angle = timeBarBG.angle = timeBar.angle = timeBarSettings[4];
            timeText.scale.x = timeBarBG.scale.x = timeBar.scale.x = timeBarSettings[2];
            timeText.scale.y = timeBarBG.scale.y = timeBar.scale.y = timeBarSettings[3];
            timeText.updateHitbox();
            timeText.setPosition(timeBarSettings[0] - timeText.width / 2, timeBarSettings[1] - timeText.height / 2);
        } else {
            timeText.screenCenter(0x01);
            timeText.y = Preferences.downscroll ? FlxG.height * 0.05 : FlxG.height * 0.95;
        }

        var centerX = timeText.x + timeText.width / 2;
        var centerY = timeText.y + timeText.height / 2;
        timeBarBG.setPosition(centerX - timeBarBG.width / 2, centerY - timeBarBG.height / 2);
        timeBar.setPosition(centerX - timeBar.width / 2, centerY - timeBar.height / 2);

        if (badOptions.smoothBars) timeBar.numDivisions = Std.int(timeBarBG.width);

        timeBarSprites = [timeBarBG, timeBar, timeText];

        for (sprite in timeBarSprites) if (sprite != null) {
            sprite.alpha = 0;
            sprite.cameras = [state.camHUD];
        }

        if (badOptions.timeBarStyle != "off") {
            state.add(timeBarBG);
            state.add(timeBar);
        }
        state.add(timeText);
    }

    override function onSongStart(event:ScriptEvent) {
        for (sprite in timeBarSprites)
            if (sprite != null && sprite.alpha != (badOptions.hudOpacity / 100))
                FlxTween.tween(sprite, {alpha: badOptions.hudOpacity / 100}, 0.5, { ease: FlxEase.circOut, onComplete: tween -> state.refresh() });
    }

    override function onUpdate(event:UpdateScriptEvent) {
        if (state == null || !badOptions.timeBar) return;
        if (timeBar != null && timeBar.visible) {
            timeBar.value = (state.conductorInUse.songPosition / state.currentSongLengthMs) * 100;
            timeBar.updateBar();
        }
        if (timeText != null) switch (badOptions.timeBarType) {
            case "left": timeText.text = FlxStringUtil.formatTime((state.currentSongLengthMs - state.conductorInUse.songPosition) / 1000, false);
            case "left-total": timeText.text = FlxStringUtil.formatTime((state.currentSongLengthMs - state.conductorInUse.songPosition) / 1000, false) + " / " + FlxStringUtil.formatTime(state.currentSongLengthMs / 1000, false);
            case "elapsed": timeText.text = FlxStringUtil.formatTime((state.conductorInUse.songPosition) / 1000, false);
            case "elapsed-total": timeText.text = FlxStringUtil.formatTime((state.conductorInUse.songPosition) / 1000, false) + " / " + FlxStringUtil.formatTime(state.currentSongLengthMs / 1000, false);
            case "elapsed-left": timeText.text = FlxStringUtil.formatTime((state.conductorInUse.songPosition) / 1000, false) + " / " + FlxStringUtil.formatTime((state.currentSongLengthMs - state.conductorInUse.songPosition) / 1000, false);
            case "name": timeText.text = state.currentChart.songName;
        }
    }

    // Cleanup stuff
    override function onSongRetry(event:ScriptEvent) { for (sprite in timeBarSprites) if (sprite != null) sprite.visible = false; }

    override function onSubStateOpenBegin(event:SubStateScriptEvent) { if (!Std.isOfType(event.targetState, PlayState) && !Std.isOfType(event.targetState, PauseSubState)) cleanup(); }

    override function onSubStateCloseBegin(event:SubStateScriptEvent) { if (Std.isOfType(event.targetState, PlayState)) cleanup(); }

    override function onSongEnd(event:ScriptEvent) { cleanup(); }

    override function onDestroy(event:ScriptEvent) { cleanup(); }

    function cleanup() {
        if (timeBarSprites != null) for (sprite in timeBarSprites) if (sprite != null) FlxTween.tween(sprite, { alpha: 0 }, 0.5, { ease: FlxEase.circOut });
        timeBarBG = null;
        timeBar = null;
        timeText = null;
    }
}