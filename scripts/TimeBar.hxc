import funkin.modding.module.Module;
import funkin.Paths;
import funkin.graphics.FunkinSprite;
import funkin.modding.module.ModuleHandler;
import funkin.play.PauseSubState;
import funkin.play.PlayState;
import funkin.save.Save;

import flixel.FlxG;
import flixel.FlxSprite;
import flixel.text.FlxTextBorderStyle;
import flixel.text.FlxText;
import flixel.tweens.FlxEase;
import flixel.tweens.FlxTween;
import flixel.util.FlxStringUtil;
import flixel.ui.FlxBar;

import Std;

// This script may have used some code from other scripts so i´ll leave some credits below
/*
Psych Engine HUD V-Slice by nubz4lif
OG Psych Engine HUD by Shadow Mario and his team
*/
class TimeBar extends Module {
    var state:PlayState;

    var timeBarBG:FunkinSprite;
    var timeBar:FlxBar;
    var timeText:FlxText;

    var timeBarSprites:Array<FlxSprite>;

    function new() {
        super("TimeBar");
    }

    override function onSongLoaded(event:SongLoadScriptEvent) {
        if (Save.instance.modOptions.get("badOptions").timebarPosition == "off") return;
        var badHooks = ModuleHandler.getModule('BadHooks');
        if (badHooks != null) state = badHooks.scriptGet('state');
        if (state == null) return;
        initTimeBar();
    }

    function initTimeBar() {
        // Binding with BadHUDOptions
        var badHUDOptions = new BadHUDOptions();

        var timeBarXPosV = FlxG.width * 0.82;
        var timeBarYPosV = FlxG.height * 0.5;

        timeBarBG = FunkinSprite.create(0, 0, badHUDOptions.timeBarBGStyle);
        timeBarBG.scrollFactor.set(0, 0);
        timeBarBG.zIndex = 800;

        var timeBarHeight = timeBarBG.height - (Save.instance.modOptions.get("badOptions").timeBarType == "off" ? 6 : 4);
        timeBar = new FlxBar(0, 0, null, timeBarBG.width - 5, timeBarHeight);
        timeBar.createFilledBar(0xFF000000, 0xFFFFFFFF);
        timeBar.scrollFactor.set();
        timeBar.zIndex = Save.instance.modOptions.get("badOptions").timebarStyle == "minimal-rounded" ? 799 : 801;

        if (Save.instance.modOptions.get("badOptions").smoothBars) timeBar.numDivisions = Std.int(timeBarBG.width);

        timeText = new FlxText(0, 0, 400, "", 32);
        timeText.setFormat(Paths.font(badHUDOptions.font), badHUDOptions.timeTextSize, 0xFFFFFFFF, "center", FlxTextBorderStyle.OUTLINE, 0xFF000000);
        timeText.borderSize = 1.75;
        timeText.scrollFactor.set();
        timeText.zIndex = 802;

        switch (Save.instance.modOptions.get("badOptions").timebarPosition) {
            case "off":
            case "down":
                timeText.y = FlxG.height - 34;
                timeBarBG.y = FlxG.height - 34 + 2;
                if (Save.instance.modOptions.get("badOptions").hudFont == 0) {
                    timeBarBG.y = timeText.y + 5;
                }
            case "up":
                timeText.y = 16;
                timeBarBG.y = timeText.y + 2;
                if (Save.instance.modOptions.get("badOptions").hudFont == 0) {
                    timeBarBG.y = timeText.y + 5;
                }
            case "vertical": // (Right Side)
                timeText.x = timeBarXPosV;
                timeText.y = timeBarYPosV;
                timeBarBG.x = timeBarXPosV + (timeText.height / 5);
                timeBarBG.y = timeBarYPosV;
                timeText.angle = timeBarBG.angle = timeBar.angle = 90;
                if (!state.isMinimalMode) timeText.zIndex = state.iconP1.zIndex + 1;
        }

        timeBar.x = timeBarBG.x + 3;
        timeBar.y = timeBarBG.y + (Save.instance.modOptions.get("badOptions").timeBarType == "off" ? 3 : 2);

        timeBarSprites = [timeBarBG, timeBar, timeText];

        for (sprite in timeBarSprites) if (sprite != null) {
            if (!Save.instance.modOptions.get("badOptions").timebarPosition == "vertical") sprite.screenCenter(0x01); // Vertical Time Bar
            state.add(sprite);

            // Move the time bar to the HUD camera.
            sprite.cameras = [state.camHUD];
            sprite.alpha = 0;
        }
    }

    override function onSongStart(event:ScriptEvent) {
        for (sprite in timeBarSprites)
            if (sprite != null && sprite.alpha != (Save.instance.modOptions.get("badOptions").hudOpacity / 100))
                FlxTween.tween(sprite, {alpha: Save.instance.modOptions.get("badOptions").hudOpacity / 100}, 0.5, { ease: FlxEase.circOut });
    }

    override function onUpdate(event:UpdateScriptEvent) {
        if (state == null || Save.instance.modOptions.get("badOptions").timebarPosition == "off") return;
        if (timeBar != null && timeBar.visible) {
            timeBar.value = (state.conductorInUse.songPosition / state.currentSongLengthMs) * 100;
            timeBar.updateBar();
            switch (Save.instance.modOptions.get("badOptions").timebarType) {
                case "off":
                case "left":
                    timeText.text = FlxStringUtil.formatTime((state.currentSongLengthMs - state.conductorInUse.songPosition) / 1000, false);
                case "left-total":
                    timeText.text = FlxStringUtil.formatTime((state.currentSongLengthMs - state.conductorInUse.songPosition) / 1000, false) + " / " + FlxStringUtil.formatTime(state.currentSongLengthMs / 1000, false);
                case "elapsed":
                    timeText.text = FlxStringUtil.formatTime((state.conductorInUse.songPosition) / 1000, false);
                case "elapsed-total":
                    timeText.text = FlxStringUtil.formatTime((state.conductorInUse.songPosition) / 1000, false) + " / " + FlxStringUtil.formatTime(state.currentSongLengthMs / 1000, false);
                case "elapsed-left":
                    timeText.text = FlxStringUtil.formatTime((state.conductorInUse.songPosition) / 1000, false) + " / " + FlxStringUtil.formatTime((state.currentSongLengthMs - state.conductorInUse.songPosition) / 1000, false);
                case "name":
                    timeText.text = state.currentChart.songName;
            }
        }
    }

    // Cleanup stuff
    override function onSongRetry(event:ScriptEvent) {
        var stuffToHide = [timeBarBG, timeBar, timeText];
        for (thing in stuffToHide) if (thing != null) thing.visible = false;
    }

    override function onSubStateOpenBegin(event:SubStateScriptEvent) { if (!Std.isOfType(event.targetState, PlayState) && !Std.isOfType(event.targetState, PauseSubState)) cleanup(); }

    override function onSubStateCloseBegin(event:SubStateScriptEvent) { if (Std.isOfType(event.targetState, PlayState)) cleanup(); }

    override function onSongEnd(event:ScriptEvent) { cleanup(); }

    override function onDestroy(event:ScriptEvent) { cleanup(); }

    function cleanup() {
        if (timeBarSprites != null) for (sprite in timeBarSprites) if (sprite != null) FlxTween.tween(sprite, { alpha: 0 }, 0.5, {ease: FlxEase.circOut});
        timeBarBG = null;
        timeBar = null;
        timeText = null;
    }
}