import funkin.modding.events.ScriptEvent;
import funkin.modding.module.ModuleHandler;
import funkin.modding.module.ScriptedModule;
import funkin.play.PauseSubState;
import funkin.play.PlayState;
import funkin.save.Save;

import flixel.FlxG;
import flixel.text.FlxText;
import flixel.text.FlxTextBorderStyle;
import flixel.tweens.FlxEase;
import flixel.tweens.FlxTween;
import flixel.util.FlxColor;

class CustomScrollSpeed extends ScriptedModule {
    var badOptions:Null<BadSaveData> = Save.instance.modOptions.get("badOptions");
    var state:PlayState;

    var speedText:FlxText;

    function new() {
        super("CustomScrollSpeed");
    }

    override function onSongLoaded(event:SongLoadScriptEvent) {
        if (!badOptions.customScrollSpeed) return;
        var badHooks = ModuleHandler.getModule('BadHooks');
        if (badHooks != null) state = badHooks.scriptGet('state');
        if (state == null) return;
        state.playerStrumline.scrollSpeed = badOptions.scrollSpeedFactor / 10;
        state.opponentStrumline.scrollSpeed = badOptions.scrollSpeedFactor / 10;
    }

    override function onSongStart(event) {
        if (!badOptions.customScrollSpeed) return;
        state.playerStrumline.scrollSpeed = badOptions.scrollSpeedFactor / 10;
        state.opponentStrumline.scrollSpeed = badOptions.scrollSpeedFactor / 10;
    }

    override function onSubStateOpenEnd(event:SubStateScriptEvent) {
        if (!badOptions.customScrollSpeed) return;
        if (Std.isOfType(event.targetState, PauseSubState)) {
            // Create Scroll Speed Text Element
            var pauseState:PauseSubState = event.targetState;
            speedText = new FlxText(24, pauseState.offsetText.y - 40, FlxG.width - 40, "Current Scroll Speed: " + Math.round(state.playerStrumline.scrollSpeed * 10) / 10 + "\nSet Scroll Speed: " + badOptions.scrollSpeedFactor / 10);
            speedText.setFormat(Paths.font('vcr.ttf'), 16, FlxColor.WHITE, "right");
            speedText.scrollFactor.set(0, 0);
            speedText.alpha = 0;
            pauseState.add(speedText);

            FlxTween.tween(speedText, {alpha: 1, y: speedText.y + 5}, 1.8, { ease: FlxEase.quartOut, startDelay: 0.4 });
        }
    }

    override function onSubStateCloseBegin(event:SubStateScriptEvent) { cleanup(); }

    override function onDestroy(event:ScriptEvent) { cleanup(); }

    function cleanup() {
        if (speedText != null) {
            speedText.destroy();
            speedText = null;
        }
    }
}