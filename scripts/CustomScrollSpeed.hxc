import funkin.modding.module.Module;
import funkin.Paths;
import funkin.modding.module.ModuleHandler;
import funkin.play.PlayState;
import funkin.save.Save;

import flixel.FlxG;
import flixel.text.FlxText;
import flixel.text.FlxTextBorderStyle;

import Math;

class CustomScrollSpeed extends Module {
    var badOptions:Null<Dynamic> = Save.instance.modOptions.get("badOptions");
    var state:PlayState;

    var speedText:FlxText;

    function new() {
        super("CustomScrollSpeed");
    }

    override function onSongLoaded(event:SongLoadScriptEvent) {
        if (!badOptions.customScrollSpeed) return;
        var badHooks = ModuleHandler.getModule('BadHooks');
        if (badHooks != null) state = badHooks.scriptGet('state');
        if (state == null) return;
        state.playerStrumline.scrollSpeed = badOptions.scrollSpeedFactor / 10;
        state.opponentStrumline.scrollSpeed = badOptions.scrollSpeedFactor / 10;
    }

    override function onPause(event:PauseScriptEvent) {
        if (!badOptions.customScrollSpeed) return;
        // Binding with BadHUDOptions for size
        var textSize = badOptions.hudFontSize;

        // Create Scroll Speed Text Element
        speedText = new FlxText(20, FlxG.height * 0.94, FlxG.width - 40, "", 20);
        speedText.setFormat(Paths.font(new BadHUDOptions().font), textSize, 0xFFFFFFFF, "left", FlxTextBorderStyle.OUTLINE_FAST, 0xFF000000);
        speedText.scrollFactor.set(0, 0);
        speedText.alignment = "right";
        speedText.cameras = [state.camHUD];
        speedText.text = "Current Scroll Speed: " + Math.round(state.playerStrumline.scrollSpeed * 10) / 10 + "\nSet Scroll Speed: " + badOptions.scrollSpeedFactor / 10;
        state.add(speedText);
    }

    override function onSubStateCloseBegin(event:SubStateScriptEvent) { cleanup(); }

    override function onDestroy(event:ScriptEvent) { cleanup(); }

    function cleanup() {
        if (speedText != null) {
            speedText.destroy();
            speedText = null;
        }
    }
}