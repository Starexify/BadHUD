import funkin.modding.module.Module;
import funkin.Paths;
import funkin.play.PlayState;

import flixel.FlxG;
import flixel.text.FlxText;
import flixel.text.FlxTextBorderStyle;
import flixel.util.FlxSave;

import Std;
import Math;

class CustomScrollSpeed extends Module {
    var save:FlxSave;
	var loaded:Boolean = false;
	var state:PlayState;

    var speedText:FlxText;

    function new() {
		super("CustomScrollSpeed");
		save = new FlxSave();
		save.bind("BadHUDOptions", "FunkinCrew/BadHUD");
	}

    override function onSongLoaded(event:SongLoadScriptEvent) {
		super.onSongLoaded(event);
        if (!loaded && save.data.customScrollSpeed) {
            state = PlayState.instance;
            setSpeed(state);

            // Binding with BadHUDOptions for font and size
            badHUDOptions = new BadHUDOptions();
            font = badHUDOptions.font;
            textSize = save.data.hudFontSize;

            // Create Scroll Speed Text Element
            speedText = new FlxText(20, FlxG.height * 0.94, FlxG.width - 40, "", 20);
			speedText.setFormat(Paths.font(font), textSize, 0xFFFFFFFF, "left", FlxTextBorderStyle.OUTLINE, 0xFF000000);
			speedText.scrollFactor.set(0, 0);
            speedText.alignment = "right";
            speedText.cameras = [state.camHUD];
			state.add(speedText);
            
            loaded = true;
        }
    }

    function onSongEnd() { loaded = false; }

    override function onCountdownStart(event:CountdownScriptEvent) {
        super.onCountdownStart(event);
        // Fix for scroll speed resetting on song reset
        if (!loaded || state == null) return;
        setSpeed(state);
    }

    override function onUpdate(event:UpdateScriptEvent) {
        super.onUpdate(event);
        if (!loaded || state == null) return;

        if (speedText != null) {
            if (state.isGamePaused) {
                speedText.visible = true;
                speedText.text = "Current Scroll Speed: " + Math.round(state.playerStrumline.scrollSpeed * 10) / 10 + "\nSet Scroll Speed: " + Math.round(save.data.scrollSpeedFactor * 10) / 10;
            } else {
                speedText.visible = false;
            }
        }
    }

    override function onStateChangeEnd(event:StateChangeScriptEvent) {
		super.onStateChangeEnd(event);
		if (!Std.isOfType(event.targetState, PlayState)) {            
            loaded = false;
        }
    }

    function setSpeed(state:PlayState) {
        state.playerStrumline.scrollSpeed = Math.round(save.data.scrollSpeedFactor * 10) / 10;
        state.opponentStrumline.scrollSpeed = Math.round(save.data.scrollSpeedFactor * 10) / 10;
    }
}