import funkin.Assets;
import funkin.Paths;
import funkin.Preferences;
import funkin.save.Save;
import funkin.modding.events.ScriptEvent;
import funkin.modding.module.Module;
import funkin.ui.options.OptionsState;
import funkin.ui.options.PreferencesMenu;
import funkin.ui.options.items.NumberPreferenceItem;

import openfl.text.TextFormat;

import Main;
import Std;

class BadHUDOptions extends Module {
    var badOptions:BadSaveData = Save.instance.modOptions.get("badOptions");

    // Hooks or smth like that for other classes
    var font;
    var timeBarBGStyle;
    var timeTextSize;

    var saveObject:BadSaveData = {
        middlescroll: false,
        opponentNoteOpacity: 100,
        healthBar: true,
        healthIconPosition: "vanilla",
        timebarPosition: "down",
        timebarType: "left",
        timebarStyle: "psych",
        restBar: "off",
        smoothBars: true,
        iconColors: true,
        leftPos: "judgements",
        hudOpacity: 100,
        hudFont: 0,
        hudFontSize: 21,
        accuracyType: "vanilla",
        commaSeparatedScore: false,
        popUpType: "vanilla",
        remindKeys: true,
        muteMiss: true,
        underlayOpacity: 0,
        kpsCounter: false,
        customScrollSpeed: false,
        scrollSpeedFactor: 18
    };

    function new() {
        super("BadHUDOptions", 1);
        // Default Options (First Start)
        if (!Save.instance.modOptions.exists("badOptions")) Save.instance.modOptions.set("badOptions", saveObject);
        else updatetypetext();
        Save.instance.flush();

        changeDebugDisplay(font);
    }

    override function onStateChangeEnd(event:StateChangeScriptEvent) {
        if (Std.isOfType(event.targetState, OptionsState)) {
            var preferences:PreferencesMenu = event.targetState.pages.get("preferences");
            if (preferences != null) {
                updatetypetext();
                Save.instance.flush();

                preferences.createPrefItemCheckbox("Middlescroll", "If enabled, player notes will be centerd on the screen, and opponent's notes will be split.", value -> badOptions.middlescroll = value, badOptions.middlescroll);
                preferences.createPrefItemPercentage("Opponent Notes Opacity", "Adjust the opacity of the opponent's notes.", value -> badOptions.opponentNoteOpacity = value, badOptions.opponentNoteOpacity);

                // Bars
                preferences.items.createItem(120, 120 * preferences.items.length + 30, "Bars :", "bold");
                preferences.createPrefItemCheckbox("Enable Health Bar", "If enabled, the health bar will be visible.", value -> badOptions.healthBar = value, badOptions.healthBar);

                preferences.createPrefItemEnum("Health Icons Position", "Select the position of the Health Icons.", [
                    "off" => "Off",
                    "vanilla" => "Vanilla",
                    "flipped" => "Flipped",
                    "centered" => "Centered",
                    "ends" => "Ends"
                ], value -> badOptions.healthIconPosition = value, badOptions.healthIconPosition);

                preferences.createPrefItemEnum("Time Bar Position", "Select the position of the Time Bar.", [
                    "off" => "Off",
                    "down" => "Down",
                    "up" => "Up",
                    "vertical" => "Vertical"
                ], value -> badOptions.timebarPosition = value, badOptions.timebarPosition);

                preferences.createPrefItemEnum("Time Bar Display", "Choose how to display the Time Bar's text.", [
                    "off" => "Off",
                    "left" => "Time Left",
                    "left-total" => "Time Left / Total",
                    "elapsed" => "Elapsed",
                    "elapsed-total" => "Elapsed / Total",
                    "elapsed-left" => "Elapsed / Time Left",
                    "name" => "Song Name"
                ], value -> badOptions.timebarType = value, badOptions.timebarType);

                preferences.createPrefItemEnum("Time Bar Style", "Select the style of the Time Bar texture.", [
                    "psych" => "Psych Engine",
                    "minimal" => "Minimal",
                    "minimal-rounded" => "Minimal Rounded"
                ], value -> badOptions.timebarStyle = value, badOptions.timebarStyle);

                preferences.createPrefItemEnum("Rest Bar Display", "Choose how to display the Rest Bar.", [
                    "off" => "Off",
                    "countdown" => "Countdown",
                    "countup" => "Countup"
                ], value -> badOptions.restBar = value, badOptions.restBar);

                preferences.createPrefItemCheckbox("Smooth Bars", "If enabled, bars will fill smoothly with fluid animation. (May reduce performance!)", value -> badOptions.smoothBars = value, badOptions.smoothBars);

                preferences.createPrefItemCheckbox("Icon Colored Health Bar", "If enabled, the health bar will match the dominant color of the icon.", value -> badOptions.iconColors = value, badOptions.iconColors);

                // HUD Customization
                preferences.items.createItem(120, 120 * preferences.items.length + 30, "HUD Customization :", "bold");

                preferences.createPrefItemEnum("on Left", "Choose which elements that are shown on the left side.", [
                    "none" => "None",
                    "judgements" => "Judgements",
                    "stats" => "Stats",
                    "judgements-stats" => "Judgements and Stats",
                ], value -> badOptions.leftPos = value, badOptions.leftPos);

                preferences.createPrefItemPercentage("HUD Opacity", "Adjust the opacity of the HUD.", value -> badOptions.hudOpacity = value, badOptions.hudOpacity);

                preferences.createPrefItemEnum("HUD Font", "Select the font style for the HUD text.", [
                    "0" => "VCR OSD Mono (Vanilla)",
                    "1" => "VCR OSD Neue",
                    "2" => "Minecraft",
                    "3" => "Retro Gaming",
                    "4" => "Roblox",
                    "5" => "Super Mario 64",
                    "6" => "New Super Mario Font U",
                    "7" => "Karmatic Arcade",
                    "8" => "ModernDOS",
                    "9" => "Euxoi",
                    "10" => "House of Terror",
                    "11" => "Determination",
                    "12" => "fbUsv8C5eI"
                ], value -> {
                    badOptions.hudFont = Std.parseInt(value);
                    switchFont();
                    changeDebugDisplay(font);
                }, Std.string(badOptions.hudFont));

                preferences.createPrefItemNumber("HUD Font Size", "Adjust the size of the HUD text.", value -> badOptions.hudFontSize = Std.int(value), null, badOptions.hudFontSize, 0, 999, 1, 0);

                // Extras
                preferences.items.createItem(120, 120 * preferences.items.length + 30, "Extras :", "bold");

                preferences.createPrefItemEnum("Accuracy System", "Choose the accuracy/score for visual display on the HUD. (Only visual!)", [
                    "vanilla" => "Vanilla",
                    "psych" => "Psych Engine",
                    "osu" => "osu!Mania"
                ], value -> badOptions.accuracyType = value, badOptions.accuracyType);

                preferences.createPrefItemCheckbox("Comma Separated Score", "If enabled, the score will use commas as thousand separators", value -> badOptions.commaSeparatedScore = value, badOptions.commaSeparatedScore);

                preferences.createPrefItemCheckbox("Enable Keybind Reminder", "If enabled, a keybind reminder will appear above notes when loaded, then fade.", value -> badOptions.remindKeys = value, badOptions.remindKeys);

                preferences.createPrefItemCheckbox("Mute Miss Sounds", "If enabled, mutes the sound of the note being missed.", value -> badOptions.muteMiss = value, badOptions.muteMiss);

                var underlayOpacityItem = new NumberPreferenceItem(0, (120 * preferences.items.length) + 30, "Note Underlay Opacity",
                badOptions.underlayOpacity, 0, 100, 5, 0,
                value -> badOptions.underlayOpacity = Std.int(value),
                value -> return badOptions.underlayOpacity + "%"
                );
                preferences.items.addItem("Note Underlay Opacity", underlayOpacityItem);
                preferences.preferenceItems.add(underlayOpacityItem.lefthandText);

                preferences.createPrefItemEnum("Rating Pop-Up Animation", "Choose the animation for rating pop-ups when hitting a note.", [
                    "off" => "Off",
                    "vanilla" => "Vanilla",
                    "popup" => "Pop-Up"
                ], value -> badOptions.popUpType = value, badOptions.popUpType);

                preferences.createPrefItemCheckbox("Show KPS Counter", "If enabled, a KPS (Key Per Second) counter will appear on the left side of the screen.", value -> badOptions.kpsCounter = value, badOptions.kpsCounter);

                preferences.createPrefItemCheckbox("Custom Scroll Speed", "If enabled, the Scroll Speed Factor option will be used.", value -> badOptions.customScrollSpeed = value, badOptions.customScrollSpeed);

                preferences.createPrefItemNumber("Scroll Speed Factor", "Adjust the speed of the incoming notes.",
                value -> badOptions.scrollSpeedFactor = value,
                value -> Std.string(badOptions.scrollSpeedFactor / 10),
                Std.int(badOptions.scrollSpeedFactor), 1, 9999, 1, 0);
            }
        }
    }

    function changeDebugDisplay(font:String) {
        if (Preferences.debugDisplay && Assets.exists(Paths.font(font))) {
            Main.fpsCounter.set_defaultTextFormat(new TextFormat(Assets.getPath(Paths.font(font))));
            Main.memoryCounter.set_defaultTextFormat(new TextFormat(Assets.getPath(Paths.font(font))));
        }
    }

    function updatetypetext() {
        switch (badOptions.timebarStyle) {
            case "psych":
                timeBarBGStyle = "timeBarPsychEngine";
                timeTextSize = 26;
            case "minimal":
                timeBarBGStyle = "timeBarMinimal";
                timeTextSize = 20;
            case "minimal-rounded":
                timeBarBGStyle = "timeBarMinimalRounded";
                timeTextSize = 24;
        }

        switchFont();
    }

    function switchFont() {
        switch (badOptions.hudFont) {
            case 0: font = "vcr.ttf"; // 21px
            case 1: font = "VCRosdNEUE.ttf"; // 16px
            case 2: font = "Minecraft.ttf"; // 16px
            case 3: font = "Retro Gaming.ttf"; // 11px
            case 4: font = "RobloxFont-Regular.ttf"; // ?px
            case 5: font = "Super Mario 64.ttf"; // ?px
            case 6: font = "New Super Mario Font U.ttf"; // ?px
            case 7: font = "ka1.ttf"; // ?px
            case 8: font = "ModernDOS.ttf"; // 16px
            case 9: font = "Euxoi.ttf"; // 32px
            case 10: font = "House_Of_Terror.ttf"; // ?px
            case 11: font = "determination-regular.ttf"; // 16px
            case 12: font = "fbUsv8C5eI.ttf"; // ?px
        }
    }
}

typedef BadSaveData = {
    middlescroll:Bool,
    opponentNoteOpacity:Int,
    healthBar:Bool,
    healthIconPosition:String,
    timebarPosition:String,
    timebarType:String,
    timebarStyle:String,
    restBar:String,
    smoothBars:Bool,
    iconColors:Bool,
    leftPos:String,
    hudOpacity:Int,
    hudFont:Int,
    hudFontSize:Int,
    accuracyType:String,
    commaSeparatedScore:Bool,
    popUpType:String,
    remindKeys:Bool,
    muteMiss:Bool,
    underlayOpacity:Int,
    kpsCounter:Bool,
    customScrollSpeed:Bool,
    scrollSpeedFactor:Float
}