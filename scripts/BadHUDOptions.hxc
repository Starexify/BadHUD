import funkin.Preferences;
import funkin.save.Save;
import funkin.modding.events.ScriptEvent;
import funkin.modding.module.ScriptedModule;
import funkin.ui.options.OptionsState;
import funkin.ui.options.PreferencesMenu;
import funkin.util.Constants;
import funkin.util.ReflectUtil;
import funkin.util.tools.StringTools;

import openfl.text.TextFormat;

import haxe.ds.StringMap;
import haxe.io.Path;

import Main;

class BadHUDOptions extends ScriptedModule {
    var badOptions:Null<BadSaveData> = Save.instance.modOptions.get("badOptions");
    var fontOptions:StringMap<String>;

    var saveData:BadSaveData = {
        middlescroll: false,
        oppMiddlescroll: true,
        opponentNoteOpacity: 100,
        healthBar: true,
        healthIconPosition: "vanilla",
        timeBar: true,
        timeBarType: "left",
        timeBarStyle: "timeBarPsychEngine",
        restBar: false,
        restBarType: "countdown",
        restBarText: true,
        restBarStartThreshold: 5,
        smoothBars: true,
        iconColors: true,
        statsOrt: "center",
        statsBool: true,
        judgementsOrt: "left",
        judgementsBool: true,
        hitDiffBool: true,
        kpsOrt: "left",
        kpsCounter: false,
        hudOpacity: 100,
        hudFont: "vcr.ttf",
        hudFontSize: 21,
        accuracyType: "vanilla",
        commaSeparatedScore: false,
        popUpType: "vanilla",
        remindKeys: true,
        muteMiss: true,
        customScrollSpeed: false,
        scrollSpeedFactor: 18,
        strumBgColor: 0xFF000000,
        strumHeight: 24
    };

    // Hooks or smth like that for other classes
    var fontSize:Int;

    function new() {
        super("BadHUDOptions", 1);
        // Default Options (First Start)
        if (!Save.instance.modOptions.exists("badOptions")) Save.instance.modOptions.set("badOptions", saveData);
        else {
            for (field in ReflectUtil.getAnonymousFieldsOf(saveData)) {
                if (!ReflectUtil.hasAnonymousField(badOptions, field)) ReflectUtil.setAnonymousField(badOptions, field, ReflectUtil.getAnonymousField(saveData, field));
            }
            switchFontSize(badOptions.hudFont);
            changeDebugDisplay(badOptions.hudFont);
            Constants.STRUMLINE_Y_OFFSET = badOptions.strumHeight;
        }
        Save.instance.flush();
        badOptions = Save.instance.modOptions.get("badOptions");
    }

    override function onStateChangeEnd(event:StateChangeScriptEvent) {
        if (Std.isOfType(event.targetState, OptionsState)) {
            var preferences:PreferencesMenu = event.targetState.optionsCodex.pages.get("preferences");
            if (preferences != null) {
                switchFontSize(badOptions.hudFont);
                Save.instance.flush();

                preferences.createPrefItemCheckbox("Middlescroll", "If enabled, player notes will be centerd on the screen, and opponent's notes will be split.", value -> badOptions.middlescroll = value, badOptions.middlescroll);
                preferences.createPrefItemPercentage("Opponent Notes Opacity", "Adjust the opacity of the opponent's notes.", value -> badOptions.opponentNoteOpacity = value, badOptions.opponentNoteOpacity);

                // HUD Customization
                preferences.items.createItem(120, 120 * preferences.items.length + 30, "HUD Customization :", "bold", () -> false);
                preferences.preferenceDesc.push("");
                preferences.createPrefItemPercentage("HUD Opacity", "Adjust the opacity of the HUD.", value -> badOptions.hudOpacity = value, badOptions.hudOpacity);

                var fontList:Array<String> = Assets.list("FONT");
                fontOptions = new StringMap();
                var excludedFonts = ["vcr", "VCR OSD Neue", "ModernDOS", "fbUsv8C5eI", "DS DIGI"];
                for (font in fontList) {
                    var fileName = Path.withoutDirectory(font);
                    var displayName = fileName;
                    displayName = StringTools.stripSuffix(displayName, ".ttf");
                    displayName = StringTools.stripSuffix(displayName, ".TTF");
                    displayName = StringTools.stripSuffix(displayName, ".otf");
                    displayName = displayName.split("_").join(" ").split("-").join(" ");
                    if (excludedFonts.contains(displayName) == -1) displayName = StringTools.toTitleCase(displayName);
                    if (displayName == "vcr") displayName = "VCR OSD Mono (Vanilla)";
                    fontOptions.set(displayName, fileName);
                }
                var prefDisplayName = StringTools.stripSuffix(badOptions.hudFont, ".ttf");
                prefDisplayName = StringTools.stripSuffix(prefDisplayName, ".TTF");
                prefDisplayName = StringTools.stripSuffix(prefDisplayName, ".otf");
                preferences.createPrefItemEnum("HUD Font", "Select the font style for the HUD text.", fontOptions, (key, value) -> {
                    trace(key + ", " + value);
                    badOptions.hudFont = value;
                    changeDebugDisplay(badOptions.hudFont);
                    switchFontSize(value);
                }, prefDisplayName);
                preferences.createPrefItemNumber("HUD Font Size", "Adjust the size of the HUD text.", value -> badOptions.hudFontSize = Std.int(value), null, badOptions.hudFontSize, 0, 999, 1, 0);

                // Extras
                preferences.items.createItem(120, 120 * preferences.items.length + 30, "Extras :", "bold", () -> false);
                preferences.preferenceDesc.push("");

                preferences.createPrefItemCheckbox("Enable Keybind Reminder", "If enabled, a keybind reminder will appear above notes when loaded, then fade away   .", value -> badOptions.remindKeys = value, badOptions.remindKeys);
                preferences.createPrefItemCheckbox("Mute Miss Sounds", "If enabled, mutes the sound of the note being missed.", value -> badOptions.muteMiss = value, badOptions.muteMiss);
                preferences.createPrefItemCheckbox("Custom Scroll Speed", "If enabled, the Scroll Speed Factor option will be used.", value -> badOptions.customScrollSpeed = value, badOptions.customScrollSpeed);
                preferences.createPrefItemNumber("Scroll Speed Factor", "Adjust the speed of the incoming notes.", value -> badOptions.scrollSpeedFactor = value, value -> Std.string(badOptions.scrollSpeedFactor / 10), Std.int(badOptions.scrollSpeedFactor), 1, 9999, 1, 0);
            }
        }
    }

    function changeDebugDisplay(font:String) {
        if (Preferences.debugDisplay && Assets.exists(Paths.font(font))) {
            Main.fpsCounter.set_defaultTextFormat(new TextFormat(Assets.getPath(Paths.font(font))));
            Main.memoryCounter.set_defaultTextFormat(new TextFormat(Assets.getPath(Paths.font(font))));
        }
    }

    function switchFontSize(value:String) {
        switch (value) {
            case "vcr.ttf": fontSize = 21;
            case "VCR OSD Neue.ttf": fontSize = 21; // 16px
            case "Minecraft.ttf": fontSize = 16;
            case "Retro Gaming.ttf": fontSize = 18; // 11px
            case "RobloxFont-Regular.ttf": fontSize = 28; // ?px
            case "ModernDOS.ttf": fontSize = 21; // 16px
            case "Euxoi.ttf": fontSize = 28;
            default: fontSize = 24;
        }
    }
}

typedef BadSaveData = {
    middlescroll:Bool,
    oppMiddlescroll:Bool,
    opponentNoteOpacity:Int,
    healthBar:Bool,
    healthIconPosition:String,
    timeBar:Bool,
    timeBarType:String,
    timeBarStyle:String,
    restBar:Bool,
    restBarType:String,
    restBarText:Bool,
    restBarStartThreshold:Float,
    smoothBars:Bool,
    iconColors:Bool,
    statsOrt:String,
    statsBool:Bool,
    judgementsOrt:String,
    judgementsBool:Bool,
    hitDiffBool:Bool,
    kpsOrt:String,
    kpsCounter:Bool,
    hudOpacity:Int,
    hudFont:String,
    hudFontSize:Int,
    accuracyType:String,
    commaSeparatedScore:Bool,
    popUpType:String,
    remindKeys:Bool,
    muteMiss:Bool,
    customScrollSpeed:Bool,
    scrollSpeedFactor:Float,
    strumBgColor:Int,
    strumHeight:Int
}