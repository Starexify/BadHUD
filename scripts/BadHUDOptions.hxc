import funkin.Assets;
import funkin.Paths;
import funkin.Preferences;
import funkin.save.Save;
import funkin.modding.events.ScriptEvent;
import funkin.modding.module.Module;
import funkin.ui.options.OptionsState;
import funkin.ui.options.items.NumberPreferenceItem;

import openfl.text.TextFormat;

import Main;
import Std;

class BadHUDOptions extends Module {
    var badOptions:BadSaveData = Save.instance.modOptions.get("badOptions");

    // Hooks or smth like that for other classes
    var font;
    var timeBarBGStyle;
    var timeTextSize;

    var saveObject:BadSaveData = {
        middlescroll: false,
        opponentNoteOpacity: 100,
        healthBarPosition: "vanilla",
        healthIconPosition: "vanilla",
        timebarPosition: "down",
        timebarType: "left",
        timebarStyle: "psych",
        restBar: "off",
        smoothBars: true,
        iconColors: true,
        leftPos: "judgements",
        hudOpacity: 100,
        hudFont: 0,
        hudFontSize: 21,
        accuracyType: "vanilla",
        commaSeparatedScore: false,
        popUpType: "vanilla",
        underlayOpacity: 0,
        kpsCounter: false,
        customScrollSpeed: false,
        scrollSpeedFactor: 18,
        remindKeys: true
    };

    function new() {
        super("BadHUDOptions", 1);
        // Default Options (First Start)
        if (!Save.instance.modOptions.exists("badOptions")) {
            Save.instance.modOptions.set("badOptions", saveObject);
        } else {
            updatetypetext();
        }
        Save.instance.flush();

        if (Preferences.debugDisplay) changeDebugDisplay(font);
    }

    override function onStateChangeEnd(event:StateChangeScriptEvent) {
        if (Std.isOfType(event.targetState, OptionsState)) {
            var preferences = event.targetState.pages.get("preferences");
            if (preferences != null) {
                updatetypetext();
                Save.instance.flush();

                preferences.createPrefItemCheckbox("Middlescroll", "If enabled, player notes will be centerd on the screen, while the opponent's notes will be split.", value -> badOptions.middlescroll = value, badOptions.middlescroll);
                preferences.createPrefItemPercentage("Opponent Notes Opacity", "The opacity of the opponent notes.", value -> badOptions.opponentNoteOpacity = value, badOptions.opponentNoteOpacity);

                // Bars
                preferences.items.createItem(120, 120 * preferences.items.length + 30, "Bars :", "bold", function() {});
                preferences.createPrefItemEnum("Health Bar Position", "The position of the Health Bar.", [
                    "off" => "Off",
                    "vanilla" => "Vanilla",
                    "vertical" => "Vertical"
                ], value -> badOptions.healthBarPosition = value, badOptions.healthBarPosition);

                preferences.createPrefItemEnum("Health Icons Position", "Option to change the position of the Health Icons", [
                    "off" => "Off",
                    "vanilla" => "Vanilla",
                    "flipped" => "Flipped",
                    "ends" => "Ends"
                ], value -> badOptions.healthIconPosition = value, badOptions.healthIconPosition);

                preferences.createPrefItemEnum("Time Bar Position", "Changes position of the Time Bar", [
                    "off" => "Off",
                    "down" => "Down",
                    "up" => "Up",
                    "vertical" => "Vertical"
                ], value -> badOptions.timebarPosition = value, badOptions.timebarPosition);

                preferences.createPrefItemEnum("Time Bar Display", "Changes the display of the Time Bar", [
                    "off" => "Off",
                    "left" => "Time Left",
                    "left-total" => "Time Left / Total",
                    "elapsed" => "Elapsed",
                    "elapsed-total" => "Elapsed / Total",
                    "elapsed-left" => "Elapsed / Time Left",
                    "name" => "Song Name"
                ], value -> badOptions.timebarType = value, badOptions.timebarType);

                preferences.createPrefItemEnum("Time Bar Style", "Changes the style of the Time Bar", [
                    "psych" => "Psych Engine",
                    "minimal" => "Minimal",
                    "minimal-rounded" => "Minimal Rounded"
                ], value -> badOptions.timebarStyle = value, badOptions.timebarStyle);

                preferences.createPrefItemEnum("Rest Bar Display", "Changes the display of the Rest Bar", [
                    "off" => "Off",
                    "countdown" => "Countdown",
                    "countup" => "Countup"
                ], value -> badOptions.restBar = value, badOptions.restBar);

                preferences.createPrefItemCheckbox("Smooth Bars", "", value -> badOptions.smoothBars = value, badOptions.smoothBars);

                preferences.createPrefItemCheckbox("Icon Colored Health Bar", "If enabled, the health bar will use the dominant icon color.", value -> badOptions.iconColors = value, badOptions.iconColors);

                // HUD Customization
                preferences.items.createItem(120, 120 * preferences.items.length + 30, "HUD Customization :", "bold", function() {});

                preferences.createPrefItemEnum("on Left", "Left side elements", [
                    "none" => "None",
                    "judgements" => "Judgements",
                    "stats" => "Stats",
                    "judgements-stats" => "Judgements and Stats",
                ], value -> badOptions.leftPos = value, badOptions.leftPos);

                preferences.createPrefItemPercentage("HUD Opacity", "Changes the opacity of the HUD", value -> badOptions.hudOpacity = value, badOptions.hudOpacity);

                preferences.createPrefItemEnum("HUD Font", "Changes the font of the HUD", [
                "0" => "VCR OSD Mono (Vanilla)",
                "1" => "VCR OSD Neue",
                "2" => "Minecraft",
                "3" => "Retro Gaming",
                "4" => "Roblox",
                "5" => "Super Mario 64",
                "6" => "New Super Mario Font U",
                "7" => "Karmatic Arcade",
                "8" => "ModernDOS"
                "9" => "fbUsv8C5eI"
                ], value -> {
                badOptions.hudFont = Std.parseInt(value);
                switch (badOptions.hudFont) {
                case 0: // px = 21;
                font = "vcr.ttf";
                case 1: // px = 16;
                font = "VCRosdNEUE.ttf";
                case 2: // px = 16;
                font = "Minecraft.ttf";
                case 3: // px = 11;
                font = "Retro Gaming.ttf";
                case 4: // px = ?;
                font = "RobloxFont-Regular.ttf";
                case 5: // px = ?;
                font = "Super Mario 64.ttf";
                case 6: // px = ?;
                font = "New Super Mario Font U.ttf";
                case 7: // px = ?;
                font = "ka1.ttf";
                case 8: // px = 16;
                font = "ModernDOS.ttf";
                case 9: // px = ?;
                font = "fbUsv8C5eI.ttf";
            } changeDebugDisplay(font); }, badOptions.hudFont);

                preferences.createPrefItemNumber("HUD Font Size", "Changes the size of the HUD text", value -> badOptions.hudFontSize = Std.int(value), null, badOptions.hudFontSize, 0, 999, 1, 0);

                    // Extras
                preferences.items.createItem(120, 120 * preferences.items.length + 30, "Extras :", "bold", function() {});

                preferences.createPrefItemEnum("Accuracy System", "Change the accuracy/score system (visually)", [
                "vanilla" => "Vanilla",
                "psych" => "Psych Engine",
                "osu" => "osu!Mania"
                ], value -> badOptions.accuracyType = value, badOptions.accuracyType);

                preferences.createPrefItemCheckbox("Comma Separated Score", "", value -> badOptions.commaSeparatedScore = value, badOptions.commaSeparatedScore);

                preferences.createPrefItemEnum("Combo PopUp Animation", "Change the animation of the Combo PopUps when popping up", [
                "off" => "Off",
                "vanilla" => "Vanilla",
                "popup" => "Pop-Up"
                ], value -> badOptions.popUpType = value, badOptions.popUpType);

                preferences.createPrefItemCheckbox("Mute Miss Sounds", "", value -> badOptions.muteMiss = value, badOptions.muteMiss);

                var underlayOpacityItem = new NumberPreferenceItem(0, (120 * preferences.items.length) + 30, "Note Underlay Opacity",
                badOptions.underlayOpacity, 0, 100, 5, 0,
                value -> badOptions.underlayOpacity = Std.int(value),
                value -> return badOptions.underlayOpacity + "%"
                );
                preferences.items.addItem("Note Underlay Opacity", underlayOpacityItem);
                preferences.preferenceItems.add(underlayOpacityItem.lefthandText);

                preferences.createPrefItemCheckbox("Enable Keybind Reminder", "", value -> badOptions.remindKeys = value, badOptions.remindKeys);

                preferences.createPrefItemCheckbox("Show KPS Counter", "", value -> badOptions.kpsCounter = value, badOptions.kpsCounter);

                preferences.createPrefItemCheckbox("Custom Scroll Speed", "", value -> badOptions.customScrollSpeed = value, badOptions.customScrollSpeed);

                preferences.createPrefItemNumber("Scroll Speed Factor", "Changes the speed of the notes",
                value -> badOptions.scrollSpeedFactor = value,
                value -> return badOptions.scrollSpeedFactor / 10,
                badOptions.scrollSpeedFactor, 1, 9999, 1, 0);
            }
        }
    }

    function changeDebugDisplay(font:String) {
        if (Assets.exists(Paths.font(font))) {
            Main.fpsCounter.set_defaultTextFormat(new TextFormat(Assets.getPath(Paths.font(font))));
            Main.memoryCounter.set_defaultTextFormat(new TextFormat(Assets.getPath(Paths.font(font))));
        }
    }

    function updatetypetext() {
        switch (badOptions.timebarStyle) {
            case "psych":
                timeBarBGStyle = "timeBarPsychEngine";
                timeTextSize = 26;
            case "minimal":
                timeBarBGStyle = "timeBarMinimal";
                timeTextSize = 20;
            case "minimal-rounded":
                timeBarBGStyle = "timeBarMinimalRounded";
                timeTextSize = 24;
        }

        switch (badOptions.hudFont) {
            case 0: // px = 21;
                font = "vcr.ttf";
            case 1: // px = 16;
                font = "VCRosdNEUE.ttf";
            case 2: // px = 16;
                font = "Minecraft.ttf";
            case 3: // px = 11;
                font = "Retro Gaming.ttf";
            case 4: // px = ?;
                font = "RobloxFont-Regular.ttf";
            case 5: // px = ?;
                font = "Super Mario 64.ttf";
            case 6: // px = ?;
                font = "New Super Mario Font U.ttf";
            case 7: // px = ?;
                font = "ka1.ttf";
            case 8: // px = 16;
                font = "ModernDOS.ttf";
            case 9: // px = ?;
                font = "fbUsv8C5eI.ttf";
        }
    }
}

typedef BadSaveData = {
    middlescroll:Bool,
    opponentNoteOpacity:Int,
    healthBarPosition:String,
    healthIconPosition:String,
    timebarPosition:String,
    timebarType:String,
    timebarStyle:String,
    restBar:String,
    smoothBars:Bool,
    iconColors:Bool,
    leftPos:String,
    hudOpacity:Int,
    hudFont:Int,
    hudFontSize:Int,
    accuracyType:String,
    commaSeparatedScore:Bool,
    popUpType:String,
    underlayOpacity:Int,
    kpsCounter:Bool,
    customScrollSpeed:Bool,
    scrollSpeedFactor:Int,
    remindKeys:Bool
}