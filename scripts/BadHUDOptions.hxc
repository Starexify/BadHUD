import funkin.Assets;
import funkin.Paths;
import funkin.Preferences;
import funkin.save.Save;
import funkin.modding.events.ScriptEvent;
import funkin.modding.module.Module;
import funkin.ui.options.OptionsState;
import funkin.ui.options.PreferencesMenu;
import funkin.ui.options.items.NumberPreferenceItem;

import openfl.text.TextFormat;

import haxe.Exception;

import Main;
import Std;

class BadHUDOptions extends Module {
    var badOptions:BadSaveData = Save.instance.modOptions.get("badOptions");

    // Hooks or smth like that for other classes
    var font:String;
    var fontSize:Int;

    var saveObject:BadSaveData = {
        middlescroll: false,
        opponentNoteOpacity: 100,
        healthBar: true,
        healthIconPosition: "vanilla",
        timeBar: true,
        timeBarType: "left",
        timeBarStyle: "timeBarPsychEngine",
        restBar: false,
        restBarType: "countdown",
        restBarText: true,
        smoothBars: true,
        iconColors: true,
        statsOrt: "center",
        statsBool: true,
        judgementsOrt: "left",
        judgementsBool: true,
        kpsOrt: "left",
        kpsCounter: false,
        hudOpacity: 100,
        hudFont: 0,
        hudFontSize: 21,
        accuracyType: "vanilla",
        commaSeparatedScore: false,
        popUpType: "vanilla",
        remindKeys: true,
        muteMiss: true,
        customScrollSpeed: true,
        scrollSpeedFactor: 18
    };

    function new() {
        super("BadHUDOptions", 1);
        // Default Options (First Start)
        if (!Save.instance.modOptions.exists("badOptions")) Save.instance.modOptions.set("badOptions", saveObject);
        else switchFont();
        Save.instance.flush();

        changeDebugDisplay(font);
    }

    override function onStateChangeEnd(event:StateChangeScriptEvent) {
        if (Std.isOfType(event.targetState, OptionsState)) {
            var preferences:PreferencesMenu = event.targetState.optionsCodex.pages.get("preferences");
            if (preferences != null) {
                switchFont();
                Save.instance.flush();

                preferences.createPrefItemCheckbox("Middlescroll", "If enabled, player notes will be centerd on the screen, and opponent's notes will be split.", value -> badOptions.middlescroll = value, badOptions.middlescroll);
                preferences.createPrefItemPercentage("Opponent Notes Opacity", "Adjust the opacity of the opponent's notes.", value -> badOptions.opponentNoteOpacity = value, badOptions.opponentNoteOpacity);

                // HUD Customization
                //preferences.items.createItem(120, 120 * preferences.items.length + 30, "HUD Customization :", "bold");

                preferences.createPrefItemPercentage("HUD Opacity", "Adjust the opacity of the HUD.", value -> badOptions.hudOpacity = value, badOptions.hudOpacity);
                preferences.createPrefItemEnum("HUD Font", "Select the font style for the HUD text.", [
                    "0" => "VCR OSD Mono (Vanilla)",
                    "1" => "VCR OSD Neue",
                    "2" => "Minecraft",
                    "3" => "Retro Gaming",
                    "4" => "Roblox",
                    "5" => "Super Mario 64",
                    "6" => "New Super Mario Font U",
                    "7" => "ModernDOS",
                    "8" => "Euxoi",
                    "9" => "House of Terror",
                    "10" => "Determination",
                    "11" => "Wii Sans 2",
                    "12" => "fbUsv8C5eI"
                ], value -> {
                    badOptions.hudFont = Std.parseInt(value);
                    switchFont();
                    changeDebugDisplay(font);
                }, Std.string(badOptions.hudFont));
                preferences.createPrefItemNumber("HUD Font Size", "Adjust the size of the HUD text.", value -> badOptions.hudFontSize = Std.int(value), null, badOptions.hudFontSize, 0, 999, 1, 0);

                // Extras
                //preferences.items.createItem(120, 120 * preferences.items.length + 30, "Extras :", "bold");

                preferences.createPrefItemCheckbox("Enable Keybind Reminder", "If enabled, a keybind reminder will appear above notes when loaded, then fade.", value -> badOptions.remindKeys = value, badOptions.remindKeys);
                preferences.createPrefItemCheckbox("Mute Miss Sounds", "If enabled, mutes the sound of the note being missed.", value -> badOptions.muteMiss = value, badOptions.muteMiss);

/*                var underlayOpacityItem = new NumberPreferenceItem(0, (120 * preferences.items.length) + 30, "Note Underlay Opacity",
                badOptions.underlayOpacity, 0, 100, 5, 0,
                value -> badOptions.underlayOpacity = Std.int(value),
                value -> return badOptions.underlayOpacity + "%"
                );
                preferences.items.addItem("Note Underlay Opacity", underlayOpacityItem);
                preferences.preferenceItems.add(underlayOpacityItem.lefthandText);*/

                preferences.createPrefItemCheckbox("Custom Scroll Speed", "If enabled, the Scroll Speed Factor option will be used.", value -> badOptions.customScrollSpeed = value, badOptions.customScrollSpeed);

                preferences.createPrefItemNumber("Scroll Speed Factor", "Adjust the speed of the incoming notes.",
                value -> badOptions.scrollSpeedFactor = value,
                value -> Std.string(badOptions.scrollSpeedFactor / 10),
                Std.int(badOptions.scrollSpeedFactor), 1, 9999, 1, 0);
            }
        }
    }

    function changeDebugDisplay(font:String) {
        if (Preferences.debugDisplay && Assets.exists(Paths.font(font))) {
            Main.fpsCounter.set_defaultTextFormat(new TextFormat(Assets.getPath(Paths.font(font))));
            Main.memoryCounter.set_defaultTextFormat(new TextFormat(Assets.getPath(Paths.font(font))));
        }
    }

    function switchFont() {
        switch (badOptions.hudFont) {
            case 0: font = "vcr.ttf";
                fontSize = 21;
            case 1: font = "VCRosdNEUE.ttf"; // 16px
                fontSize = 21;
            case 2: font = "Minecraft.ttf";
                fontSize = 16;
            case 3: font = "Retro Gaming.ttf"; // 11px
                fontSize = 18;
            case 4: font = "RobloxFont-Regular.ttf"; // ?px
                fontSize = 28;
            case 5: font = "Super Mario 64.ttf"; // ?px
                fontSize = 24;
            case 6: font = "New Super Mario Font U.ttf"; // ?px
                fontSize = 24;
            case 7: font = "ModernDOS.ttf"; // 16px
                fontSize = 21;
            case 8: font = "Euxoi.ttf";
                fontSize = 28;
            case 9: font = "House_Of_Terror.ttf"; // ?px
                fontSize = 24;
            case 10: font = "determination-regular.ttf";
                fontSize = 24;
            case 11: font = "wii_sans_v2_by_notsoartisty.ttf"; // ?px
                fontSize = 24;
            case 12: font = "fbUsv8C5eI.ttf"; // ?px
                fontSize = 24;
        }
    }
}

typedef BadSaveData = {
    middlescroll:Bool,
    opponentNoteOpacity:Int,
    healthBar:Bool,
    healthIconPosition:String,
    timeBar:Bool,
    timeBarType:String,
    timeBarStyle:String,
    restBar:Bool,
    restBarType:String,
    restBarText:Bool,
    smoothBars:Bool,
    iconColors:Bool,
    statsOrt:String,
    statsBool:Bool,
    judgementsOrt:String,
    judgementsBool:Bool,
    kpsOrt:String,
    kpsCounter:Bool,
    hudOpacity:Int,
    hudFont:Int,
    hudFontSize:Int,
    accuracyType:String,
    commaSeparatedScore:Bool,
    popUpType:String,
    remindKeys:Bool,
    muteMiss:Bool,
    customScrollSpeed:Bool,
    scrollSpeedFactor:Float
}