import funkin.Preferences;
import funkin.play.PauseSubState;
import funkin.modding.events.ScriptEvent;
import funkin.modding.module.ScriptedModule;
import funkin.play.PlayState;
import funkin.save.Save;

import flixel.FlxG;
import flixel.text.FlxText;
import flixel.text.FlxTextBorderStyle;

class KPSCounter extends ScriptedModule {
    var badOptions:Null<BadSaveData> = Save.instance.modOptions.get("badOptions");
    var playState(get, never):PlayState;
    function get_playState():PlayState { return PlayState.instance; }

    var kpsText:FlxText;
    var kps:Int = 0;
    var kpsMax:Int = 0;

    var lastSecondKeyPresses:Array<Float> = [];
    var updateInterval:Float = 1 / Preferences.framerate;
    var lastUpdateTime:Float = 0;

    function new() {
        super("KPSCounter");
    }

    override function onSongLoaded(event:SongLoadScriptEvent) {
        if (!badOptions.kpsCounter) return;
        if (playState == null) return;

        // Create KPS Text
        kpsText = new FlxText();
        kpsText.setFormat(Paths.font(badOptions.hudFont), badOptions.hudFontSize, 0xFFFFFFFF, "left", FlxTextBorderStyle.OUTLINE_FAST, 0xFF000000);
        kpsText.borderSize = 1.25;

        var settings = Save.instance.modOptions.get("kpsTextSettings");
        if (settings != null) {
            kpsText.angle = settings[4];
            kpsText.scale.x = settings[2];
            kpsText.scale.y = settings[3];
            kpsText.updateHitbox();
            kpsText.setPosition(settings[0], settings[1]);
            kpsText.alignment = kpsText.x >= FlxG.width / 2 ? "right" : "left";
        } else {
            kpsText.x = 10;
            kpsText.y = FlxG.height * 0.6;
        }

        kpsText.zIndex = 851;
        kpsText.scrollFactor.set();
        kpsText.camera = playState.camHUD;
        playState.add(kpsText);
    }

    override function onUpdate(event:UpdateScriptEvent) {
        if (playState == null || !badOptions.kpsCounter) return;

        var currentTime = FlxG.game.ticks / 1000;
        // Check for key presses
        var pressedKeys = [playState.controls.NOTE_DOWN_P, playState.controls.NOTE_UP_P, playState.controls.NOTE_LEFT_P, playState.controls.NOTE_RIGHT_P];
        for (pressedKey in pressedKeys) if (pressedKey) lastSecondKeyPresses.push(FlxG.game.ticks / 1000);

        // Remove key presses older than 1 second
        while (lastSecondKeyPresses.length > 0 && (FlxG.game.ticks / 1000) - lastSecondKeyPresses[0] > 1) lastSecondKeyPresses.shift();

        // Calculate KPS
        kps = lastSecondKeyPresses.length;
        kpsMax = Std.int(Math.max(kpsMax, kps));

        // Update display
        if ((FlxG.game.ticks / 1000) - lastUpdateTime >= updateInterval) {
            updateKPS();
            lastUpdateTime = FlxG.game.ticks / 1000;
        }
    }

    function updateKPS() {
        if (kpsText != null) switch (badOptions.kpsOrt) {
            case "left": kpsText.text = "KPS: " + Math.round(kps * 10) / 10 + "\nMax KPS: " + Math.round(kpsMax * 10) / 10;
            case "center": kpsText.text = "KPS: " + Math.round(kps * 10) / 10 + "| Max KPS: " + Math.round(kpsMax * 10) / 10;
            case "right": kpsText.text = Math.round(kps * 10) / 10 + " KPS\n" + Math.round(kpsMax * 10) / 10 + " Max KPS";
        }
    }

    // Cleanup stuff
    override function onSubStateOpenBegin(event:SubStateScriptEvent) { if (!(event.targetState is PlayState) && !(event.targetState is PauseSubState)) cleanup(); }

    override function onSubStateCloseBegin(event:SubStateScriptEvent) { if (event.targetState is PlayState) cleanup(); }

    override function onSongEnd(event:ScriptEvent) { cleanup(); }

    override function onSongRetry(event:ScriptEvent) { cleanup(); }

    override function onDestroy(event:ScriptEvent) { cleanup(); }

    function cleanup() {
        if (kpsText != null) {
            kpsText.destroy();
            kpsText = null;
        }
        kps = 0;
        kpsMax = 0;
        lastSecondKeyPresses = [];
    }
}