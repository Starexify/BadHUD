import funkin.modding.module.Module;
import funkin.Paths;
import funkin.Preferences;
import funkin.play.PauseSubState;
import funkin.play.PlayState;

import flixel.FlxG;
import flixel.text.FlxText;
import flixel.text.FlxTextBorderStyle;
import flixel.util.FlxSave;

import Math;
import Std;

class KPSCounter extends Module {
    var save:FlxSave = new BadHUDOptions().save ;
    var state:PlayState;

    var kpsText:FlxText;
    var kps:Int = 0 ;
    var kpsMax:Int = 0 ;

    var lastSecondKeyPresses:Array<Float> = [] ;
    var updateInterval:Float = 1 / Preferences.framerate ;
    var lastUpdateTime:Float = 0 ;

    function new() {
        super("KPSCounter");
    }

    override function onSongLoaded(event:SongLoadScriptEvent) {
        if (!save.data.kpsCounter) return;
        var badHooks = ModuleHandler.getModule('BadHooks');
        if (badHooks != null) state = badHooks.scriptGet('state');
        if (state == null) return;

        // Create KPS Text Element
        var kpsTextFont = new BadHUDOptions().font;
        var kpsTextXPos = 10;
        var kpsTextYPos = FlxG.height * 0.6;

        kpsText = new FlxText(kpsTextXPos, kpsTextYPos, FlxG.width, "", 20);
        kpsText.setFormat(Paths.font(kpsTextFont), save.data.hudFontSize, 0xFFFFFFFF, "left", FlxTextBorderStyle.OUTLINE_FAST, 0xFF000000);
        kpsText.scrollFactor.set();
        kpsText.borderSize = 1.25;
        kpsText.zIndex = 851;
        kpsText.text = "KPS: 0" + "\nMax KPS: 0";

        kpsText.cameras = [state.camHUD];
        state.add(kpsText);
    }

    override function onUpdate(event:UpdateScriptEvent) {
        if (state == null || !save.data.kpsCounter) return;

        var currentTime = FlxG.game.ticks / 1000;

        // Check for key presses
        var pressedKeys = [state.controls.NOTE_DOWN_P, state.controls.NOTE_UP_P, state.controls.NOTE_LEFT_P, state.controls.NOTE_RIGHT_P];

        for (pressedKey in pressedKeys) if (pressedKey) lastSecondKeyPresses.push(currentTime);

        // Remove key presses older than 1 second
        while (lastSecondKeyPresses.length > 0 && currentTime - lastSecondKeyPresses[0] > 1) lastSecondKeyPresses.shift();

        // Calculate KPS
        kps = lastSecondKeyPresses.length;
        kpsMax = Std.int(Math.max(kpsMax, kps));

        // Update display
        if (currentTime - lastUpdateTime >= updateInterval) {
            updateKPS();
            lastUpdateTime = currentTime;
        }
    }

    function updateKPS() {
        if (kpsText != null) kpsText.text = "KPS: " + Math.round(kps * 10) / 10 + "\nMax KPS: " + Math.round(kpsMax * 10) / 10;
    }

    // Cleanup stuff
    override function onSubStateOpenBegin(event:SubStateScriptEvent) { if (!Std.isOfType(event.targetState, PlayState) && !Std.isOfType(event.targetState, PauseSubState)) cleanup(); }

    override function onSubStateCloseBegin(event:SubStateScriptEvent) { if (Std.isOfType(event.targetState, PlayState)) cleanup(); }

    override function onSongEnd(event:ScriptEvent) { cleanup(); }

    override function onSongRetry(event:ScriptEvent) { cleanup(); }

    override function onDestroy(event:ScriptEvent) { cleanup(); }

    function cleanup() {
        if (kpsText != null) {
            kpsText.destroy();
            kpsText = null;
        }
        kps = 0;
        kpsMax = 0;
        lastSecondKeyPresses = [];
    }
}